diff -ruN a/dd/DepotDownloader/Channel.cs b/dd/DepotDownloader/Channel.cs
--- /dev/null
+++ b/dd/DepotDownloader/Channel.cs
@@ -0,0 +1,322 @@
+// This file is subject to the terms and conditions defined
+// in file 'LICENSE', which is part of this source code package.
+
+using System;
+using System.Globalization;
+using System.IO;
+using System.Linq;
+using System.Runtime.InteropServices;
+using System.Text;
+using System.Text.Json;
+using System.Threading;
+using Microsoft.Win32.SafeHandles;
+using SteamKit2;
+
+namespace DepotDownloader
+{
+    class ChannelException(string why, string message) : ContentDownloaderException(message)
+    {
+        public string Why { get; } = why;
+    }
+
+    static class Channel
+    {
+        const int PR_SET_DUMPABLE = 4;
+        const int ENOSPC = 28;
+        const long GOT_MS = 250;
+
+        public static bool OneLogon;
+
+        static FileStream stream;
+        static readonly Lock gate = new();
+        static string noted;
+        static bool failed;
+        static long gotAt;
+        static ulong gotDone;
+        static ulong gotDepot;
+
+        public static bool Enabled => stream != null;
+
+        public static string Noted => noted;
+
+        [DllImport("libc.so.6", EntryPoint = "prctl", SetLastError = true)]
+        static extern int Prctl(int option, nuint arg2, nuint arg3, nuint arg4, nuint arg5);
+
+        public static void Open()
+        {
+            if (OperatingSystem.IsLinux() && Prctl(PR_SET_DUMPABLE, 0, 0, 0, 0) != 0)
+            {
+                Environment.Exit(1);
+            }
+
+            var fd = Environment.GetEnvironmentVariable("BLOCKIE_DD_FD");
+            if (fd == null)
+            {
+                return;
+            }
+
+            if (!int.TryParse(fd, NumberStyles.None, CultureInfo.InvariantCulture, out var n) || n < 3)
+            {
+                Environment.Exit(1);
+            }
+
+            try
+            {
+                stream = new FileStream(new SafeFileHandle((nint)n, true), FileAccess.Write, 1);
+            }
+            catch (Exception)
+            {
+                Environment.Exit(1);
+            }
+        }
+
+        public static void Line(params string[] fields)
+        {
+            if (stream == null)
+            {
+                return;
+            }
+
+            lock (gate)
+            {
+                Write(fields);
+            }
+        }
+
+        static void Write(string[] fields)
+        {
+            try
+            {
+                stream.Write(Encoding.UTF8.GetBytes(string.Join('\t', fields) + "\n"));
+                stream.Flush();
+            }
+            catch (Exception)
+            {
+                Environment.Exit(1);
+            }
+        }
+
+        public static string Transient(EResult result)
+        {
+            if (result == EResult.RateLimitExceeded)
+            {
+                return "rate";
+            }
+
+            return result is EResult.Cancelled or EResult.NoConnection or EResult.Timeout or EResult.Busy or EResult.ServiceUnavailable or EResult.TryAnotherCM ? "network" : null;
+        }
+
+        public static bool ScanName(string name)
+        {
+            var path = name.Replace('\\', '/');
+            return path.Length > 0 && !path.Any(c => c < 0x20 || c == 0x7f) && path.Split('/').All(x => x != "" && x != "." && x != "..");
+        }
+
+        public static void Note(string why)
+        {
+            Interlocked.CompareExchange(ref noted, why, null);
+        }
+
+        public static void Fail(string why)
+        {
+            lock (gate)
+            {
+                if (failed)
+                {
+                    return;
+                }
+
+                failed = true;
+            }
+
+            Line(("fail " + why).Split(' '));
+        }
+
+        public static void End()
+        {
+            Line("end");
+        }
+
+        public static void Qr(string url)
+        {
+            Line("qr", url);
+        }
+
+        public static void Manifest(uint depot, ulong manifest)
+        {
+            Line("manifest", depot.ToString(CultureInfo.InvariantCulture), manifest.ToString(CultureInfo.InvariantCulture));
+        }
+
+        public static void File(string sha1, ulong size, string path)
+        {
+            Line("file", sha1, size.ToString(CultureInfo.InvariantCulture), path);
+        }
+
+        public static void Total(ulong total)
+        {
+            Line("total", total.ToString(CultureInfo.InvariantCulture));
+        }
+
+        public static void App(uint app, string type, string name)
+        {
+            Line("app", app.ToString(CultureInfo.InvariantCulture), type, name);
+        }
+
+        public static void Art(uint app, string path)
+        {
+            Line("art", app.ToString(CultureInfo.InvariantCulture), path);
+        }
+
+        public static void Owned(uint app)
+        {
+            Line("owned", app.ToString(CultureInfo.InvariantCulture));
+        }
+
+        public static void Lang(uint app, string languages)
+        {
+            Line("lang", app.ToString(CultureInfo.InvariantCulture), languages);
+        }
+
+        public static void Depot(uint app, uint depot, params string[] fields)
+        {
+            Line(["depot", app.ToString(CultureInfo.InvariantCulture), depot.ToString(CultureInfo.InvariantCulture), .. fields]);
+        }
+
+        public static void Scan(string kind, uint depot, ulong gid)
+        {
+            Line(kind, depot.ToString(CultureInfo.InvariantCulture), gid.ToString(CultureInfo.InvariantCulture));
+        }
+
+        public static void ScanFail(uint depot, ulong gid, string why)
+        {
+            Line("scanfail", depot.ToString(CultureInfo.InvariantCulture), gid.ToString(CultureInfo.InvariantCulture), why);
+        }
+
+        public static void ScanPath(ulong size, string name)
+        {
+            Line("path", size.ToString(CultureInfo.InvariantCulture), name);
+        }
+
+        public static void DepotDone(ulong bytes)
+        {
+            lock (gate)
+            {
+                gotDone += bytes;
+                gotDepot = 0;
+            }
+        }
+
+        public static void Got(ulong depotBytes, bool force)
+        {
+            if (stream == null)
+            {
+                return;
+            }
+
+            lock (gate)
+            {
+                if (depotBytes < gotDepot)
+                {
+                    return;
+                }
+
+                gotDepot = depotBytes;
+                var now = Environment.TickCount64;
+                if (!force && now - gotAt < GOT_MS)
+                {
+                    return;
+                }
+
+                gotAt = now;
+                Write(["got", (gotDone + depotBytes).ToString(CultureInfo.InvariantCulture)]);
+            }
+        }
+
+        public static void Beat()
+        {
+            if (stream == null)
+            {
+                return;
+            }
+
+            lock (gate)
+            {
+                var now = Environment.TickCount64;
+                if (now - gotAt < GOT_MS)
+                {
+                    return;
+                }
+
+                gotAt = now;
+                Write(["got", (gotDone + gotDepot).ToString(CultureInfo.InvariantCulture)]);
+            }
+        }
+
+        public static void Exp(string token)
+        {
+            var days = "-";
+            try
+            {
+                var part = token.Split('.')[1].Replace('-', '+').Replace('_', '/');
+                part = part.PadRight(part.Length + (4 - part.Length % 4) % 4, '=');
+                using var doc = JsonDocument.Parse(Convert.FromBase64String(part));
+                var exp = doc.RootElement.GetProperty("exp").GetInt64();
+                var left = (exp - DateTimeOffset.UtcNow.ToUnixTimeSeconds()) / 86400;
+                days = Math.Max(0, left).ToString(CultureInfo.InvariantCulture);
+            }
+            catch (Exception)
+            {
+            }
+
+            Line("exp", days);
+        }
+
+        public static void CheckName(string name)
+        {
+            var bad = name.Length == 0 || name[0] == '/';
+            foreach (var c in name)
+            {
+                bad |= c < 0x20 || c == 0x7f;
+            }
+
+            foreach (var part in name.Split('/'))
+            {
+                bad |= part == "..";
+            }
+
+            if (bad)
+            {
+                throw new ChannelException("other", "Refused a manifest file name.");
+            }
+        }
+
+        public static ContentDownloaderException Wrap(IOException ex, string message)
+        {
+            return NoSpace(ex) ? new ChannelException("space", message) : new ContentDownloaderException(message);
+        }
+
+        public static bool NoSpace(Exception ex)
+        {
+            for (var e = ex; e != null; e = e.InnerException)
+            {
+                if (e is AggregateException agg)
+                {
+                    foreach (var inner in agg.InnerExceptions)
+                    {
+                        if (NoSpace(inner))
+                        {
+                            return true;
+                        }
+                    }
+                }
+
+                if (e is IOException && (e.HResult == ENOSPC || e.HResult == unchecked((int)0x80070070)))
+                {
+                    return true;
+                }
+            }
+
+            return false;
+        }
+    }
+}
