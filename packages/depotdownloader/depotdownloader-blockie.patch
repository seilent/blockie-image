+        static async Task<string> ScanDepotAsync(uint appId, uint depotId, ulong gid)
+        {
+            var keyResult = await steam3.RequestDepotKey(depotId, appId);
+            if (keyResult == EResult.Cancelled)
+            {
+                throw new ChannelException("network", "The Steam session ended.");
+            }
+
+            if (!steam3.DepotKeys.TryGetValue(depotId, out var depotKey))
+            {
+                return Channel.Transient(keyResult) ?? "owned";
+            }
+
+            var code = await steam3.GetDepotManifestRequestCodeAsync(depotId, appId, gid, DEFAULT_BRANCH);
+            if (code == 0 && steam3.IsAborted)
+            {
+                throw new ChannelException("network", "The Steam session ended.");
+            }
+
+            if (code == 0)
+            {
+                return "network";
+            }
+
+            var refused = false;
+            for (var tries = 0; tries < SCAN_TRIES; tries++)
+            {
+                var connection = cdnPool.GetConnection();
+                DepotManifest manifest;
+                try
+                {
+                    string cdnToken = null;
+                    if (steam3.CDNAuthTokens.TryGetValue((depotId, connection.Host), out var auth) && auth.Task.IsCompletedSuccessfully)
+                    {
+                        cdnToken = auth.Task.Result.Token;
+                    }
+
+                    manifest = await cdnPool.CDNClient.DownloadManifestAsync(depotId, gid, code, connection, depotKey, cdnPool.ProxyServer, cdnToken).ConfigureAwait(false);
+                    cdnPool.ReturnConnection(connection);
+                }
+                catch (SteamKitWebRequestException e) when (e.StatusCode == HttpStatusCode.Forbidden && !steam3.CDNAuthTokens.ContainsKey((depotId, connection.Host)))
+                {
+                    await steam3.RequestCDNAuthToken(appId, depotId, connection);
+                    refused = !(steam3.CDNAuthTokens.TryGetValue((depotId, connection.Host), out var token) && token.Task.IsCompletedSuccessfully);
+                    continue;
+                }
+                catch (SteamKitWebRequestException e) when (e.StatusCode is HttpStatusCode.Unauthorized or HttpStatusCode.Forbidden)
+                {
+                    return refused ? "network" : "owned";
+                }
+                catch (SteamKitWebRequestException e) when (e.StatusCode == HttpStatusCode.TooManyRequests)
+                {
+                    return "rate";
+                }
+                catch (SteamKitWebRequestException e) when (e.StatusCode == HttpStatusCode.NotFound)
+                {
+                    return "network";
+                }
+                catch (Exception)
+                {
+                    cdnPool.ReturnBrokenConnection(connection);
+                    continue;
+                }
+
+                var files = (manifest.Files ?? []).Where(f => !f.Flags.HasFlag(EDepotFileFlag.Directory)).ToList();
+                if (!files.All(file => Channel.ScanName(file.FileName)))
+                {
+                    return "other";
+                }
+
+                Channel.Scan("scan", depotId, gid);
+                files.ForEach(file => Channel.ScanPath(file.TotalSize, file.FileName));
+                Channel.Scan("scanned", depotId, gid);
+                return null;
+            }
+
+            return "network";
+        }
