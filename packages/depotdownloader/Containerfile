FROM localhost/blockie-pkg-builder

COPY depotdownloader.spec /tmp/spec/
RUN dnf -y --setopt=install_weak_deps=False builddep /tmp/spec/depotdownloader.spec \
 && dnf clean all \
 && rm -rf /tmp/spec

COPY SOURCE.env SOURCE.sha256 depotdownloader-blockie.patch /tmp/src/
COPY locks /tmp/src/locks
RUN . /tmp/src/SOURCE.env \
 && umask 022 \
 && install -d /srcpkg \
 && fetch() { \
      d=/var/tmp/src/${4%.tar.gz} \
      && git init -q "$d" \
      && git -C "$d" fetch -q --depth 1 "$1" "$2" \
      && git -C "$d" -c advice.detachedHead=false checkout -q FETCH_HEAD \
      && test "$(git -C "$d" rev-parse HEAD)" = "$2" \
      && tar -C /var/tmp/src --sort=name --mtime="@$3" --owner=0 --group=0 --numeric-owner --format=gnu \
           --exclude=.git -cf - "${d##*/}" | gzip -n > "/srcpkg/$4"; \
    } \
 && fetch "$SOURCE_URL" "$SOURCE_COMMIT" "$SOURCE_EPOCH" "$SOURCE_TAR" \
 && fetch "$STEAMKIT_URL" "$STEAMKIT_COMMIT" "$STEAMKIT_EPOCH" "$STEAMKIT_TAR" \
 && nuget=depotdownloader-nuget-$(cat /tmp/src/locks/DepotDownloader/packages.lock.json \
      /tmp/src/locks/SteamKit2/packages.lock.json | sha256sum | cut -c1-8).tar \
 && w=/var/tmp/nuget \
 && install -d "$w/home" \
 && mv "/var/tmp/src/${SOURCE_TAR%.tar.gz}" "$w/dd" \
 && mv "/var/tmp/src/${STEAMKIT_TAR%.tar.gz}" "$w/sk" \
 && rm "$w/dd/global.json" "$w/sk/global.json" \
 && patch -d "$w" -p1 -s --fuzz=0 < /tmp/src/depotdownloader-blockie.patch \
 && cp /tmp/src/locks/DepotDownloader/packages.lock.json "$w/dd/DepotDownloader/" \
 && cp /tmp/src/locks/SteamKit2/packages.lock.json "$w/sk/SteamKit2/SteamKit2/" \
 && HOME=$w/home DOTNET_CLI_HOME=$w/home DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1 \
      NUGET_HTTP_CACHE_PATH=$w/home/http-cache NUGET_PLUGINS_CACHE_PATH=$w/home/plugins-cache \
      dotnet restore "$w/dd/DepotDownloader/DepotDownloader.csproj" --locked-mode --packages "$w/packages" \
      --source https://api.nuget.org/v3/index.json -p:NuGetAudit=false \
 && HOME=$w/home DOTNET_CLI_HOME=$w/home dotnet build-server shutdown \
 && tar -C "$w/packages" --sort=name --mtime="@$SOURCE_EPOCH" --owner=0 --group=0 --numeric-owner --format=gnu \
      -cf "/srcpkg/$nuget" . \
 && (cd /srcpkg && sha256sum "$SOURCE_TAR" "$STEAMKIT_TAR" "$nuget" && sha256sum -c /tmp/src/SOURCE.sha256) \
 && rm -rf /var/tmp/src /var/tmp/nuget /tmp/src
