+#define CONTEXTS_MAX 64
+
+typedef struct {
+    int refs;
+    void *anchor;
+} context_group_t;
+
+static pthread_mutex_t contexts_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct {
+    EGLContext ctx;
+    context_group_t *group;
+    void *state;
+    int bound;
+    int destroyed;
+} contexts[CONTEXTS_MAX];
+
+static int find_context(EGLContext ctx) {
+    if (ctx == EGL_NO_CONTEXT)
+        return -1;
+    for (int i = 0; i < CONTEXTS_MAX; i++)
+        if (contexts[i].ctx == ctx)
+            return i;
+    return -1;
+}
+
+static void forget_context(int i) {
+    context_group_t *group = contexts[i].group;
+    memset(&contexts[i], 0, sizeof(contexts[i]));
+    if (!--group->refs)
+        free(group);
+}
+
+static void drop_context(int i) {
+    context_group_t *group = contexts[i].group;
+    void *state = contexts[i].state, *anchor = NULL;
+    memset(&contexts[i], 0, sizeof(contexts[i]));
+    if (!--group->refs) {
+        anchor = group->anchor;
+        free(group);
+    }
+    if (state)
+        gl4es_state_delete(state);
+    if (anchor)
+        gl4es_state_delete(anchor);
+}
+
+static void* bind_context(int i) {
+    if (!contexts[i].state) {
+        context_group_t *group = contexts[i].group;
+        if (!group->anchor)
+            group->anchor = gl4es_state_new(NULL);
+        contexts[i].state = gl4es_state_new(group->anchor);
+    }
+    contexts[i].bound = 1;
+    return contexts[i].state;
+}
+
+static void drop_if_destroyed(EGLContext ctx) {
+    pthread_mutex_lock(&contexts_lock);
+    int i = find_context(ctx);
+    if (i >= 0 && contexts[i].destroyed)
+        drop_context(i);
+    pthread_mutex_unlock(&contexts_lock);
+}
+
+static void unbind_context(EGLContext ctx) {
+    pthread_mutex_lock(&contexts_lock);
+    int i = find_context(ctx);
+    if (i >= 0)
+        contexts[i].bound = 0;
+    pthread_mutex_unlock(&contexts_lock);
+}
