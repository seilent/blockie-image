+    EGLContext ctx = egl_eglCreateContext(dpy, config, share_context, (hardext.esversion == 1) ? egl_context_attrib : egl_context_attrib_es2);
+    if (ctx == EGL_NO_CONTEXT)
+        return ctx;
+    pthread_mutex_lock(&contexts_lock);
+    int i = find_context(ctx);
+    if (i >= 0)
+        forget_context(i);
+    i = 0;
+    while (i < CONTEXTS_MAX && contexts[i].ctx != EGL_NO_CONTEXT)
+        i++;
+    if (i < CONTEXTS_MAX) {
+        int s = find_context(share_context);
+        context_group_t *group = (s >= 0) ? contexts[s].group : calloc(1, sizeof(context_group_t));
+        if (group) {
+            group->refs++;
+            contexts[i].ctx = ctx;
+            contexts[i].group = group;
+        }
+    }
+    pthread_mutex_unlock(&contexts_lock);
+    return ctx;
 }
 
 EGLBoolean gl4es_eglDestroyContext(EGLDisplay dpy, EGLContext ctx) {
     LOAD_EGL(eglDestroyContext);
+    LOAD_EGL(eglMakeCurrent);
+    LOAD_EGL(eglGetCurrentContext);
+    LOAD_EGL(eglGetCurrentDisplay);
+    LOAD_EGL(eglGetCurrentSurface);
+    pthread_mutex_lock(&contexts_lock);
+    int i = find_context(ctx);
+    int needs_current = 0;
+    if (i >= 0) {
+        if (contexts[i].bound)
+            contexts[i].destroyed = 1;
+        else if (!contexts[i].state && (contexts[i].group->refs > 1 || !contexts[i].group->anchor))
+            forget_context(i);
+        else
+            needs_current = 1;
+    }
+    pthread_mutex_unlock(&contexts_lock);
+    if (needs_current) {
+        EGLContext cur = egl_eglGetCurrentContext();
+        EGLDisplay cdpy = egl_eglGetCurrentDisplay();
+        EGLSurface cdraw = egl_eglGetCurrentSurface(EGL_DRAW);
+        EGLSurface cread = egl_eglGetCurrentSurface(EGL_READ);
+        pthread_mutex_lock(&contexts_lock);
+        int c = find_context(cur);
+        if (c >= 0 && contexts[c].destroyed) {
+            drop_context(c);
+            cur = EGL_NO_CONTEXT;
+        }
+        pthread_mutex_unlock(&contexts_lock);
+        if (egl_eglMakeCurrent(dpy, EGL_NO_SURFACE, EGL_NO_SURFACE, ctx)) {
+            pthread_mutex_lock(&contexts_lock);
+            i = find_context(ctx);
+            if (i >= 0)
+                drop_context(i);
+            pthread_mutex_unlock(&contexts_lock);
+            EGLBoolean back = (cur != EGL_NO_CONTEXT) && egl_eglMakeCurrent(cdpy, cdraw, cread, cur);
+            if (!back)
+                egl_eglMakeCurrent(dpy, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+            void *state = NULL;
+            pthread_mutex_lock(&contexts_lock);
+            c = find_context(cur);
+            if (c >= 0) {
+                if (back)
+                    state = bind_context(c);
+                else
+                    contexts[c].bound = 0;
+            }
+            pthread_mutex_unlock(&contexts_lock);
+            if (state)
+                gl4es_state_activate(state);
+        } else {
+            pthread_mutex_lock(&contexts_lock);
+            i = find_context(ctx);
+            if (i >= 0)
+                forget_context(i);
+            pthread_mutex_unlock(&contexts_lock);
+        }
+    }
     return egl_eglDestroyContext(dpy, ctx);
 }
 
 EGLBoolean gl4es_eglMakeCurrent(EGLDisplay dpy, EGLSurface draw, EGLSurface read, EGLContext ctx) {
     LOAD_EGL(eglMakeCurrent);
-    return egl_eglMakeCurrent(dpy, draw, read, ctx);
+    LOAD_EGL(eglGetCurrentContext);
+    EGLContext old = egl_eglGetCurrentContext();
+    if (old != ctx)
+        drop_if_destroyed(old);
+    EGLBoolean ret = egl_eglMakeCurrent(dpy, draw, read, ctx);
+    if (!ret)
+        return ret;
+    if (old != ctx)
+        unbind_context(old);
+    if (ctx != EGL_NO_CONTEXT) {
+        void *state = NULL;
+        pthread_mutex_lock(&contexts_lock);
+        int i = find_context(ctx);
+        if (i >= 0)
+            state = bind_context(i);
+        pthread_mutex_unlock(&contexts_lock);
+        gl4es_state_activate(state);
+    }
+    return ret;
+}
+
+EGLBoolean gl4es_eglReleaseThread(void) {
+    LOAD_EGL(eglReleaseThread);
+    LOAD_EGL(eglGetCurrentContext);
+    EGLContext old = egl_eglGetCurrentContext();
+    drop_if_destroyed(old);
+    EGLBoolean ret = egl_eglReleaseThread();
+    if (ret)
+        unbind_context(old);
+    return ret;
 }
 
