diff --git a/src/egl/egl.c b/src/egl/egl.c
index ec1e920..b747e6a 100644
--- a/src/egl/egl.c
+++ b/src/egl/egl.c
@@ -164,14 +164,52 @@ EGLDisplay gl4es_eglGetCurrentDisplay(void) {
     return egl_eglGetCurrentDisplay();
 }
 
+#define PLATFORM_ATTRIBS_MAX 64
+
 EGLDisplay gl4es_eglGetPlatformDisplay(EGLenum platform, void *native_display, const EGLAttrib *attrib_list) {
-    LOAD_EGL_EXT(eglGetPlatformDisplay);
+    LOAD_LIB_SILENT(egl, eglGetPlatformDisplay);
     if (egl_eglGetPlatformDisplay)
         return egl_eglGetPlatformDisplay(platform, native_display, attrib_list);
-    else {
-        LOAD_EGL(eglGetDisplay);
-        return egl_eglGetDisplay((EGLNativeDisplayType)native_display);
+    LOAD_LIB_SILENT(egl, eglGetPlatformDisplayEXT);
+    if (!egl_eglGetPlatformDisplayEXT) {
+        LOAD_EGL(eglGetProcAddress);
+        if (egl_eglGetProcAddress)
+            egl_eglGetPlatformDisplayEXT = (eglGetPlatformDisplayEXT_PTR)egl_eglGetProcAddress("eglGetPlatformDisplayEXT");
+    }
+    if (egl_eglGetPlatformDisplayEXT) {
+        EGLint list[PLATFORM_ATTRIBS_MAX];
+        int n = 0;
+        if (attrib_list) {
+            while (attrib_list[n] != EGL_NONE) {
+                if (n + 2 >= PLATFORM_ATTRIBS_MAX || attrib_list[n] != (EGLint)attrib_list[n] ||
+                    attrib_list[n + 1] != (EGLint)attrib_list[n + 1])
+                    return EGL_NO_DISPLAY;
+                list[n] = (EGLint)attrib_list[n];
+                list[n + 1] = (EGLint)attrib_list[n + 1];
+                n += 2;
+            }
+            list[n] = EGL_NONE;
+        }
+        return egl_eglGetPlatformDisplayEXT(platform, native_display, attrib_list ? list : NULL);
+    }
+    LOAD_EGL(eglGetDisplay);
+    return egl_eglGetDisplay((EGLNativeDisplayType)native_display);
+}
+
+EGLDisplay gl4es_eglGetPlatformDisplayEXT(EGLenum platform, void *native_display, const EGLint *attrib_list) {
+    EGLAttrib list[PLATFORM_ATTRIBS_MAX];
+    int n = 0;
+    if (attrib_list) {
+        while (attrib_list[n] != EGL_NONE) {
+            if (n + 2 >= PLATFORM_ATTRIBS_MAX)
+                return EGL_NO_DISPLAY;
+            list[n] = attrib_list[n];
+            list[n + 1] = attrib_list[n + 1];
+            n += 2;
+        }
+        list[n] = EGL_NONE;
     }
+    return gl4es_eglGetPlatformDisplay(platform, native_display, attrib_list ? list : NULL);
 }
 
 EGLBoolean gl4es_eglQueryContext(EGLDisplay dpy, EGLContext ctx, EGLint attribute, EGLint *value) {
@@ -255,7 +293,7 @@ AliasExport(EGLContext, eglGetCurrentContext,,(void));
 AliasExport(EGLSurface, eglGetCurrentSurface,,(EGLint readdraw));
 AliasExport(EGLDisplay, eglGetCurrentDisplay,,(void));
 AliasExport(EGLDisplay, eglGetPlatformDisplay,, (EGLenum platform, void *native_display, const EGLAttrib *attrib_list));
-AliasExport(EGLDisplay, eglGetPlatformDisplay, EXT, (EGLenum platform, void *native_display, const EGLAttrib *attrib_list));
+AliasExport(EGLDisplay, eglGetPlatformDisplayEXT,, (EGLenum platform, void *native_display, const EGLint *attrib_list));
 AliasExport(EGLBoolean, eglQueryContext,,(EGLDisplay dpy, EGLContext ctx, EGLint attribute, EGLint *value));
 AliasExport(EGLBoolean, eglWaitGL,,(void));
 AliasExport(EGLBoolean, eglWaitNative,,(EGLint engine));
