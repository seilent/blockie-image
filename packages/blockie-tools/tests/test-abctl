                               capture_output=True, text=True)
            lines = open(trace).read().splitlines()
            opens = [line for line in lines if line.startswith("openat(") and f'"{m}"' in line]
            pw = [re.search(r", (\d+), (\d+)\) = (-?\d+)$", line).groups() for line in lines
                  if line.startswith("pwrite64(")]
            return r.returncode, opens, pw

        for args, before, size, off in ((["default-a"], F, 512, 2048), (["hold-b"], D, 512, 2048),
                                        (["fix-b"], bc_of("_a", (15, 0, 0), (0, 0, 0)), 512, 2048),
                                        (["unprove-b"], D, 512, 2048),
                                        (["refund-a"], D2, 512, 2048), (["test-b"], D, 512, 2048),
                                        (["arm-a"], F, 512, 2048), (["arm-b-once"], D, 512, 2048),
                                        (["rearm"], T, 512, 2048), (["bcb-recovery", "menu"], D, 512, 0),
                                        (["bcb-attempt"], D, 512, 0), (["bcb-input"], D, 512, 0),
                                        (["bcb-clear"], D, 512, 0), (["clear-msg"], D, 2048, 0)):
            put(before)
            rc, opens, pw = traced(["-d", m] + args)
            check(rc == 0 and pw == [(str(size), str(off), str(size))] and len(opens) == 1 and
                  "O_DIRECT" in opens[0] and "O_SYNC" in opens[0],
                  f"abctl {' '.join(args)}: one O_DIRECT|O_SYNC open, one {size} byte write at {off}: {pw}")

        def put_msg(sec, bc=D):
            open(m, "wb").write(sec + orig[512:0x800] + bc + orig[0x820:])

        def msg_is(sec, what, bc=D):
            check(cur() == sec + orig[512:0x800] + bc + orig[0x820:], what)

        ours = b"recovery\n--blockie=menu"
        put(D)
        rc, out, err = abctl("-d", m, "bcb-recovery", "menu")
        check(rc == 0 and 'message command "boot-recovery"' in out, "bcb-recovery menu exit 0")
        msg_is(bcb(b"boot-recovery", b"", ours), "bcb-recovery menu: sector 0 command, empty status, recovery args; "
                                                 "the rest of misc as before")
        for n in (1, 2, 3):
            rc, out, err = abctl("-d", m, "bcb-attempt")
            check(rc == 0 and out == f"{n}\n", f"bcb-attempt {n} on our command prints {n}")
            msg_is(bcb(b"boot-recovery", f"blockie-attempt={n}".encode(), ours),
                   f"bcb-attempt {n}: status blockie-attempt={n}, command and recovery kept")
        rc, out, err = abctl("-d", m, "bcb-attempt")
        check(rc == 0 and out == "3\n" and "counted as the bound" in err, "bcb-attempt on blockie-attempt=3 prints 3")
        wipe = b"recovery\n--wipe_data\n"
        put_msg(bcb(b"boot-recovery", b"", wipe))
        for n in (1, 2, 3):
            rc, out, err = abctl("-d", m, "bcb-attempt")
            check(rc == 0 and out == f"{n}\n", f"bcb-attempt {n} on Android's --wipe_data prints {n}")
            msg_is(bcb(b"boot-recovery", f"blockie-attempt={n}".encode(), wipe),
                   f"bcb-attempt {n} on --wipe_data: command and recovery kept")
        for status, what in ((b"blockie-attem\xff\x13", "torn"), (b"blockie-attempt=1\x00\x00x", "torn tail"),
                             (b"OKAY", "foreign"), (b"blockie-attempt=0", "foreign =0"),
                             (b"blockie-attempt=12", "foreign =12")):
            put_msg(bcb(b"boot-recovery", status, ours))
            rc, out, err = abctl("-d", m, "bcb-attempt")
            check(rc == 0 and out == "3\n" and "counted as the bound" in err,
                  f"bcb-attempt on a {what} status prints 3")
            msg_is(bcb(b"boot-recovery", b"blockie-attempt=3", ours), f"bcb-attempt on a {what} status writes =3")
        put_msg(bcb(b"boot-recovery", b"", ours))
        rc, out, err = abctl("-d", m, "show")
        check(rc == 0 and out.splitlines()[-3:] == ['message command "boot-recovery"', "message reason menu",
                                                    "bproof 1"],
              "show of our menu command: the command line, then 'message reason menu', then 'bproof 1'")
        head = ("suffix _a\nmagic 0x42414342 ok\nversion 1\nnb_slot 2\nrecovery_tries 0\nmerge_status 0\n"
                f"crc32 0x{zlib.crc32(D[:28]):08x} ok\n{slot('a', 15, 3, 0)}\n{slot('b', 13, 1, 1)}\nclass ours\n")
        open(m, "wb").write(bytes(0x800) + D + orig[0x820:])
        rc, out, err = abctl("-d", m, "show")
        check(rc == 0 and out == head + "message zero\nbproof 1\n",
              "show on a zero message: the lines of abctl 1edfdc8 byte for byte, then bproof 1 last")
        for args, old, what in (((b"boot-recovery", b"blockie-attempt=2", ours),
                                 'message command "boot-recovery"\nmessage reason menu\n', "our menu command"),
                                ((b"bootonce-bootloader",), 'message command "bootonce-bootloader"\n',
                                 "a foreign command")):
            for ref, new in ((b"", ""), (b"blockie-refresh=3", "message refresh 3\n")):
                put_msg(bcb(*args, refresh=ref))
                rc, out, err = abctl("-d", m, "show")
                check(rc == 0 and out == head + old + new + "bproof 1\n",
                      f"show on {what}{' with a refresh counter' if ref else ''}: the lines of abctl 1edfdc8 byte for "
                      f"byte, then {new.strip() + ', then ' if new else ''}bproof 1 last")
        for cmd, shown, what in ((b"x\nbproof 1\n", "x\\x0abproof 1\\x0a", "a newline"), (b'a"b', "a\\x22b", "a quote"),
                                 (b"a\\b", "a\\x5cb", "a backslash"), (b"\xff\x7f\x01\t~ ", "\\xff\\x7f\\x01\\x09~ ",
                                 "a high byte, DEL, a control byte, a tab")):
            put_msg(bcb(cmd, b"", ours))
            rc, out, err = abctl("-d", m, "show")
            lines = out.splitlines()
            check(rc == 0 and out == head + f'message command "{shown}"\nbproof 1\n' and
                  len([x for x in lines if x.startswith("bproof")]) == 1,
                  f"show on a command holding {what}: one message command line with \\xNN, bproof 1 the only and last "
                  f"bproof line: {lines[10:]}")
        for sec, why, what in ((bcb(b"boot-recovery", b"blockie-attempt=2", ours), "menu", "our command with a count"),
                               (bcb(b"boot-recovery", b"", b"recovery\n--blockie=" + b"x" * 32), "x" * 32,
                                "a 32 character reason"),
                               (bcb(b"boot-recovery", b"", wipe), None, "Android's --wipe_data"),
                               (bcb(b"boot-recovery", b"", b"recovery\n--blockie=menu\n"), None, "a reason and a newline"),
                               (bcb(b"boot-recovery", b"", b"recovery\n--blockie="), None, "an empty reason"),
                               (bcb(b"boot-recovery", b"", b"recovery\n--blockie=" + b"x" * 33), None,
                                "a 33 character reason"),
                               (bcb(b"boot-recovery", b"", b"recovery\n--blockie=Menu"), None, "an upper case reason"),
                               (bcb(b"boot-recoveryx", b"", ours), None, "another command"),
                               (bcb(b"bootonce-bootloader", b"", ours), None, "bootonce-bootloader with our arguments")):
            put_msg(sec)
            rc, out, err = abctl("-d", m, "show")
            r = [x for x in out.splitlines() if x.startswith("message reason ")]
            check(rc == 0 and r == ([f"message reason {why}"] if why else []), f"show on {what}: reason lines {r}")
        for sec, what in ((bytes(512), "zero sector 0"),
                          (bcb(b"", b"blockie-attempt=2", ours), "no command, status 2")):
            put_msg(sec)
            rc, out, err = abctl("-d", m, "bcb-attempt")
            check(rc == 3 and out == "empty\n", f"bcb-attempt on {what}: exit 3, empty")
            msg_is(sec, f"bcb-attempt on {what}: nothing written")
        put_msg(bcb(b"boot-recovery", b"blockie-attempt=2", ours))
        rc, out, err = abctl("-d", m, "bcb-clear")
        check(rc == 0, "bcb-clear exit 0")
        msg_is(bytes(512), "bcb-clear zeroes sector 0 only")
        put_msg(bcb(b"boot-recovery", b"", ours), TORN)
        rc, out, err = abctl("-d", m, "bcb-clear")
        check(rc == 0, "bcb-clear works on a torn slot sector with the magic intact")
        msg_is(bytes(512), "bcb-clear on a torn slot sector keeps it as read", TORN)
        nomagic = bytearray(D)
        nomagic[4] = 0x43
        nomagic = fix_crc(nomagic)
        for args in (["bcb-recovery", "menu"], ["bcb-attempt"], ["bcb-clear"], ["bcb-refresh", "8"]):
            put_msg(bcb(b"boot-recovery", b"", ours), nomagic)
            rc, out, err = abctl("-d", m, *args)
            check(rc == 1 and "magic" in err, f"{' '.join(args)} refused without BCAB at 0x804")
            msg_is(bcb(b"boot-recovery", b"", ours), f"{' '.join(args)} without magic: file unchanged", nomagic)
        put_msg(bcb(b"boot-recovery", b"blockie-attempt=2", ours))
        rc, out, err = abctl("-d", m, "bcb-input")
        check(rc == 0, "bcb-input exit 0")
        msg_is(bcb(b"boot-recovery", b"", ours), "bcb-input empties the status, keeps command and recovery")
        rc, out, err = abctl("-d", m, "bcb-attempt")
        check(rc == 0 and out == "1\n", "bcb-attempt after bcb-input prints 1")
        put_msg(bcb(b"boot-recovery", b"blockie-attem\xff", wipe))
        rc, out, err = abctl("-d", m, "bcb-input")
        msg_is(bcb(b"boot-recovery", b"", wipe), "bcb-input on --wipe_data with a torn status: status empty, rest kept")
        sec = bcb(b"", b"blockie-attempt=2", ours)
        put_msg(sec)
        rc, out, err = abctl("-d", m, "bcb-input")
        check(rc == 3 and out == "empty\n", "bcb-input with no command: exit 3, empty")
        msg_is(sec, "bcb-input with no command: nothing written")
        put_msg(bcb(b"boot-recovery", b"blockie-attempt=1", ours), nomagic)
        rc, out, err = abctl("-d", m, "bcb-input")
        check(rc == 1 and "magic" in err, "bcb-input refused without BCAB at 0x804")
        msg_is(bcb(b"boot-recovery", b"blockie-attempt=1", ours), "bcb-input without magic: file unchanged", nomagic)

        inst = b"recovery\n--blockie=install"
        put_msg(bcb(b"boot-recovery", b"blockie-attempt=1", inst))
        for n in range(1, 9):
            rc, out, err = abctl("-d", m, "bcb-refresh", "8")
            msg_is(bcb(b"boot-recovery", b"blockie-attempt=1", inst, f"blockie-refresh={n}".encode()),
                   f"bcb-refresh 8, refresh {n}: blockie-refresh={n} at misc+448, the rest of sector 0 kept")
            rc2, out2, err2 = abctl("-d", m, "show")
            lines = out2.splitlines()
            check(rc == 0 and rc2 == 0 and "message reason install" in lines and f"message refresh {n}" in lines,
                  f"show after refresh {n}: message reason install and message refresh {n}")
        before = cur()
        rc, out, err = abctl("-d", m, "bcb-refresh", "8")
        check(rc == 1 and "the cap is 8" in err and cur() == before,
              "bcb-refresh 8 after 8 refreshes: refused at the cap, nothing written")
        rc, out, err = abctl("-d", m, "bcb-refresh", "9")
        msg_is(bcb(b"boot-recovery", b"blockie-attempt=1", inst, b"blockie-refresh=9"), "bcb-refresh 9 after 8: 9")
        for torn, what in ((b"blockie-refresh=x", "a letter"), (b"blockie-refresh=3\x00\xff", "a torn tail"),
                           (b"blockie-refresh=0", "=0"), (b"blockie-refresh=100", "=100"), (b"\xff", "one byte")):
            sec = bcb(b"boot-recovery", b"", inst, torn)
            put_msg(sec)
            rc, out, err = abctl("-d", m, "bcb-refresh", "8")
            check(rc == 1 and "counted as the cap" in err, f"bcb-refresh on a torn counter ({what}): refused")
            msg_is(sec, f"bcb-refresh on a torn counter ({what}): nothing written")
            rc, out, err = abctl("-d", m, "show")
            check(rc == 0 and not [x for x in out.splitlines() if x.startswith("message refresh")],
                  f"show on a torn counter ({what}): no message refresh line")
        for sec, what in ((bytes(512), "zero sector 0"), (bcb(b"", b"", inst), "no command, our recovery field")):
            put_msg(sec)
            rc, out, err = abctl("-d", m, "bcb-refresh", "8")
            check(rc == 3 and out == "empty\n", f"bcb-refresh on {what}: exit 3, empty")
            msg_is(sec, f"bcb-refresh on {what}: nothing written")
        for sec, what in ((bcb(b"boot-recovery", b"", wipe), "Android's --wipe_data"),
                          (bcb(b"bootonce-bootloader"), "bootonce-bootloader"),
                          (bcb(b"boot-recovery", b"", b"recovery\n--blockie=Menu"), "an upper case reason")):
            put_msg(sec)
            rc, out, err = abctl("-d", m, "bcb-refresh", "8")
            check(rc == 1 and "not ours" in err, f"bcb-refresh on {what}: refused")
            msg_is(sec, f"bcb-refresh on {what}: nothing written")
        put_msg(bcb(b"boot-recovery", b"blockie-attempt=2", inst, b"blockie-refresh=3"))
        rc, out, err = abctl("-d", m, "bcb-input")
        msg_is(bcb(b"boot-recovery", b"", inst, b"blockie-refresh=3"), "bcb-input keeps the refresh counter")
        rc, out, err = abctl("-d", m, "bcb-attempt")
        msg_is(bcb(b"boot-recovery", b"blockie-attempt=1", inst, b"blockie-refresh=3"),
               "bcb-attempt keeps the refresh counter")
        rc, out, err = abctl("-d", m, "bcb-recovery", "install")
        msg_is(bcb(b"boot-recovery", b"", inst), "bcb-recovery zeroes the refresh counter with sector 0")
        put_msg(bcb(b"boot-recovery", b"", inst, b"blockie-refresh=3"))
        rc, out, err = abctl("-d", m, "bcb-clear")
        msg_is(bytes(512), "bcb-clear zeroes the refresh counter with sector 0")
        put_msg(bcb(b"boot-recovery", b"", inst))
        for args in (["bcb-refresh"], ["bcb-refresh", "0"], ["bcb-refresh", "x"], ["bcb-refresh", "100"],
                     ["bcb-refresh", "-1"], ["bcb-refresh", "8", "x"], ["bcb-refresh", ""]):
            rc, out, err = abctl("-d", m, *args)
            check(rc == 2, f"abctl {' '.join(args)} is a usage error")
            msg_is(bcb(b"boot-recovery", b"", inst), f"abctl {' '.join(args)}: nothing written")
        rc, opens, pw = traced(["-d", m, "bcb-refresh", "8"])
        check(rc == 0 and pw == [("512", "0", "512")] and len(opens) == 1 and "O_DIRECT" in opens[0],
              f"abctl bcb-refresh 8: one O_DIRECT open, one 512 byte write at 0: {pw}")

        put(F)
        rc, opens, pw = traced(["-d", m, "hold-b"])
        check(rc == 1 and pw == [], f"hold-b refused on F: no pwrite64: {pw}")
        put_msg(bytes(512))
        rc, opens, pw = traced(["-d", m, "bcb-attempt"])
        check(rc == 3 and pw == [], f"bcb-attempt empty: no pwrite64: {pw}")

        def injected(spec, args):
            r = subprocess.run(["strace", "-qq", "-o", trace, "-e", "inject=" + spec, ABCTL, "-d", m] + args,
                               capture_output=True, text=True)
            return r.returncode, r.stdout, r.stderr

        for spec, args, why, changed in (("pwrite64:error=EIO", ["default-a"], "Input/output error", False),
                                         ("pwrite64:retval=100", ["default-a"], "got 100 of 512 bytes", False),
                                         ("pwrite64:retval=512", ["default-a"], "read back differs", False),
                                         ("fsync:error=EIO", ["default-a"], "fsync failed", True),
                                         ("pwrite64:error=EIO", ["bcb-attempt"], "Input/output error", False)):
            put(F)
            rc, out, err = injected(spec, args)
            after = orig[:0x800] + (D if changed else F) + orig[0x820:]
            check(rc == 4 and why in err and cur() == after,
                  f"abctl {' '.join(args)} with {spec}: exit 4 (write attempted, state unknown): {err.strip()}")

        put(D)
        rc, out, err = abctl("-d", m, "bcb-recovery", "x" * 32)
        check(rc == 0, "bcb-recovery takes a 32 character reason")
        msg_is(bcb(b"boot-recovery", b"", b"recovery\n--blockie=" + b"x" * 32),
               "bcb-recovery writes a 32 character reason")
        put(D)
        for args in (["bcb-recovery"], ["bcb-recovery", ""], ["bcb-recovery", "Menu"], ["bcb-recovery", "a b"],
                     ["bcb-recovery", "../x"], ["bcb-recovery", "x" * 33], ["bcb-recovery", "menu", "x"],
                     ["bcb-attempt", "x"], ["bcb-input", "x"], ["bcb-clear", "x"], ["default-a", "x"],
                     ["fix-b", "x"]):
            rc, out, err = abctl("-d", m, *args)
            check(rc == 2 and cur() == orig[:0x800] + D + orig[0x820:], f"abctl {' '.join(args)} is a usage error")

        put(D)
        before = cur()
        held = os.open(m, os.O_RDONLY)
        fcntl.flock(held, fcntl.LOCK_EX)
        try:
            for args in (["bcb-clear"], ["default-a"], ["bcb-attempt"]):
                t0 = time.time()
                rc, out, err = abctl("-d", m, *args)
                took = time.time() - t0
                check(rc == 1 and "abctl: misc busy" in err and cur() == before and 4.5 <= took < 8,
                      f"abctl {' '.join(args)} while another holds the misc lock: exit 1 after {took:.1f} s, "
                      f"misc busy, nothing written")
            rc, out, err = abctl("-d", m, "show")
            check(rc == 0 and "message command" in out, "show reads while the lock is held: a read takes no lock")
        finally:
            fcntl.flock(held, fcntl.LOCK_UN)
            os.close(held)
        subprocess.run(["strace", "-qq", "-e", "trace=flock", "-o", trace, ABCTL, "-d", m, "bcb-clear"],
                       capture_output=True)
        fl = [line for line in open(trace).read().splitlines() if line.startswith("flock(")]
        check(len(fl) == 1 and "LOCK_EX|LOCK_NB" in fl[0] and fl[0].endswith("= 0") and cur()[:512] == bytes(512)
              and cur()[512:] == before[512:], f"bcb-clear with the lock free: one LOCK_EX|LOCK_NB flock, written {fl}")
        subprocess.run(["strace", "-qq", "-e", "trace=flock", "-o", trace, ABCTL, "-d", m, "show"],
                       capture_output=True)
        check(not [line for line in open(trace).read().splitlines() if line.startswith("flock(")],
              "show takes no flock")

        if a.loop:
            img = os.path.join(d, "loop.img")
            with open(img, "wb") as f:
                f.truncate(8 << 20)
            subprocess.run(["sfdisk", "-q", img], input="label: gpt\nsize=1MiB, name=misc\nsize=1MiB, name=boot_a\n",
                           text=True, check=True, capture_output=True)
            dev = sudo("losetup", "--find", "--show", "--partscan", img).decode().strip()
            try:
                p1, p2 = dev + "p1", dev + "p2"
                nodes = all(os.path.exists(p) and stat.S_ISBLK(os.stat(p).st_mode) for p in (p1, p2))
                check(nodes, f"{p1} and {p2} exist and are block devices before any dd")
                if not nodes:
                    sys.exit("loop partition nodes missing, nothing written")
                for p in (p1, p2):
                    sudo("dd", "of=" + p, "bs=4096", "conv=fsync", "status=none", data=orig)
                rc, out, err = abctl("-d", p1, "clear-msg", root=True)
                check(rc == 0 and "message zero" in out, f"clear-msg on {p1} (PARTNAME misc) exit 0")
                head = sudo("dd", "if=" + p1, "bs=4096", "count=1", "status=none")
                check(head[:2048] == bytes(2048) and head[2048:] == orig[2048:4096], f"{p1}: bytes 0 to 2047 zero")
                rc, out, err = abctl("-d", p2, "clear-msg", root=True)
                head = sudo("dd", "if=" + p2, "bs=4096", "count=1", "status=none")
                check(rc == 1 and "not the misc partition" in err and head == orig[:4096],
                      f"clear-msg refused on {p2} (PARTNAME boot_a), unchanged")
                rc, out, err = abctl("-d", dev, "clear-msg", root=True)
                check(rc == 1 and "not the misc partition" in err, f"clear-msg refused on the whole disk {dev}")
                rc, out, err = abctl("-d", p1, "restore", a.misc, root=True)
                head = sudo("dd", "if=" + p1, "bs=4096", "count=1", "status=none")
                check(rc == 0 and head == orig[:4096], f"restore of the backup misc.bin on {p1}")
                rc, out, err = abctl("-d", p1, "default-a", root=True)
                head = sudo("dd", "if=" + p1, "bs=4096", "count=1", "status=none")
                check(rc == 0 and head[0x800:0x820] == bc_of("_a", (15, 3, 0), (13, 1, 1)) and
                      head[:0x800] == orig[:0x800] and head[0x820:] == orig[0x820:4096],
                      f"default-a on {p1}: a 15/3/0, b 13/1/1, the rest as before")
                rc, out, err = abctl("-d", p1, "bcb-recovery", "menu", root=True)
                rc2, out2, err2 = abctl("-d", p1, "bcb-attempt", root=True)
                head = sudo("dd", "if=" + p1, "bs=4096", "count=1", "status=none")
                check(rc == 0 and rc2 == 0 and out2 == "1\n" and
                      head[:512] == bcb(b"boot-recovery", b"blockie-attempt=1", b"recovery\n--blockie=menu") and
                      head[512:0x800] == orig[512:0x800], f"bcb-recovery menu and bcb-attempt on {p1}")
                rc, out, err = abctl("-d", p1, "bcb-clear", root=True)
                rc2, out2, err2 = abctl("-d", p1, "bcb-attempt", root=True)
                head = sudo("dd", "if=" + p1, "bs=4096", "count=1", "status=none")
                check(rc == 0 and head[:512] == bytes(512) and head[512:0x800] == orig[512:0x800] and rc2 == 3 and
                      out2 == "empty\n", f"bcb-clear on {p1}, then bcb-attempt exits 3 (empty)")
                rc, out, err = abctl("-d", p2, "bcb-clear", root=True)
                check(rc == 1 and "not the misc partition" in err, f"bcb-clear refused on {p2}")
                rc, out, err = abctl("-d", p2, "arm-a", root=True)
                check(rc == 1 and "not the misc partition" in err, f"arm-a refused on {p2}")
            finally:
                sudo("losetup", "-d", dev)

    if fails:
        sys.exit(f"{len(fails)} failed")
    print("all passed")


if __name__ == "__main__":
    main()
