              "show reads a drained a and a drained b: both unbootable")

        rfile = os.path.join(d, "restore.bin")
        for live, src, after, what in ((U, D, U, "a file with b successful 1 over a live b successful 0 keeps 0"),
                                       (D, U, U, "a file with b successful 0 over a live 1 writes 0"),
                                       (D, H, H, "a file with b successful 1 over a live 1 keeps 1"),
                                       (TORN, D, U, "a file with b successful 1 over a torn live block writes 0")):
            open(rfile, "wb").write(orig[:0x800] + src + orig[0x820:])
            put(live)
            rc, out, err = abctl("-d", m, "restore", rfile)
            data = cur()
            check(rc == 0 and data[0x800:0x820] == after and data[:0x800] == orig[:0x800] and
                  data[0x820:] == orig[0x820:], f"restore: {what}" + (": " + err.strip() if rc else ""))

        for bc, cls, what in ((D, "ours", "D"), (H, "ours", "H"), (F, "ours", "a 0/0/0, b 15/1/1"),
                              (RESET, "reset", "equal priorities"), (MTK, "reset", "MTK's default block"),
                              (bc_of("_a", (15, 7, 0), (13, 1, 1)), "reset", "a tries 7"),
