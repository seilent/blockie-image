        for cmd in ("default-a", "hold-b", "fix-b", "unprove-b", "refund-a", "test-b", "arm-a", "arm-b-once", "rearm"):
            refused(cmd, TORN, "no valid bootloader_control", f"{cmd} refused on a torn sector")

        def traced(args):
