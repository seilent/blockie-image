            walk.append(cur()[0x800:0x820])
            check(rc == 0 and walk[-1] == after, f"walk: {cmd} gives {after.hex()}: {walk[-1].hex()}")
        check(all(not b[14] >> 7 for b in walk[1:]), "walk (unprove-b, hold-b, a try, the drain, fix-b, default-a): b "
