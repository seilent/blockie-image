From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: seilent <github@seilent.net>
Date: Sun, 8 Nov 2026 18:00:00 +0900
Subject: [PATCH] lxc: clone no IPC namespace, include the Blockie device, pad
 and memory configs

---
 data/configs/config_base | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/data/configs/config_base b/data/configs/config_base
index 99fd198..cb160f9 100644
--- a/data/configs/config_base
+++ b/data/configs/config_base
@@ -9,10 +9,15 @@ lxc.cap.keep = audit_control sys_nice wake_alarm setpcap setgid setuid sys_ptrac
 
 lxc.mount.auto = cgroup:ro sys:ro proc
 
+lxc.namespace.clone = mnt uts pid net cgroup
+
 lxc.console.path = none
 
 lxc.include = /var/lib/waydroid/lxc/waydroid/config_nodes
 lxc.include = /var/lib/waydroid/lxc/waydroid/config_session
+lxc.include = /run/blockie-android/lxc.d/devices.conf
+lxc.include = /run/blockie-android/lxc.d/pad.conf
+lxc.include = /run/blockie-android/lxc.d/memory.conf
 
 lxc.hook.post-stop = /dev/null
 
