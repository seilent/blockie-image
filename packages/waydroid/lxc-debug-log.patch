From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: seilent <github@seilent.net>
Date: Sun, 8 Nov 2026 18:00:00 +0900
Subject: [PATCH] lxc: write a DEBUG log of lxc-start to
 /run/blockie-android/lxc.log when BLOCKIE_ANDROID_LXCLOG=1

---
 tools/helpers/lxc.py | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/tools/helpers/lxc.py b/tools/helpers/lxc.py
index 1152de8..42ed8c8 100644
--- a/tools/helpers/lxc.py
+++ b/tools/helpers/lxc.py
@@ -395,7 +395,11 @@ def wait_for_running(args):
 
 def start(args):
     command = ["lxc-start", "-P", tools.config.defaults["lxc"],
-               "-F", "-n", "waydroid", "--", "/init"]
+               "-F", "-n", "waydroid"]
+    if os.environ.get("BLOCKIE_ANDROID_LXCLOG") == "1":
+        os.makedirs("/run/blockie-android", exist_ok=True)
+        command += ["-l", "DEBUG", "-o", "/run/blockie-android/lxc.log"]
+    command += ["--", "/init"]
     tools.helpers.run.user(args, command, output="background")
     wait_for_running(args)
     # Workaround lxc-start changing stdout/stderr permissions to 700
