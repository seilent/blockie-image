#!/usr/bin/env python3
import hashlib
import json
import os
import sys
import time
import zlib

args = sys.argv[1:]
fd = int(os.environ["BLOCKIE_DD_FD"])
world = json.load(open(os.environ["FAKE_DD"]))
log = os.environ["FAKE_DD_LOG"]
op = ("library" if "-blockie-library" in args else "scan" if "-blockie-scan" in args else
      "pass" if "-manifest-only" in args else "get")
counter = os.path.join(os.path.dirname(log), f"dd-{op}.count")
n = int(open(counter).read()) if os.path.exists(counter) else 0
with open(counter, "w") as f:
    f.write(str(n + 1))
steps = world.get(op) or [{}]
step = steps[min(n, len(steps) - 1)]
config = os.environ["BLOCKIE_DD_CONFIG"]
filelist = None
if "-filelist" in args:
    with open(args[args.index("-filelist") + 1]) as f:
        filelist = f.read().splitlines()
if "-blockie-scan" in args:
    with open(args[args.index("-blockie-scan") + 1]) as f:
        filelist = f.read().splitlines()
print(f"Logging 'invented-account' into Steam3... {world.get('token', 'tok-invented-0000')}", flush=True)
print(f"invented-account {world.get('token', 'tok-invented-0000')}", file=sys.stderr, flush=True)
with open(log, "a") as f:
    f.write(json.dumps({"op": op, "n": n, "args": args, "pid": os.getpid(), "filelist": filelist,
                        "env": {k: os.environ.get(k) for k in ("BLOCKIE_DD_CONFIG", "BLOCKIE_DD_DEVICE", "HOME",
                                                                "TMPDIR", "DOTNET_EnableDiagnostics")}}) + "\n")


def out(*fields):
    os.write(fd, ("\t".join(str(x) for x in fields) + "\n").encode())


def after(name):
    if name not in args:
        return []
    i = args.index(name) + 1
    vals = []
    while i < len(args) and not args[i].startswith("-"):
        vals.append(args[i])
        i += 1
    return vals


def varint(v):
    b = b""
    while True:
        if v < 0x80:
            return b + bytes([v])
        b += bytes([(v & 0x7f) | 0x80])
        v >>= 7


def save_token():
    key, val = b"invented-account", world.get("token", "tok-invented-0000").encode()
    entry = b"\x0a" + varint(len(key)) + key + b"\x12" + varint(len(val)) + val
    c = zlib.compressobj(wbits=-15)
    with open(config, "wb") as f:
        f.write(c.compress(b"\x22" + varint(len(entry)) + entry) + c.flush())
    os.chmod(config, 0o600)


def finish(rc):
    sys.exit(rc)


qr = "-qr" in args
if qr:
    for i, url in enumerate(step.get("qr", ["https://s.team/q/1/1111111111111111111"])):
        if i:
            time.sleep(step.get("qr_gap", 0))
        out("qr", url)
    if step.get("hold"):
        time.sleep(step["hold"])
    if not step.get("approve", True):
        out("fail", "expired")
        finish(1)
    save_token()
    out("exp", "30")
elif step.get("reject") or not os.path.exists(config):
    if os.path.exists(config):
        os.unlink(config)
    out("fail", "login")
    finish(1)
if step.get("fail"):
    out("fail", *step["fail"].split(" "))
    finish(1)
if step.get("loop"):
    time.sleep(step["loop"])
if op == "library":
    for line in world.get("lines", []):
        out(line)
    for line in step.get("extra", []):
        out(line)
    if step.get("noend"):
        finish(0)
    out("end")
    finish(step.get("rc", 0))
if op == "scan":
    time.sleep(step.get("delay", 0))
    for line in step.get("extra", []):
        out(line)
    scans = world.get("scans", {})
    for i, (a, d, g) in enumerate(x.split("\t") for x in filelist if x):
        if i == 0 and step.get("stall_first"):
            out("scan", d, g)
            time.sleep(step["stall_first"])
            continue
        s = scans.get(d, {})
        if "fail" in s:
            out("scanfail", d, g, s["fail"])
            if s["fail"] == "rate":
                break
            continue
        out("scan", d, g)
        for p in s.get("paths", ["invented.bin"]):
            out(p if "\t" in p else f"path\t1\t{p}")
        out("scanned", d, g)
    if step.get("hang"):
        time.sleep(step["hang"])
    if step.get("noend"):
        finish(0)
    out("end")
    finish(step.get("rc", 0))
depots = after("-depot")
mans = after("-manifest")
work = after("-dir")[0]
wanted = None if filelist is None else {x for x in filelist if x}
if op == "get" and len(mans) != len(depots):
    out("fail", "depot")
    finish(1)
files = {p: v for p, v in world["files"].items() if wanted is None or p in wanted}
for p in step.get("extra", []):
    files[p] = {"data": "extra"}
os.makedirs(os.path.join(work, ".DepotDownloader"), exist_ok=True)
cfg = os.path.join(work, ".DepotDownloader", "depot.config")
if op == "get" and os.path.exists(cfg) and open(cfg).read() == "bad":
    os.abort()
with open(cfg, "w") as f:
    f.write("ok")
if op == "pass":
    public = world.get("public", {})
    for i, d in enumerate(depots):
        ids = public.get(d, ["1000"])
        out("manifest", d, mans[i] if mans else ids[min(n, len(ids) - 1)])
    total = 0
    for p in sorted(files):
        data = files[p].get("data", "").encode()
        out("file", hashlib.sha1(data).hexdigest(), len(data), p)
        total += len(data)
    if not step.get("nototal"):
        out("total", total)
    if step.get("noend"):
        finish(0)
    out("end")
    finish(step.get("rc", 0))
got = 0
for p in sorted(files):
    full = os.path.join(work, p)
    os.makedirs(os.path.dirname(full), exist_ok=True)
    data = files[p].get("data", "").encode()
    with open(full, "wb") as f:
        f.write(data)
    if files[p].get("exec"):
        os.chmod(full, os.stat(full).st_mode | 0o111)
    got += len(data)
    out("got", got)
for i in range(step.get("flood", 0)):
    out("got", got + i)
end = time.monotonic() + step.get("got_for", 0)
while time.monotonic() < end:
    time.sleep(0.2)
    got += 0 if step.get("validate") else 1
    out("got", got)
if step.get("crash"):
    os.abort()
if step.get("noend"):
    finish(0)
out("end")
finish(step.get("rc", 0))
