#!/usr/bin/python3
import configparser
import hashlib
import io
import os
import re
import shutil
import subprocess
import sys

ME = "blockie-android-prep"
DATA = os.environ.get("BLOCKIE_DATA_DIR", "/var/lib/blockie/data")
RUN = os.environ.get("BLOCKIE_ANDROID_RUN", "/run/blockie-android")
WORK = os.environ.get("BLOCKIE_WAYDROID_WORK", "/var/lib/waydroid")
PIN = os.environ.get("BLOCKIE_ANDROID_PIN", "/usr/share/blockie/android.d/lineage-20-gapps.conf")
KL = os.environ.get("BLOCKIE_ANDROID_KL", "/usr/share/blockie/android/Vendor_4001_Product_0428.kl")
BASE = os.environ.get("BLOCKIE_WAYDROID_BASE", "/usr/lib/waydroid/data/configs/config_base")
PAYLOAD = os.environ.get("BLOCKIE_ANDROID_PAYLOAD", "/sys/fs/cgroup/lxc.payload.waydroid")
LOCALTIME = os.environ.get("BLOCKIE_LOCALTIME", "/etc/localtime")
EXTRA = "/usr/share/waydroid-extra/images"
ANDROID = os.path.join(DATA, "android")
IMAGES = os.path.join(ANDROID, "images")
PREPARED = os.path.join(ANDROID, "prepared")
CFG = os.path.join(WORK, "waydroid.cfg")
GPU_PIN = os.environ.get("BLOCKIE_ANDROID_GPU_PIN", "/usr/share/blockie/android.d/gpu-mt6768.conf")
VENDOR = os.environ.get("BLOCKIE_ANDROID_VENDOR", "/vendor")
OVERLAY = os.path.join(WORK, "overlay", "vendor")
HWC_SHIM = os.environ.get("BLOCKIE_ANDROID_HWC_SHIM", os.path.join(ANDROID, "hwc", "hwcomposer.blockie.so"))
BOOT_ID = os.environ.get("BLOCKIE_BOOT_ID", "/proc/sys/kernel/random/boot_id")
KBASE_ARMED = os.environ.get("BLOCKIE_KBASE_ARMED", "/sys/module/blockie_kbase_pidns/parameters/armed")
BASE_PROP = os.environ.get("BLOCKIE_WAYDROID_BASE_PROP", os.path.join(WORK, "waydroid_base.prop"))
GPU_STAGED = os.path.join(ANDROID, "gpu-staged")
GPU_DIGEST = os.path.join(RUN, "gpu-digest")
GPU_MODE = os.path.join(RUN, "gpu-mode")
SHIMPATH = "lib64/hw/hwcomposer.blockie.so"
PROPERTIES = {
    "persist.waydroid.width": "960",
    "persist.waydroid.height": "720",
    "persist.waydroid.uevent": "false",
    "persist.waydroid.suspend": "false",
}
PINNED = {"suspend_action": "freeze", "mount_overlays": "True"}
GPU_PROPS = {
    "ro.hardware.egl": "mali",
    "ro.hardware.gralloc": "mediatek",
    "ro.hardware.vulkan": "mt6768",
    "ro.sf.lcd_density": "240",
}
GPU_KEYS = ("ro.hardware.egl", "ro.hardware.gralloc", "ro.hardware.vulkan", "ro.hardware.hwcomposer",
            "ro.sf.lcd_density")


def properties():
    props = dict(PROPERTIES)
    zone = os.path.realpath(LOCALTIME).partition("/zoneinfo/")[2]
    if re.fullmatch(r"[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)*", zone):
        props["persist.sys.timezone"] = zone
    return props


class Refused(Exception):
    def __init__(self, kind, reason):
        super().__init__(reason)
        self.kind = kind
        self.reason = reason


def log(msg):
    print(f"{ME}: {msg}", flush=True)


def put(path, text, mode=0o644):
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write(text)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def state(line):
    os.makedirs(RUN, 0o755, exist_ok=True)
    put(os.path.join(RUN, "state"), line + "\n")


def read(path):
    try:
        with open(path) as f:
            return f.read()
    except FileNotFoundError:
        return None


def running():
    text = read(os.path.join(PAYLOAD, "cgroup.events")) or ""
    return "populated 1" in text.splitlines()


def sha256(data):
    return hashlib.sha256(data.encode()).hexdigest()


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()


def pin():
    rows = []
    with open(PIN) as f:
        for line in f:
            fields = line.split()
            if not fields:
                continue
            if len(fields) not in (4, 5) or "-" in fields:
                raise Refused("failed", "pin incomplete")
            name, _url, sha, size = fields[:4]
            if not (re.fullmatch(r"[a-z]+\.img", name) and re.fullmatch(r"[0-9a-f]{64}", sha) and size.isdigit()
                    and all(re.fullmatch(r"[0-9a-f]{64}", z) for z in fields[4:])):
                raise Refused("failed", f"pin line for {name} is malformed")
            rows.append((name, sha, int(size)))
    if sorted(r[0] for r in rows) != ["system.img", "vendor.img"]:
        raise Refused("failed", "pin incomplete")
    return rows


def images(rows):
    for name, _sha, size in rows:
        try:
            have = os.stat(os.path.join(IMAGES, name)).st_size
        except FileNotFoundError:
            raise Refused("missing", f"no images/{name}")
        if have != size:
            raise Refused("failed", f"images/{name} is {have} bytes, the pin says {size}")
    want = "".join(sorted(f"{name} {size} {sha}\n" for name, sha, size in rows))
    have = read(os.path.join(IMAGES, "stamp"))
    if have is None:
        raise Refused("failed", "no image stamp")
    if have != want:
        raise Refused("failed", "the image stamp does not match the pin")
    return want


def gpu_pin():
    text = read(GPU_PIN)
    if text is None:
        return None
    spec = {"files": [], "links": [], "whiteouts": [], "rc": None, "shim": None, "digest": None}
    for line in text.splitlines():
        fields = line.split()
        if not fields:
            continue
        kind = fields[0]
        if kind == "f" and len(fields) >= 2:
            spec["files"].append((fields[1], fields[2] if len(fields) > 2 else "0644"))
        elif kind == "l" and len(fields) >= 3:
            spec["links"].append((fields[1], fields[2]))
        elif kind == "w" and len(fields) >= 2:
            spec["whiteouts"].append(fields[1])
        elif kind == "rc" and len(fields) >= 3:
            spec["rc"] = (fields[1], fields[2])
        elif kind == "shim" and len(fields) >= 2 and re.fullmatch(r"[0-9a-f]{64}", fields[1]):
            spec["shim"] = fields[1]
        elif kind == "digest" and len(fields) >= 2 and re.fullmatch(r"[0-9a-f]{64}", fields[1]):
            spec["digest"] = fields[1]
    return spec


def gpu_vendor_digest(spec):
    lines = []
    missing = []
    for path, mode in spec["files"]:
        full = os.path.join(VENDOR, path)
        if os.path.islink(full) or not os.path.isfile(full):
            missing.append(path)
            continue
        lines.append(f"f {path} {mode} {sha256_file(full)}")
    for path, target in spec["links"]:
        full = os.path.join(VENDOR, path)
        if not os.path.islink(full) or os.readlink(full) != target:
            missing.append(path)
            continue
        lines.append(f"l {path} - {target}")
    for path in spec["whiteouts"]:
        lines.append(f"w {path} 0644 -")
    if spec["rc"]:
        src = os.path.join(VENDOR, spec["rc"][1])
        if os.path.islink(src) or not os.path.isfile(src):
            missing.append(spec["rc"][1])
        else:
            lines.append(f"rc {spec['rc'][1]} 0644 {sha256_file(src)}")
    if missing:
        return None, missing
    lines.sort()
    return sha256("".join(line + "\n" for line in lines)), []


def gpu_digest(spec):
    bid = (read(BOOT_ID) or "").strip()
    cached = read(GPU_DIGEST)
    if cached and bid:
        cbid, _, cdig = cached.strip().partition(" ")
        if cbid == bid and re.fullmatch(r"[0-9a-f]{64}", cdig or ""):
            return cdig, []
    digest, missing = gpu_vendor_digest(spec)
    if digest is not None:
        os.makedirs(RUN, 0o755, exist_ok=True)
        put(GPU_DIGEST, f"{bid} {digest}\n")
    return digest, missing


def kbase_armed():
    value = read(KBASE_ARMED)
    return bool(value) and value.split()[:1] == ["1"]


def gpu_shim(spec):
    if not spec["shim"]:
        return None
    if os.path.islink(HWC_SHIM) or not os.path.isfile(HWC_SHIM):
        return None
    if sha256_file(HWC_SHIM) != spec["shim"]:
        return None
    return spec["shim"]


def gpu_decide(spec):
    if spec is None or not spec["digest"]:
        return "soft", None, None, "no gpu set"
    digest, missing = gpu_digest(spec)
    if missing:
        return "soft", None, None, "no gpu set"
    if digest != spec["digest"]:
        return "soft", None, None, "gpu set changed"
    if not kbase_armed():
        return "soft", None, None, "kbase hook not armed"
    return "mali", digest, gpu_shim(spec), None


def gpu_line(mode, digest, shim):
    if mode != "mali":
        return "gpu soft"
    return f"gpu {digest} shim {shim}" if shim else f"gpu {digest}"


def gpu_servicerc(source):
    text = read(os.path.join(VENDOR, source))
    if text is None:
        return None
    block = []
    started = False
    for line in text.splitlines():
        if not started:
            if line.startswith("service vendor.gralloc-4-0 "):
                started = True
                block.append(line)
            continue
        if re.match(r"[ \t]+[^ \t]", line):
            if line.split()[0] != "disabled":
                block.append(line)
            continue
        break
    body = "\n".join(block)
    svc = "bin/hw/android.hardware.graphics.allocator@4.0-service-mediatek"
    iface = "interface android.hardware.graphics.allocator@4.0::IAllocator default"
    if not body.startswith(f"service vendor.gralloc-4-0 /vendor/{svc}") or iface not in body:
        return None
    out = body + "\n    disabled\n\n"
    out += "on early-init && property:ro.hardware.gralloc=mediatek\n"
    out += ("    mount none /vendor/etc/vintf/manifest.disabled/gbm_mesa.allocator@4.0.xml "
            "/vendor/etc/vintf/manifest/gbm_mesa.allocator@4.0.xml ro bind\n")
    out += ("    mount none /vendor/etc/vintf/manifest.disabled/gbm_mesa.mapper@4.0.xml "
            "/vendor/etc/vintf/manifest/gbm_mesa.mapper@4.0.xml ro bind\n")
    out += ("    mount none /vendor/etc/vintf/manifest.disabled/empty_vintf.xml "
            "/vendor/etc/vintf/manifest/gralloc1.xml ro bind\n")
    out += "    stop vendor.gralloc-2-0\n    enable vendor.gralloc-4-0\n"
    return out


def gpu_staged_add(path):
    with open(GPU_STAGED, "a") as f:
        f.write(path + "\n")


def gpu_parents(rel):
    parent = os.path.dirname(rel)
    acc = ""
    for part in parent.split("/") if parent else []:
        acc = f"{acc}/{part}" if acc else part
        full = os.path.join(OVERLAY, acc)
        if not os.path.isdir(full):
            gpu_staged_add(acc)
            os.mkdir(full, 0o755)


def gpu_unstage():
    text = read(GPU_STAGED)
    if text is None:
        return
    for path in reversed(text.splitlines()):
        full = os.path.join(OVERLAY, path)
        try:
            if os.path.isdir(full) and not os.path.islink(full):
                os.rmdir(full)
            else:
                os.remove(full)
        except (FileNotFoundError, OSError):
            pass
    try:
        os.remove(GPU_STAGED)
    except FileNotFoundError:
        pass


def gpu_stage(spec, shim):
    gpu_unstage()
    os.makedirs(OVERLAY, 0o755, exist_ok=True)
    put(GPU_STAGED, "")
    try:
        for path, mode in spec["files"]:
            gpu_parents(path)
            gpu_staged_add(path)
            dest = os.path.join(OVERLAY, path)
            shutil.copyfile(os.path.join(VENDOR, path), dest)
            os.chmod(dest, int(mode, 8))
        for path, target in spec["links"]:
            gpu_parents(path)
            gpu_staged_add(path)
            os.symlink(target, os.path.join(OVERLAY, path))
        for path in spec["whiteouts"]:
            gpu_parents(path)
            gpu_staged_add(path)
            if subprocess.run(["mknod", "-m", "0644", os.path.join(OVERLAY, path), "c", "0", "0"]).returncode != 0:
                return False
        if spec["rc"]:
            dest, source = spec["rc"]
            text = gpu_servicerc(source)
            if text is None:
                return False
            gpu_parents(dest)
            gpu_staged_add(dest)
            put(os.path.join(OVERLAY, dest), text)
        if shim:
            gpu_parents(SHIMPATH)
            gpu_staged_add(SHIMPATH)
            dest = os.path.join(OVERLAY, SHIMPATH)
            shutil.copyfile(HWC_SHIM, dest)
            os.chmod(dest, 0o644)
    except OSError:
        return False
    return True


def config(gpu_action):
    cfg = configparser.ConfigParser()
    old = read(CFG)
    if old is not None:
        cfg.read_string(old)
    for section in ("waydroid", "properties"):
        if section not in cfg:
            cfg[section] = {}
    cfg["waydroid"].update(PINNED)
    cfg["properties"].update(properties())
    if gpu_action == "mali":
        cfg["properties"].update(GPU_PROPS)
    elif gpu_action == "soft":
        for key in GPU_KEYS:
            cfg.remove_option("properties", key)
    out = io.StringIO()
    cfg.write(out)
    if out.getvalue() != old:
        os.makedirs(WORK, 0o755, exist_ok=True)
        put(CFG, out.getvalue())
        log(f"wrote {CFG}")


def version():
    r = subprocess.run(["rpm", "-q", "--qf", "%{VERSION}-%{RELEASE}", "waydroid"], capture_output=True, text=True)
    if r.returncode != 0:
        raise Refused("failed", "waydroid is not installed")
    return r.stdout.strip()


def waydroid(*argv):
    log("running waydroid " + " ".join(argv))
    try:
        r = subprocess.run(["waydroid", "--details-to-stdout", *argv], stdin=subprocess.DEVNULL, timeout=90)
    except subprocess.TimeoutExpired:
        raise Refused("failed", f"waydroid {argv[0]} ran past 90 s")
    if r.returncode != 0:
        raise Refused("failed", f"waydroid {argv[0]} exited {r.returncode}")


def keylayout():
    d = os.path.join(WORK, "overlay", "system", "usr", "keylayout")
    os.makedirs(d, 0o755, exist_ok=True)
    os.makedirs(os.path.join(WORK, "overlay", "vendor"), 0o755, exist_ok=True)
    dest = os.path.join(d, os.path.basename(KL))
    text = read(KL)
    if text is None:
        raise Refused("failed", f"no {KL}")
    if read(dest) != text:
        put(dest, text)
        log(f"wrote {dest}")


def prep():
    if subprocess.run(["mountpoint", "-q", DATA]).returncode != 0:
        raise Refused("missing", f"{DATA} is not mounted")
    rows = pin()
    stamp = images(rows)
    base = read(BASE)
    if base is None:
        raise Refused("failed", f"no {BASE}")
    props = "".join(f"{k}={v}\n" for k, v in sorted(properties().items()))
    spec = gpu_pin()
    is_running = running()
    mode, digest, shim, reason = gpu_decide(spec)
    want = (f"waydroid {version()}\nconfig_base {sha256(base)}\nproperties {sha256(props)}\n"
            f"images {sha256(stamp)}\n{gpu_line(mode, digest, shim)}\n")
    initialized = os.path.isdir(os.path.join(WORK, "rootfs"))
    action = None
    if not initialized:
        action = "init"
    elif read(PREPARED) != want:
        action = "upgrade"
    prepared = read(PREPARED)
    gpu_only = (prepared is not None and action == "upgrade"
                and [ln for ln in want.splitlines() if not ln.startswith("gpu ")]
                == [ln for ln in prepared.splitlines() if not ln.startswith("gpu ")])
    if action and is_running:
        if gpu_only:
            config(None)
            keylayout()
            log("gpu change waits for stop")
            state("ok")
            log("ok")
            return 0
        raise Refused("failed", "change pending, stop Android")
    if mode == "mali" and action:
        if not gpu_stage(spec, shim):
            gpu_unstage()
            mode, digest, shim, reason = "soft", None, None, "gpu stage failed"
            want = (f"waydroid {version()}\nconfig_base {sha256(base)}\nproperties {sha256(props)}\n"
                    f"images {sha256(stamp)}\n{gpu_line(mode, digest, shim)}\n")
    if reason:
        log(f"{reason}, soft for this start")
    os.makedirs(RUN, 0o755, exist_ok=True)
    put(GPU_MODE, mode + "\n")
    config("mali" if mode == "mali" else "soft")
    if action == "init":
        waydroid("init")
    elif action == "upgrade":
        waydroid("upgrade", "--offline")
    if action:
        cfg = configparser.ConfigParser()
        cfg.read_string(read(CFG) or "")
        if cfg.get("waydroid", "images_path", fallback=None) != EXTRA:
            raise Refused("failed", f"waydroid {action} did not take the images in {EXTRA}")
        config("mali" if mode == "mali" else "soft")
        put(PREPARED, want)
        log(f"waydroid {action} done")
    keylayout()
    state("ok")
    log("ok")
    old = os.path.join(ANDROID, "images.old")
    if os.path.isdir(old) and not running():
        try:
            shutil.rmtree(old)
            log(f"removed {old}")
        except OSError as e:
            log(f"cannot remove {old}: {e}")
    return 0


def main():
    if sys.argv[1:2] == ["gpu-digest"]:
        spec = gpu_pin()
        if spec is None:
            print("no gpu pin", file=sys.stderr)
            return 1
        digest, missing = gpu_vendor_digest(spec)
        if digest is None:
            print("missing: " + " ".join(missing), file=sys.stderr)
            return 1
        print(digest)
        return 0
    try:
        return prep()
    except Refused as e:
        state(f"{e.kind} {e.reason}")
        log(e.reason)
        return 1
    except OSError as e:
        state(f"failed {e.strerror or e}")
        log(str(e))
        return 1


if __name__ == "__main__":
    sys.exit(main())
