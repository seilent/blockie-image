#!/usr/bin/env python3
import glob
import json
import os
import pwd
import re
import sys
import tempfile

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

ME = "blockie-setd"
NAME = "net.seilent.Blockie.Settings"
PATH = "/net/seilent/Blockie/Settings"
IFACE = "net.seilent.Blockie.Settings1"
ERR = "net.seilent.Blockie.Settings.Error"
SCHEMAS = os.environ.get("BLOCKIE_SETD_SCHEMAS", "/usr/share/blockie/schema.d")
STORE = os.environ.get("BLOCKIE_SETD_STORE", "/var/lib/blockie/settings/settings.json")
SESSIONS = os.environ.get("BLOCKIE_SETD_SESSIONS", "/etc/blockie/sessions.d:/usr/lib/blockie/sessions.d").split(":")
BUS = os.environ.get("BLOCKIE_SETD_BUS", "system")
WRITERS = os.environ.get("BLOCKIE_SETD_WRITERS", "root blockie").split()
LOCALTIME = os.environ.get("BLOCKIE_SETD_LOCALTIME", "/etc/localtime")
ZONETAB = os.environ.get("BLOCKIE_SETD_ZONETAB", "/usr/share/zoneinfo/zone.tab")
TIMEDATE_MS = int(os.environ.get("BLOCKIE_SETD_TIMEDATE_MS", "4000"))
EFFECTIVE = os.environ.get("BLOCKIE_SETD_EFFECTIVE", "/run/blockie-set")
BUTTONS = ("home", "extra1", "extra2", "extra3")
TIMEDATE = "org.freedesktop.timedate1"
TIMEDATE_PATH = "/org/freedesktop/timedate1"
ZONEINFO = ("../usr/share/zoneinfo/", "/usr/share/zoneinfo/")
TYPES = {"s": str, "b": bool, "i": int, "u": int, "d": float}
RANGES = {"i": (-2**31, 2**31 - 1), "u": (0, 2**32 - 1)}
SESSION_NAME = re.compile(r"[a-z0-9][a-z0-9-]*")
XML = f"""
<node>
  <interface name="{IFACE}">
    <method name="Get">
      <arg name="key" type="s" direction="in"/>
      <arg name="value" type="v" direction="out"/>
    </method>
    <method name="Set">
      <arg name="key" type="s" direction="in"/>
      <arg name="value" type="v" direction="in"/>
    </method>
    <method name="SetMany">
      <arg name="values" type="a{{sv}}" direction="in"/>
    </method>
    <method name="Reset">
      <arg name="keys" type="as" direction="in"/>
    </method>
    <method name="List">
      <arg name="prefix" type="s" direction="in"/>
      <arg name="values" type="a{{sv}}" direction="out"/>
    </method>
    <method name="Schema">
      <arg name="prefix" type="s" direction="in"/>
      <arg name="json" type="s" direction="out"/>
    </method>
    <signal name="Changed">
      <arg name="key" type="s"/>
      <arg name="value" type="v"/>
    </signal>
  </interface>
</node>
"""


def log(msg):
    print(f"{ME}: {msg}", file=sys.stderr, flush=True)


class Refused(Exception):
    def __init__(self, kind, msg):
        super().__init__(msg)
        self.kind = kind


def default_sessions():
    found = {}
    for d in SESSIONS:
        for path in sorted(glob.glob(os.path.join(glob.escape(d), "*.conf"))):
            name = os.path.basename(path)[:-5]
            if name in found or not SESSION_NAME.fullmatch(name):
                continue
            found[name] = False
            try:
                with open(path) as f:
                    for line in f:
                        k, _, v = line.strip().partition("=")
                        if k.strip() == "DEFAULT" and v.strip().strip("\"'") == "yes":
                            found[name] = True
            except OSError as err:
                log(f"cannot read {path}: {err}")
    return sorted(n for n, ok in found.items() if ok)


def zones():
    found = {"UTC"}
    try:
        with open(ZONETAB) as f:
            for line in f:
                fields = line.split("\t")
                name = fields[2].strip() if len(fields) >= 3 else ""
                if name and not line.startswith("#"):
                    found.add(name)
    except OSError as err:
        log(f"cannot read {ZONETAB}: {err}")
    return found


def read_zone():
    try:
        target = os.readlink(LOCALTIME)
    except FileNotFoundError:
        return "UTC"
    except OSError:
        return ""
    for prefix in ZONEINFO:
        if target.startswith(prefix):
            return target[len(prefix):]
    return ""


def show(value):
    if isinstance(value, bool):
        return "true" if value else "false"
    return str(value)


def schema_files():
    return sorted(glob.glob(os.path.join(glob.escape(SCHEMAS), "*.json")))


def load_schema():
    keys = {}
    for path in schema_files():
        try:
            with open(path) as f:
                data = json.load(f)
        except (OSError, ValueError) as err:
            log(f"cannot load {path}: {err}")
            continue
        for key, spec in data.get("keys", {}).items():
            if key in keys:
                log(f"{path}: {key} is defined twice, the first one stays")
                continue
            if not isinstance(spec, dict) or spec.get("type") not in TYPES:
                log(f"{path}: {key} has no valid type, ignored")
                continue
            if "backend" in spec and (spec["backend"] != "timedate1" or spec["type"] != "s"
                                      or spec.get("enum_from") != "zones"
                                      or any("backend" in s for s in keys.values())):
                log(f"{path}: {key} is not the one timedate1 key of type s with enum_from zones, ignored")
                continue
            if not isinstance(spec.get("map", False), bool) or (spec.get("map") and spec["type"] == "s" and not all(
                    isinstance(v, str) and v and not any(c.isspace() for c in v) for v in spec.get("enum", [""]))):
                log(f"{path}: {key}: map takes true or false, a mapped s key needs an enum of words, ignored")
                continue
            try:
                spec["default"] = check(key, spec, spec.get("default"), defaults=True)
            except Refused as err:
                log(f"{path}: {key}: default refused: {err}")
                continue
            keys[key] = spec
    return keys


def holds(rule, values):
    return any(values[k] in rule["need"] for k in rule["keys"])


def load_rules(keys):
    rules = []
    for path in schema_files():
        try:
            with open(path) as f:
                data = json.load(f)
        except (OSError, ValueError):
            continue
        for n, rule in enumerate(data.get("rules", []), 1):
            if not (isinstance(rule, dict) and isinstance(rule.get("message"), str)
                    and all(isinstance(rule.get(f), list) and rule[f] for f in ("need", "keys"))
                    and all(isinstance(k, str) for k in rule["keys"])):
                log(f"{path}: rule {n} is not need, keys and message, dropped")
                continue
            unknown = [k for k in rule["keys"] if k not in keys or "backend" in keys[k]]
            if unknown:
                log(f"{path}: rule {n} names unknown key {', '.join(unknown)}, dropped")
                continue
            if not holds(rule, {k: keys[k]["default"] for k in rule["keys"]}):
                log(f"{path}: rule {n}: the defaults break it ({rule['message']}), dropped")
                continue
            rules.append({f: rule[f] for f in ("need", "keys", "message")})
    return rules


def write_map(name, lines):
    fd, tmp = tempfile.mkstemp(prefix=f".{name}.", dir=EFFECTIVE)
    try:
        with os.fdopen(fd, "w") as f:
            f.write("\n".join(lines) + "\n")
        os.chmod(tmp, 0o644)
        os.replace(tmp, os.path.join(EFFECTIVE, name))
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def check(key, spec, value, defaults=False):
    t = spec["type"]
    if t in ("i", "u") and isinstance(value, bool):
        raise Refused("Invalid", f"{key} takes {t}, not a boolean")
    if t == "d" and isinstance(value, int) and not isinstance(value, bool):
        value = float(value)
    if not isinstance(value, TYPES[t]):
        raise Refused("Invalid", f"{key} takes {t}")
    if t in RANGES and not RANGES[t][0] <= value <= RANGES[t][1]:
        raise Refused("Invalid", f"{key} takes {t}, {value} is out of its range")
    if t in ("i", "u", "d"):
        if "min" in spec and value < spec["min"]:
            raise Refused("Invalid", f"{key} is at least {spec['min']}")
        if "max" in spec and value > spec["max"]:
            raise Refused("Invalid", f"{key} is at most {spec['max']}")
    if "enum" in spec and value not in spec["enum"]:
        raise Refused("Invalid", f"{key} is one of {', '.join(map(str, spec['enum']))}")
    if spec.get("enum_from") == "sessions" and not defaults:
        allowed = default_sessions()
        if value not in allowed:
            raise Refused("Invalid", f"{key} is one of the default sessions: {', '.join(allowed) or 'none'}")
    if spec.get("enum_from") == "zones" and not defaults and value not in zones():
        raise Refused("Invalid", f"{value} is not a zone.tab zone")
    return value


class Store:
    def __init__(self, keys, rules=()):
        self.keys = keys
        self.rules = list(rules)
        self.values = {}
        try:
            with open(STORE) as f:
                data = json.load(f)
        except FileNotFoundError:
            data = {}
        except (OSError, ValueError) as err:
            log(f"cannot load {STORE}: {err}, starting from the defaults")
            data = {}
        if not isinstance(data, dict):
            data = {}
        for key, value in data.items():
            spec = keys.get(key)
            if spec is None:
                log(f"{STORE}: {key} is not in the schema, dropped")
                continue
            if "backend" in spec:
                log(f"{STORE}: {key} is kept by {spec['backend']}, dropped")
                continue
            try:
                self.values[key] = check(key, spec, value)
            except Refused as err:
                log(f"{STORE}: {key}: {err}, the default applies")
        dropped = True
        while dropped:
            dropped = False
            for rule in self.rules:
                if holds(rule, self.effective(self.values)):
                    continue
                stored = [k for k in rule["keys"] if k in self.values]
                log(f"{STORE}: {rule['message']}: {', '.join(stored) or 'nothing stored'}, the defaults apply")
                for k in stored:
                    del self.values[k]
                dropped = dropped or bool(stored)

    def effective(self, values):
        return {k: values.get(k, s["default"]) for k, s in self.keys.items() if "backend" not in s}

    def broken(self, values, touched):
        now = self.effective(values)
        for rule in self.rules:
            if touched & set(rule["keys"]) and not holds(rule, now):
                raise Refused("Invalid", rule["message"])

    def writable(self, key):
        spec = self.keys.get(key)
        if spec is None:
            raise Refused("UnknownKey", f"no key {key}")
        if spec.get("writable", True) is False:
            raise Refused("ReadOnly", f"{key} is read only")
        if "backend" in spec:
            raise Refused("ReadOnly", f"{key} takes only Set")
        return spec

    def get(self, key):
        spec = self.keys.get(key)
        if spec is None:
            raise Refused("UnknownKey", f"no key {key}")
        if spec.get("backend") == "timedate1":
            return read_zone()
        return self.values.get(key, spec["default"])

    def set(self, key, value):
        spec = self.keys.get(key)
        if spec is None:
            raise Refused("UnknownKey", f"no key {key}")
        if spec.get("writable", True) is False:
            raise Refused("ReadOnly", f"{key} is read only")
        value = check(key, spec, value)
        if self.get(key) == value and key in self.values:
            return False
        values = dict(self.values)
        values[key] = value
        self.broken(values, {key})
        self.save(values)
        self.values = values
        return True

    def set_many(self, items):
        values = dict(self.values)
        for key, value in items.items():
            values[key] = check(key, self.writable(key), value)
        return self.commit(values, set(items))

    def reset(self, keys):
        values = dict(self.values)
        for key in keys:
            self.writable(key)
            values.pop(key, None)
        return self.commit(values, set(keys))

    def commit(self, values, touched):
        self.broken(values, touched)
        before = self.effective(self.values)
        if values != self.values:
            self.save(values)
            self.values = values
        after = self.effective(values)
        return sorted(k for k in touched if before[k] != after[k])

    def publish(self):
        now = self.effective(self.values)
        write_map("settings", ["version 1"] + [f"{k} {show(now[k])}" for k in sorted(now) if self.keys[k].get("map")])
        names = [f"buttons.{b}.{g}" for b in BUTTONS for g in ("tap", "hold")]
        if not all(k in now for k in names):
            try:
                os.unlink(os.path.join(EFFECTIVE, "buttons"))
            except FileNotFoundError:
                pass
            return
        lines = ["version 1"]
        for b in BUTTONS:
            tap, hold = now[f"buttons.{b}.tap"], now[f"buttons.{b}.hold"]
            lines += [f"{b} tap {tap}", f"{b} hold {hold}", f"{b} free {'yes' if tap == hold == 'none' else 'no'}"]
        write_map("buttons", lines)

    def save(self, values):
        d = os.path.dirname(STORE)
        fd, tmp = tempfile.mkstemp(prefix=".settings.", dir=d)
        try:
            with os.fdopen(fd, "w") as f:
                json.dump(values, f, indent=1, sort_keys=True)
                f.write("\n")
                f.flush()
                os.fsync(f.fileno())
            os.chmod(tmp, 0o644)
            os.replace(tmp, STORE)
            dfd = os.open(d, os.O_RDONLY | os.O_DIRECTORY)
            try:
                os.fsync(dfd)
            finally:
                os.close(dfd)
        except BaseException:
            try:
                os.unlink(tmp)
            except OSError:
                pass
            raise


class Timezone:
    def __init__(self, bus, key):
        self.bus = bus
        self.key = key
        self.pending = False
        self.inv = None
        self.timer = 0
        self.settle_id = 0
        self.monitor = Gio.File.new_for_path(LOCALTIME).monitor_file(Gio.FileMonitorFlags.WATCH_MOVES, None)
        self.monitor.connect("changed", self.event)
        self.last_sent = read_zone()

    def event(self, monitor, file, other, kind):
        if self.settle_id:
            GLib.source_remove(self.settle_id)
        self.settle_id = GLib.timeout_add(100, self.settle)

    def settle(self):
        self.settle_id = 0
        self.sync()
        return GLib.SOURCE_REMOVE

    def sync(self):
        zone = read_zone()
        if zone != self.last_sent:
            self.last_sent = zone
            self.bus.emit_signal(None, PATH, IFACE, "Changed",
                                 GLib.Variant("(sv)", (self.key, GLib.Variant("s", zone))))

    def set(self, spec, value, inv, uid):
        if self.pending:
            raise Refused("Busy", f"{self.key} is busy, a SetTimezone is pending")
        check(self.key, spec, value)
        if read_zone() == value:
            inv.return_value(None)
            return
        self.pending = True
        self.inv = inv
        self.want = value
        self.uid = uid
        self.resynced = False
        self.deadline = GLib.get_monotonic_time() + 2 * TIMEDATE_MS * 1000
        self.timer = GLib.timeout_add(TIMEDATE_MS, self.late)
        try:
            self.request(value, self.applied)
        except Exception as err:
            log(f"SetTimezone {value} failed: {err!r}")
            self.finish("Failed", "SetTimezone failed")

    def late(self):
        self.timer = 0
        log(f"SetTimezone {self.want}: no answer in {TIMEDATE_MS} ms")
        self.answer("Timeout", f"timedated did not answer in {TIMEDATE_MS} ms")
        return GLib.SOURCE_REMOVE

    def request(self, zone, then):
        left = (self.deadline - GLib.get_monotonic_time()) // 1000
        if left <= 0:
            self.finish("Timeout", f"timedated did not answer in {TIMEDATE_MS} ms")
            return
        self.bus.call(TIMEDATE, TIMEDATE_PATH, TIMEDATE, "SetTimezone", GLib.Variant("(sb)", (zone, False)), None,
                      Gio.DBusCallFlags.NONE, left, None, self.reply, (zone, then))

    def reply(self, conn, res, data):
        zone, then = data
        try:
            conn.call_finish(res)
        except GLib.Error as err:
            if err.matches(Gio.io_error_quark(), Gio.IOErrorEnum.TIMED_OUT):
                log(f"SetTimezone {zone}: no answer")
                self.finish("Timeout", f"timedated did not answer in {TIMEDATE_MS} ms")
            else:
                name = Gio.dbus_error_get_remote_error(err) or err.message
                log(f"SetTimezone {zone}: {name}")
                self.finish("Failed", f"SetTimezone {zone}: {name}")
            self.sync()
            return
        try:
            self.sync()
            then()
        except Exception as err:
            log(f"SetTimezone {zone} failed: {err!r}")
            self.finish("Failed", "SetTimezone failed")

    def applied(self):
        zone = read_zone()
        if zone == self.want:
            log(f"{self.key} set by uid {self.uid}")
            self.finish()
        elif not self.resynced:
            self.resynced = True
            bounce = zone or ("UTC" if self.want != "UTC" else "")
            if not bounce:
                log(f"{self.key}: link is not a zoneinfo link after SetTimezone {self.want}")
                self.finish("Failed", "link is not a zoneinfo link after SetTimezone")
                return
            self.request(bounce, lambda: self.request(self.want, self.applied))
        else:
            log(f"{self.key}: link is {zone} after SetTimezone {self.want}")
            self.finish("Failed", f"link is {zone} after SetTimezone")

    def answer(self, kind=None, msg=None):
        if self.inv is None:
            return
        if kind:
            self.inv.return_dbus_error(f"{ERR}.{kind}", msg)
        else:
            self.inv.return_value(None)
        self.inv = None

    def finish(self, kind=None, msg=None):
        if self.timer:
            GLib.source_remove(self.timer)
            self.timer = 0
        self.pending = False
        self.answer(kind, msg)


def try_publish(store):
    try:
        store.publish()
    except OSError as err:
        log(f"cannot write the map in {EFFECTIVE}: {err}")


class Service:
    def __init__(self, bus, store):
        self.bus = bus
        self.store = store
        self.writers = set()
        for name in WRITERS:
            try:
                self.writers.add(pwd.getpwnam(name).pw_uid)
            except KeyError:
                log(f"writer {name} is not a user, skipped")
        self.backends = {k: Timezone(bus, k) for k, s in store.keys.items() if s.get("backend") == "timedate1"}
        info = Gio.DBusNodeInfo.new_for_xml(XML).interfaces[0]
        bus.register_object(PATH, info, self.call, None, None)

    def caller_uid(self, sender):
        r = self.bus.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
                               "GetConnectionUnixUser", GLib.Variant("(s)", (sender,)), GLib.VariantType("(u)"),
                               Gio.DBusCallFlags.NONE, -1, None)
        return r.unpack()[0]

    def writer(self, sender, what):
        uid = self.caller_uid(sender)
        if uid not in self.writers:
            raise Refused("Denied", f"uid {uid} may not set {what}")
        return uid

    def changed(self, keys, touched=None):
        for key in keys:
            spec = self.store.keys[key]
            self.bus.emit_signal(None, PATH, IFACE, "Changed",
                                 GLib.Variant("(sv)", (key, GLib.Variant(spec["type"], self.store.get(key)))))
        if any(self.store.keys[k].get("map") for k in (keys if touched is None else touched)):
            try_publish(self.store)

    def call(self, conn, sender, path, iface, method, params, inv):
        try:
            if method == "Get":
                (key,) = params.unpack()
                value = self.store.get(key)
                inv.return_value(GLib.Variant("(v)", (GLib.Variant(self.store.keys[key]["type"], value),)))
            elif method == "List":
                (prefix,) = params.unpack()
                out = {k: GLib.Variant(s["type"], self.store.get(k)) for k, s in sorted(self.store.keys.items())
                       if k.startswith(prefix)}
                inv.return_value(GLib.Variant("(a{sv})", (out,)))
            elif method == "Schema":
                (prefix,) = params.unpack()
                out = {k: s for k, s in sorted(self.store.keys.items()) if k.startswith(prefix)}
                rules = [r for r in self.store.rules if all(k.startswith(prefix) for k in r["keys"])]
                inv.return_value(GLib.Variant("(s)", (json.dumps({"keys": out, "rules": rules}, sort_keys=True),)))
            elif method == "Set":
                key, value = params.unpack()
                uid = self.writer(sender, key)
                got = params.get_child_value(1).get_variant().get_type_string()
                spec = self.store.keys.get(key)
                if spec is not None and got != spec["type"]:
                    raise Refused("Invalid", f"{key} takes {spec['type']}, not {got}")
                if key in self.backends:
                    if spec.get("writable", True) is False:
                        raise Refused("ReadOnly", f"{key} is read only")
                    self.backends[key].set(spec, value, inv, uid)
                    return
                if self.store.set(key, value):
                    log(f"{key} set by uid {uid}")
                    self.changed([key])
                inv.return_value(None)
            elif method == "SetMany":
                (items,) = params.unpack()
                uid = self.writer(sender, ", ".join(sorted(items)) or "nothing")
                entries = params.get_child_value(0)
                for i in range(entries.n_children()):
                    entry = entries.get_child_value(i)
                    key = entry.get_child_value(0).get_string()
                    got = entry.get_child_value(1).get_variant().get_type_string()
                    spec = self.store.keys.get(key)
                    if spec is not None and got != spec["type"]:
                        raise Refused("Invalid", f"{key} takes {spec['type']}, not {got}")
                changed = self.store.set_many(items)
                log(f"{', '.join(sorted(items)) or 'nothing'} set by uid {uid}")
                self.changed(changed, items)
                inv.return_value(None)
            elif method == "Reset":
                (names,) = params.unpack()
                uid = self.writer(sender, ", ".join(names) or "nothing")
                changed = self.store.reset(names)
                log(f"{', '.join(names) or 'nothing'} reset by uid {uid}")
                self.changed(changed, names)
                inv.return_value(None)
            else:
                inv.return_dbus_error(f"{ERR}.UnknownMethod", method)
        except Refused as err:
            inv.return_dbus_error(f"{ERR}.{err.kind}", str(err))
        except OSError as err:
            log(f"store write failed: {err}")
            inv.return_dbus_error(f"{ERR}.Failed", f"store write failed: {err.strerror}")
        except Exception as err:
            log(f"{method} failed: {err!r}")
            inv.return_dbus_error(f"{ERR}.Failed", f"{method} failed")


def main():
    keys = load_schema()
    store = Store(keys, load_rules(keys))
    try_publish(store)
    loop = GLib.MainLoop()
    if BUS == "system":
        bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
    elif BUS == "session":
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    else:
        bus = Gio.DBusConnection.new_for_address_sync(
            BUS, Gio.DBusConnectionFlags.AUTHENTICATION_CLIENT | Gio.DBusConnectionFlags.MESSAGE_BUS_CONNECTION,
            None, None)
    Service(bus, store)
    failed = []

    def lost(conn, name):
        log(f"lost or could not own {name}")
        failed.append(name)
        loop.quit()

    Gio.bus_own_name_on_connection(bus, NAME, Gio.BusNameOwnerFlags.NONE, None, lost)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, 15, loop.quit)
    log(f"{len(keys)} keys and {len(store.rules)} rules from {SCHEMAS}, store {STORE}, map {EFFECTIVE}")
    loop.run()
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
