#!/usr/bin/env python3
import glob
import os
import re
import sys

import evdev
import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

ME = "blockie-hotkeyd"
TABLES = os.environ.get("BLOCKIE_HOTKEYD_TABLES", "/usr/lib/blockie/hotkeys.d:/etc/blockie/hotkeys.d").split(":")
HOOKS = os.environ.get("BLOCKIE_HOTKEYD_HOOKS", "/etc/blockie/hooks.d:/usr/lib/blockie/hooks.d").split(":")
CURRENT = os.environ.get("BLOCKIE_HOTKEYD_CURRENT", "/run/blockie-session/session-current")
INPUT = os.environ.get("BLOCKIE_HOTKEYD_INPUT")
DRY = os.environ.get("BLOCKIE_HOTKEYD_DRY") == "1"
SYSFS = os.environ.get("BLOCKIE_HOTKEYD_SYSFS", "/sys")
LONG_MS = int(os.environ.get("BLOCKIE_HOTKEYD_LONG_MS", "1000"))
HOOK_MS = int(os.environ.get("BLOCKIE_HOTKEYD_HOOK_MS", "5000"))
BACKSTOP_MS = int(os.environ.get("BLOCKIE_HOTKEYD_BACKSTOP_MS", "20000"))
HOLD_MAX_MS = 60000
REPEAT_DELAY_MS = 400
REPEAT_MS = 100
RESCAN_S = 2
SWITCHER = ("net.seilent.Blockie.Switcher", "/net/seilent/Blockie/Switcher", "net.seilent.Blockie.Switcher1", "Toggle")
KEY_POWER, KEY_VOLUMEDOWN, KEY_VOLUMEUP, BTN_MODE = 116, 114, 115, 316
BTN_JOYSTICK, BTN_THUMBR, BTN_TOUCH, ABS_MT_POSITION_X = 0x120, 0x13E, 0x14A, 0x35
KEYS = {
    "home": (("odm:gpio_keys",), 0x2F1),
    "extra1": (("AYANEO Controller",), BTN_MODE),
    "extra2": (("odm:gpio_keys",), 0x2F0),
    "extra3": (("odm:gpio_keys",), 0x2F2),
    "volup": (("mtk-pmic-keys",), KEY_VOLUMEUP),
    "voldown": (("mtk-kpd", "odm:gpio_keys"), KEY_VOLUMEDOWN),
    "power": (("mtk-pmic-keys",), KEY_POWER),
}
VIRTUAL = {("AYANEO Controller", "0019", "4001", "0428", "ayaneo-gamepad/input0")}
ARGS = {"switcher": (0, 0), "next": (0, 0), "back": (0, 0), "switch": (1, 1), "hook": (1, 1), "unit": (1, 1),
        "call": (4, 4), "blank": (0, 1), "none": (0, 0)}
GESTURES = ("tap", "hold", "press")
DISPLAY = {"awake": "blank-off", "blanked": "blank-on", "lit-frozen": "screen-on"}
DEFAULTS = {("home", "hold"): ((LONG_MS, "hold", ("switcher",)),), ("volup", "press"): ("hook", "volume-up"),
            ("voldown", "press"): ("hook", "volume-down"), ("power", "tap"): ("blank",),
            ("power", "hold"): ((LONG_MS, "hold", ("blank", "on")),
                                (3000, "hold=3000", ("unit", "blockie-poweroff.service")))}
NAME = re.compile(r"[a-z0-9][a-z0-9-]*")
UNIT = re.compile(r"[a-z0-9][a-z0-9@._-]*\.service")
HOLD = re.compile(r"hold(?:=([1-9][0-9]{0,4}))?")


def log(msg):
    print(f"{ME}: {msg}", file=sys.stderr, flush=True)


def valid(action, args):
    lo, hi = ARGS.get(action, (-1, -1))
    if not lo <= len(args) <= hi:
        return False
    if action in ("switch", "hook"):
        return NAME.fullmatch(args[0]) is not None
    if action == "unit":
        return UNIT.fullmatch(args[0]) is not None
    if action == "blank":
        return args in ([], ["on"])
    if action == "call":
        return (Gio.dbus_is_name(args[0]) and GLib.Variant.is_object_path(args[1])
                and Gio.dbus_is_interface_name(args[2]) and Gio.dbus_is_member_name(args[3]))
    return True


def table_files(session):
    out = []
    if not NAME.fullmatch(session):
        return out
    for d in TABLES:
        main = os.path.join(d, f"{session}.conf")
        out.append(main)
        out.extend(sorted(glob.glob(os.path.join(glob.escape(main) + ".d", "*.conf"))))
    return out


def load_table(session):
    table = {}
    holds = {}
    for path in table_files(session):
        try:
            with open(path) as f:
                lines = f.read().splitlines()
        except FileNotFoundError:
            continue
        except OSError as err:
            log(f"cannot read {path}: {err}")
            continue
        mine = set()
        for n, line in enumerate(lines, 1):
            words = line.split()
            if not words or words[0].startswith("#"):
                continue
            m = HOLD.fullmatch(words[1]) if len(words) > 1 else None
            ms = int(m.group(1) or LONG_MS) if m else 0
            gesture = "hold" if m else words[1] if len(words) > 1 else ""
            if (len(words) < 3 or words[0] not in KEYS or gesture not in GESTURES or not valid(words[2], words[3:])
                    or (gesture == "press" and words[2] not in ("hook", "none")) or ms > HOLD_MAX_MS):
                log(f"{path}:{n}: ignored: {line.strip()}")
                continue
            if gesture != "hold":
                table[(words[0], gesture)] = tuple(words[2:])
                continue
            if words[0] not in mine:
                mine.add(words[0])
                holds[words[0]] = {}
            holds[words[0]][ms] = (words[1], tuple(words[2:]))
    for key, stages in holds.items():
        table[(key, "hold")] = tuple((ms, w, row) for ms, (w, row) in sorted(stages.items()))
    for key, gesture in sorted(table):
        if gesture != "press" and (key, "press") in table:
            del table[(key, gesture)]
    for (key, gesture), row in DEFAULTS.items():
        if (key, gesture) in table:
            continue
        if gesture == "press" and ((key, "tap") in table or (key, "hold") in table):
            continue
        if gesture != "press" and (key, "press") in table:
            continue
        table[(key, gesture)] = row
    return table


def identity(name, real):
    node = os.path.dirname(real)
    out = [name]
    for f in ("id/bustype", "id/vendor", "id/product", "phys"):
        try:
            with open(os.path.join(node, f)) as fh:
                out.append(fh.read().strip())
        except OSError:
            return None
    return tuple(out)


def current():
    try:
        with open(CURRENT) as f:
            words = f.read().split()
    except OSError:
        return ""
    return words[0] if words and NAME.fullmatch(words[0]) else ""


class Key:
    def __init__(self):
        self.down = False
        self.consumed = False
        self.table = {}
        self.timer = 0
        self.stage = 0


class Hotkeyd:
    def __init__(self, loop):
        self.loop = loop
        self.keys = {k: Key() for k in KEYS}
        self.devices = {}
        self.ignored = {}
        self.missing_hooks = set()
        self.bus = None
        self.wanted = "awake"
        self.applied = "unknown"
        self.busy = False
        self.kill_timer = 0
        self.retry = 1
        self.pending = None
        self.started = None
        self.backstop = 0
        self.grabbed = False
        self.extra = {}
        self.nograb = {}

    def session_bus(self):
        if self.bus is None:
            self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        return self.bus

    def run(self, argv):
        if DRY:
            return
        try:
            return Gio.Subprocess.new(argv, Gio.SubprocessFlags.STDIN_INHERIT)
        except GLib.Error as err:
            log(f"cannot run {argv[0]}: {err.message}")

    def find_hook(self, name):
        for d in HOOKS:
            path = os.path.join(d, name)
            if os.path.isfile(path) and os.access(path, os.X_OK):
                return path
        if name not in self.missing_hooks:
            self.missing_hooks.add(name)
            log(f"no hook {name} in {':'.join(HOOKS)}")
        return None

    def hook(self, name):
        path = self.find_hook(name)
        p = self.run([path]) if path else None
        if p is not None:
            GLib.timeout_add(HOOK_MS, lambda: p.force_exit() or False)

    def want(self, state):
        self.wanted = state
        self.retry = 1
        self.set_grab(state == "blanked")
        self.apply()

    def apply(self):
        if self.busy:
            return
        if self.applied != self.wanted:
            state = self.wanted
            if DRY:
                self.applied = state
            else:
                path = self.find_hook(DISPLAY[state])
                p = self.run([path]) if path else None
                if p is not None:
                    self.busy = True
                    self.kill_timer = GLib.timeout_add(HOOK_MS, self.kill, p)
                    p.wait_async(None, self.hook_done, state)
                    return
                self.applied = state if path is None else "unknown"
        self.start_pending()

    def start_pending(self):
        if self.pending and self.wanted == "lit-frozen":
            unit, self.pending = self.pending, None
            self.start(unit)
            self.started = unit
            if self.backstop:
                GLib.source_remove(self.backstop)
            self.backstop = GLib.timeout_add(BACKSTOP_MS, self.lapsed, unit)

    def lapsed(self, unit):
        self.backstop = 0
        if self.wanted == "lit-frozen" and self.started == unit:
            log(f"{unit} started {BACKSTOP_MS} ms ago and the power is still on: back to awake")
            self.want("awake")
        return False

    def check_started(self):
        if DRY:
            return
        try:
            p = Gio.Subprocess.new(["systemctl", "--user", "show", "-P", "ActiveState", self.started],
                                   Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_SILENCE)
        except GLib.Error as err:
            log(f"cannot run systemctl: {err.message}")
            return
        p.communicate_utf8_async(None, None, self.checked, self.started)

    def checked(self, p, res, unit):
        try:
            out = p.communicate_utf8_finish(res)[1] or ""
        except GLib.Error as err:
            log(f"systemctl show {unit}: {err.message}")
            out = ""
        state = out.strip()
        if self.wanted == "lit-frozen" and self.started == unit and state not in ("activating", "active", "deactivating",
                                                                                   "reloading"):
            log(f"{unit} is {state or 'unknown'}: back to awake")
            self.want("awake")

    def kill(self, p):
        self.kill_timer = 0
        p.force_exit()
        return False

    def hook_done(self, p, res, state):
        try:
            p.wait_finish(res)
        except GLib.Error as err:
            log(f"{DISPLAY[state]}: {err.message}")
        if self.kill_timer:
            GLib.source_remove(self.kill_timer)
            self.kill_timer = 0
        self.busy = False
        if p.get_if_exited() and p.get_exit_status() == 0:
            self.applied = state
        else:
            self.applied = "unknown"
            log(f"{DISPLAY[state]}: " + (f"exit {p.get_exit_status()}" if p.get_if_exited() else "killed")
                + (", once more" if self.retry else ""))
            if not self.retry:
                self.start_pending()
                return
            self.retry -= 1
        self.apply()

    def start(self, unit):
        self.run(["systemctl", "--user", "start", "--no-block", unit])

    def blank(self, args):
        if self.wanted == "awake":
            self.want("blanked")
        elif self.wanted == "blanked":
            self.want("blanked" if args else "awake")
        elif not args and self.started:
            self.check_started()

    def unit(self, name):
        if self.wanted == "awake":
            self.start(name)
        else:
            self.pending = name
            self.started = None
            self.want("lit-frozen")

    def grab(self, dev):
        try:
            dev.grab()
        except OSError as err:
            log(f"{dev.path}: grab: {err.strerror}")

    def close(self, dev):
        try:
            dev.close()
        except OSError:
            pass

    def grab_more(self):
        for path in sorted(glob.glob("/dev/input/event*")):
            if path in self.devices:
                continue
            real = os.path.realpath(os.path.join(SYSFS, "class/input", os.path.basename(path)))
            old = self.extra.get(path)
            if (old and old[1] == real) or self.nograb.get(path) == real:
                continue
            if old:
                self.close(self.extra.pop(path)[0])
            try:
                dev = evdev.InputDevice(path)
                caps = dev.capabilities(absinfo=False)
            except OSError:
                continue
            keys = set(caps.get(evdev.ecodes.EV_KEY, []))
            if not (any(BTN_JOYSTICK <= c <= BTN_THUMBR for c in keys)
                    or (BTN_TOUCH in keys and ABS_MT_POSITION_X in caps.get(evdev.ecodes.EV_ABS, []))):
                dev.close()
                self.nograb[path] = real
                continue
            self.grab(dev)
            self.extra[path] = (dev, real)
            log(f"{path} {dev.name}: grabbed while blanked")

    def set_grab(self, on):
        if on == self.grabbed:
            return
        self.grabbed = on
        if DRY:
            print("grab" if on else "ungrab", flush=True)
        if on:
            for dev, _, _ in self.devices.values():
                self.grab(dev)
            if not INPUT:
                self.grab_more()
            log(f"blanked: {len(self.devices)} key nodes and {len(self.extra)} more grabbed")
            return
        for dev, _, _ in self.devices.values():
            try:
                dev.ungrab()
            except OSError:
                pass
        for dev, _ in self.extra.values():
            self.close(dev)
        self.extra.clear()
        self.nograb.clear()
        log("ungrabbed")
        self.resync()

    def resync(self):
        if DRY:
            print("resync", flush=True)
        held = {}
        for dev, m, _ in self.devices.values():
            try:
                active = set(dev.active_keys())
            except OSError:
                continue
            for code, key in m.items():
                held[key] = held.get(key, False) or code in active
        for key, down in held.items():
            k = self.keys[key]
            if k.down and not down:
                k.down = False
                self.stop_timer(k)

    def call(self, name, path, iface, member):
        if DRY:
            return
        try:
            self.session_bus().call(name, path, iface, member, None, None, Gio.DBusCallFlags.NO_AUTO_START, 5000,
                                    None, self.called, f"{name} {member}")
        except GLib.Error as err:
            log(f"call {name} {member}: {err.message}")

    def called(self, bus, res, what):
        try:
            bus.call_finish(res)
        except GLib.Error as err:
            log(f"call {what}: {err.message}")

    def switcher(self):
        if DRY:
            return
        try:
            r = self.session_bus().call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
                                             "NameHasOwner", GLib.Variant("(s)", (SWITCHER[0],)),
                                             GLib.VariantType("(b)"), Gio.DBusCallFlags.NONE, 2000, None)
            owned = r.unpack()[0]
        except GLib.Error as err:
            log(f"session bus: {err.message}")
            owned = False
        if owned:
            self.call(*SWITCHER)
        else:
            self.run(["blockie-session", "next"])

    def fire(self, key, gesture, row):
        if self.wanted == "blanked" and key != "power":
            return
        action, args = row[0], row[1:]
        if DRY:
            print(f"action {key} {gesture} {' '.join(row)}", flush=True)
        elif action != "none":
            log(f"{key} {gesture}: {' '.join(row)}")
        if action == "switcher":
            self.switcher()
        elif action in ("next", "back"):
            self.run(["blockie-session", action])
        elif action == "switch":
            self.run(["blockie-session", "switch", args[0]])
        elif action == "hook":
            if not DRY:
                self.hook(args[0])
        elif action == "unit":
            self.unit(args[0])
        elif action == "blank":
            self.blank(args)
        elif action == "call":
            self.call(*args)

    def stop_timer(self, k):
        if k.timer:
            GLib.source_remove(k.timer)
            k.timer = 0

    def held(self, key):
        k = self.keys[key]
        k.timer = 0
        stages = k.table[(key, "hold")]
        if k.down and k.stage < len(stages):
            ms, word, row = stages[k.stage]
            k.consumed = True
            k.stage += 1
            if k.stage < len(stages):
                k.timer = GLib.timeout_add(stages[k.stage][0] - ms, self.held, key)
            self.fire(key, word, row)
        return False

    def repeat(self, key, first):
        k = self.keys[key]
        if not k.down:
            k.timer = 0
            return False
        self.fire(key, "press", k.table[(key, "press")])
        if first:
            k.timer = GLib.timeout_add(REPEAT_MS, self.repeat, key, False)
            return False
        return True

    def handle(self, key, value):
        k = self.keys[key]
        if value == 1:
            k.down = True
            k.consumed = self.wanted == "blanked" and key != "power"
            k.stage = 0
            self.stop_timer(k)
            if k.consumed:
                return
            k.table = load_table(current())
            if (key, "press") in k.table:
                k.consumed = True
                self.fire(key, "press", k.table[(key, "press")])
                k.timer = GLib.timeout_add(REPEAT_DELAY_MS, self.repeat, key, True)
            elif (key, "hold") in k.table:
                k.timer = GLib.timeout_add(k.table[(key, "hold")][0][0], self.held, key)
        elif value == 0 and k.down:
            k.down = False
            self.stop_timer(k)
            if not k.consumed and (key, "tap") in k.table:
                self.fire(key, "tap", k.table[(key, "tap")])

    def keymap(self, name, codes):
        return {code: key for key, (names, code) in KEYS.items() if name in names and code in codes}

    def physical(self, real, name):
        if not real.startswith(os.path.join(SYSFS, "devices") + "/"):
            return False
        return "/devices/virtual/" not in real or identity(name, real) in VIRTUAL

    def rescan(self):
        for path in sorted(glob.glob("/dev/input/event*")):
            if path in self.devices:
                continue
            real = os.path.realpath(os.path.join(SYSFS, "class/input", os.path.basename(path)))
            if self.ignored.get(path) == real:
                continue
            try:
                dev = evdev.InputDevice(path)
            except OSError:
                continue
            m = self.keymap(dev.name, set(dev.capabilities().get(evdev.ecodes.EV_KEY, [])))
            if not m or not self.physical(real, dev.name):
                dev.close()
                self.ignored[path] = real
                continue
            watch = GLib.io_add_watch(dev.fd, GLib.PRIORITY_DEFAULT, GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR,
                                      self.readable, path)
            self.devices[path] = (dev, m, watch)
            if self.grabbed:
                self.grab(dev)
            log(f"{path} {dev.name}: {', '.join(sorted(m.values()))}")
        if self.grabbed:
            self.grab_more()
        return True

    def drop(self, path):
        dev, _, watch = self.devices.pop(path)
        if watch:
            GLib.source_remove(watch)
        try:
            dev.close()
        except OSError:
            pass
        log(f"{path} gone")

    def readable(self, fd, cond, path):
        dev, m, _ = self.devices[path]
        try:
            for ev in dev.read():
                if ev.type == 1 and ev.code in m:
                    self.handle(m[ev.code], ev.value)
        except BlockingIOError:
            return True
        except OSError:
            self.devices[path] = (dev, m, 0)
            self.drop(path)
            return False
        return True

    def script(self, fd, cond, buf):
        try:
            data = os.read(fd, 4096)
        except BlockingIOError:
            return True
        if not data:
            self.loop.quit()
            return False
        buf.extend(data)
        while b"\n" in buf:
            line, _, rest = bytes(buf).partition(b"\n")
            buf[:] = rest
            words = line.decode(errors="replace").split()
            if len(words) == 2 and words[0] in KEYS and words[1] in ("down", "up"):
                self.handle(words[0], 1 if words[1] == "down" else 0)
            elif words:
                log(f"input: ignored: {' '.join(words)}")
        return True


def main():
    loop = GLib.MainLoop()
    d = Hotkeyd(loop)
    if INPUT:
        fd = os.open(INPUT, os.O_RDONLY | os.O_CLOEXEC)
        os.set_blocking(fd, False)
        GLib.io_add_watch(fd, GLib.PRIORITY_DEFAULT, GLib.IO_IN | GLib.IO_HUP, d.script, bytearray())
    else:
        d.rescan()
        GLib.timeout_add_seconds(RESCAN_S, d.rescan)
    d.apply()
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, 15, loop.quit)
    loop.run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
