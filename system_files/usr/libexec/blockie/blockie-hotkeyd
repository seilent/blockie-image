        self.at = time.monotonic()
        self.shown = False
        self.result = ""
        self.failed = False
        self.kill = 0
        self.toast = 0
        self.late = 0
        self.ending = False


class Hotkeyd:
    def __init__(self, loop):
        self.loop = loop
        self.keys = {k: Key() for k in KEYS}
        self.devices = {}
        self.ignored = {}
        self.missing_hooks = {"switcher-open"}
        self.bus = None
        self.wanted = "awake"
        self.applied = "unknown"
        self.busy = False
        self.kill_timer = 0
        self.opening = None
        self.open_timer = 0
        self.regrab = {}
        self.regrab_timer = 0
        self.retry = 1
        self.pending = None
        self.started = None
        self.backstop = 0
        self.grabbed = ""
        self.menu = None
        self.last = None
        self.menu_due = False
        self.menu_from = "awake"
        self.boot = None
        self.poll_timer = 0
        self.started_at = 0
        self.under_way = False
        self.extra = {}
        self.nograb = {}
        self.helper = None
        self.helper_kill = 0
        self.helper_at = 0.0
        self.sleep_timer = 0
        self.vbus_timer = 0
        self.lost_timer = 0
        self.storm = 0
        self.next_ms = SETTLE_MS
        self.first = True
        self.fails = 0
        self.refused = False
        self.vbus_said = False
        self.rs = RESLEEP_MS
        self.wakes = []
        self.delta = asleep()
        self.resumed = None
        self.seen = set()
        self.draining = False

    def session_bus(self):
        if self.bus is None:
            self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        return self.bus

    def run(self, argv):
        if DRY:
            return
        try:
            return Gio.Subprocess.new(argv, Gio.SubprocessFlags.STDIN_INHERIT)
        except GLib.Error as err:
            log(f"cannot run {argv[0]}: {err.message}")

    def find_hook(self, name):
        for d in HOOKS:
            path = os.path.join(d, name)
            if os.path.isfile(path) and os.access(path, os.X_OK):
                return path
        if name not in self.missing_hooks:
            self.missing_hooks.add(name)
            log(f"no hook {name} in {':'.join(HOOKS)}")
        return None

    def spawn(self, name, ms):
        if not any(os.path.isdir(os.path.join(d, f"{name}.d")) for d in HOOKS):
            path = self.find_hook(name)
            return (self.run([path]) if path else None), path is not None, ms
        try:
            launcher = Gio.SubprocessLauncher.new(Gio.SubprocessFlags.STDIN_INHERIT)
            launcher.setenv("BLOCKIE_HOOK_DIRS", ":".join(HOOKS), True)
            launcher.setenv("BLOCKIE_HOOK_MS", str(ms), True)
            launcher.setenv("BLOCKIE_HOOK_PART_MS", str(PART_MS), True)
            return launcher.spawnv([RUNNER, name]), True, ms + PART_MS + 1000
        except GLib.Error as err:
            log(f"cannot run {RUNNER}: {err.message}")
            return None, True, 0

    def hook(self, name):
        p, _, ms = self.spawn(name, HOOK_MS)
        if p is not None:
            GLib.timeout_add(ms, lambda: p.force_exit() or False)

    def want(self, state):
        if state == "menu" and self.opening is not None:
            log("switcher-open killed for the power menu")
            self.opening.force_exit()
        self.wanted = state
        self.retry = 1
        self.next_ms = SETTLE_MS
        self.first = True
        self.fails = 0
        self.refused = False
        self.vbus_said = False
        if state != "blanked" and self.helper is not None:
            log("SIGTERM to blockie-sleep")
            self.helper.send_signal(15)
        if state != "menu":
            self.menu_due = False
        if state in ("awake", "blanked") and self.menu is not None:
            self.end_menu(self.menu)
        self.set_grab("all" if state in ("blanked", "lit-frozen") else "keys" if state == "menu" else "")
        self.apply()
        self.consider()

    def apply(self):
        if self.busy:
            return
        if self.applied != self.wanted:
            state = self.wanted
            if DRY:
                self.applied = state
            else:
                p, found, ms = self.spawn(DISPLAY[state], HOOK_MS)
                if p is not None:
                    self.busy = True
                    self.kill_timer = GLib.timeout_add(ms, self.kill, p)
                    p.wait_async(None, self.hook_done, state)
                    return
                self.applied = "unknown" if found else state
        self.start_pending()
        if self.menu_due and self.wanted == self.applied == "menu":
            self.start_menu()

    def start_pending(self):
        if self.pending and self.wanted == "lit-frozen":
            unit, self.pending = self.pending, None
            self.started_at = int(time.clock_gettime(time.CLOCK_MONOTONIC) * 1000000)
            self.start(unit)
            self.started = unit
            if self.backstop:
                GLib.source_remove(self.backstop)
            ms = BOOT_BACKSTOP_MS if unit == self.boot else BACKSTOP_MS
            self.backstop = GLib.timeout_add(ms, self.lapsed, unit, ms)

    def lapsed(self, unit, ms):
        self.backstop = 0
        if self.wanted == "lit-frozen" and self.started == unit:
            log(f"{unit} started {ms} ms ago and the power is still on: back to awake")
            self.want("awake")
        return False

    def check_started(self):
        if DRY:
            return
        try:
            p = Gio.Subprocess.new(["systemctl", "--user", "show", "-p", "LoadState", "-p", "ActiveState", "-p", "Result",
                                    "-p", "StateChangeTimestampMonotonic", self.started],
                                   Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_SILENCE)
        except GLib.Error as err:
            log(f"cannot run systemctl: {err.message}")
            return
        p.communicate_utf8_async(None, None, self.checked, self.started)

    def checked(self, p, res, unit):
        try:
            out = p.communicate_utf8_finish(res)[1] or ""
        except GLib.Error as err:
            log(f"systemctl show {unit}: {err.message}")
            out = ""
        props = {}
        for line in out.splitlines():
            k, _, v = line.partition("=")
            props[k] = v
        load, state, result = props.get("LoadState", ""), props.get("ActiveState", ""), props.get("Result", "")
        try:
            since = int(props.get("StateChangeTimestampMonotonic", "0"))
        except ValueError:
            since = 0
        if self.wanted != "lit-frozen" or self.started != unit:
            return
        if unit != self.boot:
            if state not in RUNNING:
                log(f"{unit} is {state or 'unknown'}: back to awake")
                self.want("awake")
            return
        if not (out.strip() and p.get_if_exited() and p.get_exit_status() == 0):
            log(f"systemctl show {unit} gave no state: polling on")
            return
        if load != "loaded":
            why = load or "unknown"
        elif since < self.started_at or state in RUNNING:
            return
        elif state == "inactive" and result == "success":
            if not self.under_way:
                self.under_way = True
                log(f"{unit} ended with success: the reboot is under way")
            return
        else:
            why = f"{state or 'unknown'} {result}"
        self.boot_failure(unit, why)

    def boot_started(self, p, res, unit):
        try:
            p.wait_finish(res)
        except GLib.Error as err:
            log(f"systemctl start {unit}: {err.message}")
            return
        if p.get_if_exited() and p.get_exit_status() == 0:
            return
        if self.wanted == "lit-frozen" and self.started == unit:
            self.boot_failure(unit, f"refused (start {'exit ' + str(p.get_exit_status()) if p.get_if_exited() else 'killed'})")

    def boot_failure(self, unit, why):
        try:
            q = Gio.Subprocess.new(["systemctl", "is-system-running"],
                                   Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_SILENCE)
        except GLib.Error as err:
            log(f"cannot run systemctl: {err.message}")
            return
        q.communicate_utf8_async(None, None, self.boot_checked, (unit, why))

    def boot_checked(self, p, res, data):
        unit, why = data
        try:
            out = p.communicate_utf8_finish(res)[1] or ""
        except GLib.Error as err:
            log(f"systemctl is-system-running: {err.message}")
            out = ""
        if out.strip() == "stopping":
            log(f"{unit} is {why} while the system is stopping: ignored")
            return
        if self.wanted != "lit-frozen" or self.started != unit:
            return
        m = self.menu
        if m is None or m is not self.last:
            log(f"{unit} is {why}: back to awake")
            self.want("awake")
        elif not m.failed:
            log(f"{unit} is {why}: back to awake once blockie-powermenu showed it")
            m.failed = True
            m.toast = GLib.timeout_add(TOAST_MS, self.toast_over, m)

    def toast_over(self, m):
        m.toast = 0
        self.end_menu(m)
        return False

    def poll(self):
        if self.wanted != "lit-frozen" or self.boot not in (self.pending, self.started):
            self.poll_timer = 0
            return False
        if self.started == self.boot:
            self.check_started()
        return True

    def kill(self, p):
        self.kill_timer = 0
        p.force_exit()
        return False

    def hook_done(self, p, res, state):
        try:
            p.wait_finish(res)
        except GLib.Error as err:
            log(f"{DISPLAY[state]}: {err.message}")
        if self.kill_timer:
            GLib.source_remove(self.kill_timer)
            self.kill_timer = 0
        self.busy = False
        if p.get_if_exited() and p.get_exit_status() == 0:
            self.applied = state
            timer = self.regrab_timer
            if state == "blanked" and timer and not self.regrab_tick():
                GLib.source_remove(timer)
        else:
            self.applied = "unknown"
            log(f"{DISPLAY[state]}: " + (f"exit {p.get_exit_status()}" if p.get_if_exited() else "killed")
                + (", once more" if self.retry else ""))
            if not self.retry:
                if state == "menu" and self.wanted == "menu":
                    log("menu-on failed twice: back to awake")
                    self.want("awake")
                    return
                self.start_pending()
                return
            self.retry -= 1
        self.apply()
        self.consider()

    def start(self, unit):
        p = self.run(["systemctl", "--user", "start", "--no-block", unit])
        if p is not None and unit == self.boot:
            p.wait_async(None, self.boot_started, unit)

    def blank(self, args, wake=False):
        if self.wanted == "awake":
            if not wake:
                self.want("blanked")
        elif self.wanted == "blanked":
            self.want("blanked" if args else "awake")
        elif self.wanted == "menu":
            self.want("blanked")
        elif not args and self.started:
            self.check_started()

    def unit(self, name):
        if self.wanted == "awake":
            self.start(name)
        else:
            self.pending = name
            self.started = None
            self.want("lit-frozen")

    def open_menu(self):
        if self.menu is not None or self.wanted in ("menu", "lit-frozen"):
            log(f"menu: ignored, {'blockie-powermenu still runs' if self.menu is not None else self.wanted}")
            return
        self.menu_from = "dark" if self.wanted == "blanked" else "awake"
        self.menu_due = True
        self.last = None
        self.want("menu")

    def start_menu(self):
        self.menu_due = False
        if DRY and "BLOCKIE_HOTKEYD_MENU" not in os.environ:
            log("dry run: no blockie-powermenu started")
            return
        try:
            launcher = Gio.SubprocessLauncher.new(Gio.SubprocessFlags.STDOUT_PIPE)
            launcher.setenv("BLOCKIE_POWERMENU_FROM", self.menu_from, True)
            launcher.setenv("BLOCKIE_BOOT_STATE", BOOT_STATE, True)
            p = launcher.spawnv([MENU])
        except GLib.Error as err:
            log(f"cannot run {MENU}: {err.message}: back to awake")
            self.want("awake")
            return
        m = Menu(p)
        m.late = GLib.timeout_add(SHOWN_MS, self.not_shown, m)
        self.menu = self.last = m
        log(f"blockie-powermenu started from {self.menu_from}")
        Gio.DataInputStream.new(p.get_stdout_pipe()).read_line_async(GLib.PRIORITY_DEFAULT, None, self.menu_line, m)
        p.wait_async(None, self.menu_exited, m)

    def menu_line(self, stream, res, m):
        try:
            line = stream.read_line_finish_utf8(res)[0]
        except GLib.Error as err:
            log(f"blockie-powermenu: {err.message}")
            line = None
        if line is not None:
            stream.read_line_async(GLib.PRIORITY_DEFAULT, None, self.menu_line, m)
            self.menu_said(m, line.split())
        elif m is self.last and not m.result and self.wanted == "menu":
            log("blockie-powermenu ended with no result: back to awake")
            m.result = "eof"
            self.want("awake")

    def menu_said(self, m, words):
        line = " ".join(words)
        if m is not self.last or m.result or self.wanted != "menu":
            log(f"blockie-powermenu: dropped: {line}")
            return
        log(f"blockie-powermenu: {line}")
        if words == ["shown"]:
            m.shown = True
            if m.late:
                GLib.source_remove(m.late)
                m.late = 0
            return
        m.result = words[0] if words else "?"
        if words == ["cancel"] or words[:1] == ["failed"]:
            self.want("awake")
        elif words == ["screen-off"]:
            self.want("blanked")
        elif words == ["poweroff"]:
            self.end_menu(m)
            self.unit("blockie-poweroff.service")
        elif len(words) == 2 and words[0] == "boot" and words[1] in TARGETS:
            self.boot = f"blockie-reboot@{words[1]}.service"
            self.under_way = False
            self.unit(self.boot)
            if not self.poll_timer:
                self.poll_timer = GLib.timeout_add(POLL_MS, self.poll)
        else:
            log(f"blockie-powermenu: not a result: {line}: back to awake")
            m.result = "?"
            self.want("awake")

    def not_shown(self, m):
        m.late = 0
        if m is self.last and not m.shown and not m.result:
            log(f"blockie-powermenu printed no shown in {SHOWN_MS} ms: back to awake")
            m.result = "late"
            if self.wanted == "menu":
                self.want("awake")
            else:
                self.end_menu(m)
        return False

    def end_menu(self, m):
        if m.ending:
            return
        m.ending = True
        if m.result not in EXITS:
            log("SIGTERM to blockie-powermenu")
            m.proc.send_signal(15)
        m.kill = GLib.timeout_add(MENU_KILL_MS, self.kill_menu, m)

    def kill_menu(self, m):
        m.kill = 0
        log(f"blockie-powermenu still running after {MENU_KILL_MS} ms: killed")
        m.proc.force_exit()
        return False

    def menu_exited(self, p, res, m):
        try:
            p.wait_finish(res)
        except GLib.Error as err:
            log(f"blockie-powermenu: {err.message}")
        for timer in (m.kill, m.toast, m.late):
            if timer:
                GLib.source_remove(timer)
        m.kill = m.toast = m.late = 0
        log("blockie-powermenu " + (f"exit {p.get_exit_status()}" if p.get_if_exited() else "killed"))
        if self.menu is m:
            self.menu = None
        timer = self.regrab_timer
        if self.regrab and timer and not self.regrab_tick():
            GLib.source_remove(timer)
        if m.failed and m is self.last and self.wanted == "lit-frozen":
            self.want("awake")
        self.consider()

    def blink(self, unit):
        if self.menu is not None:
            self.end_menu(self.menu)
        self.last = None
        self.menu_due = False
        self.run([BACKLIGHT, "off"])
        GLib.timeout_add(BLINK_MS, self.blinked, unit)

    def blinked(self, unit):
        self.run([BACKLIGHT, "on"])
        self.pending = unit
        self.started = None
        self.want("lit-frozen")
        return False

    def grab(self, dev, path):
        try:
            dev.grab()
        except OSError as err:
            if path not in self.regrab:
                log(f"{path}: grab: {err.strerror}")
            self.regrab[path] = dev
            if not self.regrab_timer:
                self.regrab_timer = GLib.timeout_add(GRAB_RETRY_MS, self.regrab_tick)
            return False
        return True

    def gone(self, path):
        del self.regrab[path]
        if path in self.extra:
            self.close(self.extra.pop(path)[0])
            log(f"{path} gone")

    def regrab_tick(self):
        if not self.grabbed:
            self.regrab.clear()
            self.regrab_timer = 0
            return False
        for path, dev in list(self.regrab.items()):
            node = self.devices.get(path, self.extra.get(path, (None,)))[0]
            if node is not dev:
                del self.regrab[path]
                continue
            real = os.path.realpath(os.path.join(SYSFS, "class/input", os.path.basename(path)))
            if path in self.extra and self.extra[path][1] != real:
                self.gone(path)
                continue
            try:
                dev.grab()
            except OSError as err:
                if err.errno == errno.ENODEV:
                    self.gone(path)
                continue
            del self.regrab[path]
            log(f"{path}: grabbed on retry")
        if self.regrab:
            return True
        self.regrab_timer = 0
        return False

    def close(self, dev):
        try:
            dev.close()
        except OSError:
            pass

    def grab_more(self):
        for path in sorted(glob.glob("/dev/input/event*")):
            if path in self.devices:
                continue
            real = os.path.realpath(os.path.join(SYSFS, "class/input", os.path.basename(path)))
            old = self.extra.get(path)
            if (old and old[1] == real) or self.nograb.get(path) == real:
                continue
            if old:
                self.close(self.extra.pop(path)[0])
            try:
                dev = evdev.InputDevice(path)
                caps = dev.capabilities(absinfo=False)
            except OSError:
                continue
            keys = set(caps.get(evdev.ecodes.EV_KEY, []))
            if not (any(BTN_JOYSTICK <= c <= BTN_THUMBR for c in keys)
                    or (BTN_TOUCH in keys and ABS_MT_POSITION_X in caps.get(evdev.ecodes.EV_ABS, []))):
                dev.close()
                self.nograb[path] = real
                continue
            if self.grab(dev, path):
                log(f"{path} {dev.name}: grabbed while {self.wanted}")
            self.extra[path] = (dev, real)

    def grabs(self, dev):
        return self.grabbed == "all" or dev.name not in KEYS["extra1"][0]

    def set_grab(self, mode):
        if mode == self.grabbed:
            return
        if self.grabbed:
            self.ungrab()
        self.grabbed = mode
        if not mode:
            return
        if DRY:
            print("grab" if mode == "all" else "grab keys", flush=True)
        nodes = [(path, dev) for path, (dev, _, _) in self.devices.items() if self.grabs(dev)]
        for path, dev in nodes:
            self.grab(dev, path)
        if mode == "keys":
            log(f"menu: {len(nodes)} key nodes grabbed")
            return
        if not INPUT:
            self.grab_more()
        log(f"{self.wanted}: {len(self.devices)} key nodes and {len(self.extra)} more grabbed")

    def ungrab(self):
        self.grabbed = ""
        if DRY:
            print("ungrab", flush=True)
        if self.regrab_timer:
            GLib.source_remove(self.regrab_timer)
            self.regrab_timer = 0
        self.regrab.clear()
        for dev, _, _ in self.devices.values():
            try:
                dev.ungrab()
            except OSError:
                pass
        for dev, _ in self.extra.values():
            self.close(dev)
        self.extra.clear()
        self.nograb.clear()
        log("ungrabbed")
        if not self.draining:
            self.resync()

    def resync(self, resumed=None):
        if DRY:
            print("resync", flush=True)
        held = {}
        for dev, m, _ in self.devices.values():
            try:
                active = set(dev.active_keys())
            except OSError:
                continue
            for code, key in m.items():
                held[key] = held.get(key, False) or code in active
        for key, down in held.items():
            k = self.keys[key]
            if k.down and not down:
                if resumed is not None and k.down_at >= resumed:
                    log(f"resume: {key} is up with its down read after the resume: handled as a release")
                    self.handle(key, 0)
                    continue
                if resumed is not None:
                    log(f"resume: {key} is up with its down read before the resume: cleared")
                k.down = False
                self.stop_timer(k)

    def battery(self):
        return (f"capacity {sysfs(BATTERY + '/capacity') or '?'} voltage_now {sysfs(BATTERY + '/voltage_now') or '?'}"
                f" online {sysfs(ONLINE) or '?'}")

    def low(self):
        c = sysfs(BATTERY + "/capacity")
        return sysfs(ONLINE) == "0" and c.isdigit() and int(c) <= LOW_CAPACITY

    def low_off(self):
        log(f"capacity {sysfs(BATTERY + '/capacity')} on battery: powering off")
        if DRY:
            print("low", flush=True)
        self.unit("blockie-poweroff.service")

    def blocker(self):
        if self.wanted != "blanked" or self.applied != "blanked" or self.busy:
            return "state"
        if any(k.down for k in self.keys.values()):
            return "key"
        if self.helper is not None or self.lost_timer:
            return "helper"
        if self.menu is not None:
            return "menu"
        if self.refused or self.storm:
            return "held"
        if sysfs(ONLINE) == "1" and not os.path.exists(KNOB):
            return "vbus"
        return ""

    def consider(self):
        why = self.blocker()
        if why == "vbus":
            if not self.vbus_said:
                self.vbus_said = True
                log("on usb power: blanked awake")
                if DRY:
                    print("vbus", flush=True)
            if not self.vbus_timer:
                self.vbus_timer = GLib.timeout_add(VBUS_MS, self.vbus_tick)
        elif self.vbus_timer:
            GLib.source_remove(self.vbus_timer)
            self.vbus_timer = 0
        if why:
            if self.sleep_timer:
                GLib.source_remove(self.sleep_timer)
                self.sleep_timer = 0
            return
        if not self.sleep_timer:
            self.sleep_timer = GLib.timeout_add(self.next_ms, self.try_sleep)

    def vbus_tick(self):
        self.vbus_timer = 0
        self.consider()
        return False

    def try_sleep(self):
        self.sleep_timer = 0
        if self.blocker():
            self.consider()
        elif self.fails > 5 and self.low():
            self.low_off()
        else:
            self.sleep_now()
        return False

    def sleep_now(self):
        first, self.first = self.first, False
        log(f"sleep{' first' if first else ''}: {self.battery()}")
        if DRY:
            print("sleep", flush=True)
            self.refused = True
            return
        try:
            p = Gio.Subprocess.new([SLEEP, "first"] if first else [SLEEP], Gio.SubprocessFlags.STDOUT_PIPE)
        except GLib.Error as err:
            log(f"cannot run {SLEEP}: {err.message}")
            self.refused = True
            return
        self.helper = p
        self.helper_at = time.monotonic()
        self.helper_kill = GLib.timeout_add(SLEEP_KILL_MS, self.kill_helper, p)
        p.communicate_utf8_async(None, None, self.slept, None)

    def kill_helper(self, p):
        self.helper_kill = 0
        log(f"blockie-sleep still running after {SLEEP_KILL_MS} ms: killed")
        p.force_exit()
        return False

    def slept(self, p, res, _):
        try:
            out = p.communicate_utf8_finish(res)[1] or ""
        except GLib.Error as err:
            log(f"blockie-sleep: {err.message}")
            out = ""
        if self.helper_kill:
            GLib.source_remove(self.helper_kill)
            self.helper_kill = 0
        self.helper = None
        words = out.split("\n", 1)[0].split()
        if not self.sample() and words[:1] == ["slept"] and (self.resumed is None or self.resumed < self.helper_at):
            self.resume()
        log(f"{' '.join(words) or 'no result'}: {self.battery()},"
            f" suspend_stats success {sysfs('power/suspend_stats/success') or '?'}")
        if self.wanted == "blanked":
            self.result(words)
        self.consider()

    def result(self, words):
        kind = words[0] if words else ""
        if kind == "slept":
            self.fails = 0
            reason = words[1] if len(words) > 1 and words[1] in REASONS else "other"
            if reason == "power":
                self.lost_timer = GLib.timeout_add(LOST_MS, self.lost)
            elif reason != "plug" and self.low():
                self.low_off()
            else:
                self.resleep()
        elif kind == "refused":
            self.refused = words[1:2] != ["cancelled"]
        else:
            self.fails += 1
            self.next_ms = RETRY_MS if self.fails <= 5 else RETRY_SLOW_MS
            log(f"retry {self.fails} in {self.next_ms} ms")

    def lost(self):
        self.lost_timer = 0
        if self.wanted == "blanked" and "power" not in self.seen:
            if "volup" in self.seen:
                log("woke by the pmic keys with only a volume up event: back to sleep")
                self.resleep()
            else:
                log(f"woke by power with no key event in {LOST_MS} ms: wake")
                self.want("awake")
        self.consider()
        return False

    def resleep(self):
        now = boottime()
        if self.wakes and now - self.wakes[-1] >= 300:
            self.rs = RESLEEP_MS
        self.wakes = [w for w in self.wakes if now - w < 600] + [now]
        if len(self.wakes) >= 30:
            log(f"{len(self.wakes)} wakes in 10 min: blanked awake for {STORM_MS} ms")
            self.wakes = []
            self.storm = GLib.timeout_add(STORM_MS, self.storm_end)
            return
        if sum(now - w < 60 for w in self.wakes) >= 5:
            self.rs = min(self.rs * 4, RESLEEP_MAX_MS)
        self.next_ms = self.rs
        log(f"resleep in {self.rs} ms")

    def storm_end(self):
        self.storm = 0
        self.consider()
        return False

    def sample(self):
        d = asleep()
        grew = d - self.delta > RESUME_S
        self.delta = d
        if grew:
            self.resume()
        return grew

    def resume(self):
        self.resumed = time.monotonic()
        self.seen = set()
        log(f"resume: {self.delta:.1f} s asleep since boot, suspend_stats success"
            f" {sysfs('power/suspend_stats/success') or '?'}")
        if self.wanted == "awake":
            self.applied = "unknown"
        self.draining = True
        for path in list(self.devices):
            while path in self.devices:
                dev, m, _ = self.devices[path]
                try:
                    evs = list(dev.read())
                except BlockingIOError:
                    break
                except OSError:
                    self.drop(path)
                    break
                for ev in evs:
                    if ev.type == 1 and ev.code in m:
                        log(f"resume drain {path}: {m[ev.code]} {ev.value}")
                        self.handle(m[ev.code], ev.value)
        self.resync(self.resumed)
        self.draining = False
        self.apply()

    def call(self, name, path, iface, member):
        if DRY:
            return
        try:
            self.session_bus().call(name, path, iface, member, None, None, Gio.DBusCallFlags.NO_AUTO_START, 5000,
                                    None, self.called, f"{name} {member}")
        except GLib.Error as err:
            log(f"call {name} {member}: {err.message}")

    def called(self, bus, res, what):
        try:
            bus.call_finish(res)
        except GLib.Error as err:
            log(f"call {what}: {err.message}")

    def switcher(self):
        if DRY:
            return
        if self.opening is not None:
            log("switcher-open still running: switcher ignored")
            return
        p, _, ms = self.spawn("switcher-open", SWITCHER_HOOK_MS)
        if p is None:
            self.open_switcher()
            return
        self.opening = p
        self.open_timer = GLib.timeout_add(ms, self.kill_open, p)
        p.wait_async(None, self.opened, None)

    def kill_open(self, p):
        self.open_timer = 0
        p.force_exit()
        return False

    def opened(self, p, res, _):
        try:
            p.wait_finish(res)
        except GLib.Error as err:
            log(f"switcher-open: {err.message}")
        if self.open_timer:
            GLib.source_remove(self.open_timer)
            self.open_timer = 0
        self.opening = None
        if self.wanted != "awake":
            return
        self.open_switcher()

    def open_switcher(self):
        try:
            r = self.session_bus().call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
                                             "NameHasOwner", GLib.Variant("(s)", (SWITCHER[0],)),
                                             GLib.VariantType("(b)"), Gio.DBusCallFlags.NONE, 2000, None)
            owned = r.unpack()[0]
        except GLib.Error as err:
            log(f"session bus: {err.message}")
            owned = False
        if owned:
            self.call(*SWITCHER)
        else:
            self.run(["blockie-session", "next"])

    def fire(self, key, gesture, row, fallback=False):
        if self.wanted in ("blanked", "menu", "lit-frozen") and key != "power":
            return
        m = self.last
        if (fallback and m is not None and m.shown
                and ((m is self.menu and not m.ending) or m.at >= self.keys[key].down_at)):
            log(f"{key} {gesture}: blockie-powermenu showed: {' '.join(row)} skipped")
            return
        action, args = row[0], row[1:]
        if DRY:
            print(f"action {key} {gesture} {' '.join(row)}", flush=True)
        elif action != "none":
            log(f"{key} {gesture}: {' '.join(row)}")
        if action == "switcher":
            self.switcher()
        elif action in ("next", "back"):
            self.run(["blockie-session", action])
        elif action == "switch":
            self.run(["blockie-session", "switch", args[0]])
        elif action == "hook":
            if not DRY:
                self.hook(args[0])
        elif action == "unit":
            if fallback:
                self.blink(args[0])
            else:
                self.unit(args[0])
        elif action == "blank":
            self.blank(args, gesture == "tap" and self.keys[key].wake)
        elif action == "menu":
            self.open_menu()
        elif action == "call":
            self.call(*args)

    def stop_timer(self, k):
        if k.timer:
            GLib.source_remove(k.timer)
            k.timer = 0

    def held(self, key):
        k = self.keys[key]
        k.timer = 0
        stages = k.table[(key, "hold")]
        if k.down and k.stage < len(stages):
            ms, word, row = stages[k.stage]
            k.consumed = True
            k.stage += 1
            if k.stage < len(stages):
                k.timer = GLib.timeout_add(stages[k.stage][0] - ms, self.held, key)
            self.fire(key, word, row, row[0] == "unit" and any(r[0] == "menu" for _, _, r in stages[:k.stage - 1]))
        return False

    def repeat(self, key, first):
        k = self.keys[key]
        if not k.down:
            k.timer = 0
            return False
        self.fire(key, "press", k.table[(key, "press")])
        if first:
            k.timer = GLib.timeout_add(REPEAT_MS, self.repeat, key, False)
            return False
        return True

    def handle(self, key, value):
        k = self.keys[key]
        if key == "volup" or (key == "power" and value == 1):
            self.seen.add(key)
        if value == 1:
            k.down = True
            k.down_at = time.monotonic()
            k.wake = key == "power" and self.resumed is not None and k.down_at - self.resumed < WAKE_MS / 1000
            k.consumed = self.wanted in ("blanked", "menu", "lit-frozen") and key != "power"
            k.stage = 0
            self.stop_timer(k)
            if not k.consumed:
                k.table = load_table(current())
                if (key, "press") in k.table:
                    k.consumed = True
                    self.fire(key, "press", k.table[(key, "press")])
                    k.timer = GLib.timeout_add(REPEAT_DELAY_MS, self.repeat, key, True)
                elif (key, "hold") in k.table:
                    k.timer = GLib.timeout_add(k.table[(key, "hold")][0][0], self.held, key)
        elif value == 0 and k.down:
            k.down = False
            self.stop_timer(k)
            if not k.consumed and (key, "tap") in k.table:
                self.fire(key, "tap", k.table[(key, "tap")])
        self.consider()

    def keymap(self, name, codes):
        return {code: key for key, (names, code) in KEYS.items() if name in names and code in codes}

    def physical(self, real, name):
        if not real.startswith(os.path.join(SYSFS, "devices") + "/"):
            return False
        return "/devices/virtual/" not in real or identity(name, real) in VIRTUAL

    def rescan(self):
        self.sample()
        for path in sorted(glob.glob("/dev/input/event*")):
            if path in self.devices:
                continue
            real = os.path.realpath(os.path.join(SYSFS, "class/input", os.path.basename(path)))
            if self.ignored.get(path) == real:
                continue
            try:
                dev = evdev.InputDevice(path)
            except OSError:
                continue
            m = self.keymap(dev.name, set(dev.capabilities().get(evdev.ecodes.EV_KEY, [])))
            if not m or not self.physical(real, dev.name):
                dev.close()
                self.ignored[path] = real
                continue
            watch = GLib.io_add_watch(dev.fd, GLib.PRIORITY_DEFAULT, GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR,
                                      self.readable, path)
            self.devices[path] = (dev, m, watch)
            if self.grabbed and self.grabs(dev):
                self.grab(dev, path)
            log(f"{path} {dev.name}: {', '.join(sorted(m.values()))}")
        if self.grabbed == "all":
            self.grab_more()
        return True

    def drop(self, path):
        dev, _, watch = self.devices.pop(path)
        self.regrab.pop(path, None)
        if watch:
            GLib.source_remove(watch)
        try:
            dev.close()
        except OSError:
            pass
        log(f"{path} gone")

    def readable(self, fd, cond, path):
        self.sample()
        if path not in self.devices:
            return False
        dev, m, _ = self.devices[path]
        try:
            for ev in dev.read():
                if ev.type == 1 and ev.code in m:
                    self.handle(m[ev.code], ev.value)
        except BlockingIOError:
            return True
        except OSError:
            self.devices[path] = (dev, m, 0)
            self.drop(path)
            return False
        return True

    def script(self, fd, cond, buf):
        try:
            data = os.read(fd, 4096)
        except BlockingIOError:
            return True
        if not data:
            self.loop.quit()
            return False
        buf.extend(data)
        while b"\n" in buf:
            line, _, rest = bytes(buf).partition(b"\n")
            buf[:] = rest
            words = line.decode(errors="replace").split()
            self.sample()
            if len(words) == 2 and words[0] in KEYS and words[1] in ("down", "up"):
                self.handle(words[0], 1 if words[1] == "down" else 0)
            elif words:
                log(f"input: ignored: {' '.join(words)}")
        return True


def main():
    loop = GLib.MainLoop()
    d = Hotkeyd(loop)
    if INPUT:
        fd = os.open(INPUT, os.O_RDONLY | os.O_CLOEXEC)
        os.set_blocking(fd, False)
        GLib.io_add_watch(fd, GLib.PRIORITY_DEFAULT, GLib.IO_IN | GLib.IO_HUP, d.script, bytearray())
    else:
        d.rescan()
        GLib.timeout_add_seconds(RESCAN_S, d.rescan)
    d.apply()
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, 15, loop.quit)
    loop.run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
