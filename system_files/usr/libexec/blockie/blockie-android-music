#!/usr/bin/env bash
set -u

me=blockie-android-music
payload=${BLOCKIE_ANDROID_PAYLOAD:-/sys/fs/cgroup/lxc.payload.waydroid}
run=${BLOCKIE_ANDROID_RUN:-/run/blockie-android}
wait=${BLOCKIE_ANDROID_MUSIC_WAIT:-30}
media=/data/media/0/Music
pass=/mnt/pass_through/0/emulated/0/Music
classpath=/data/system/environ/classpath
keys=(PATH ANDROID_ROOT ANDROID_DATA ANDROID_STORAGE ANDROID_ART_ROOT ANDROID_I18N_ROOT ANDROID_TZDATA_ROOT ANDROID_RUNTIME_ROOT
  BOOTCLASSPATH)
declare -A env=(
  [PATH]=/product/bin:/apex/com.android.runtime/bin:/apex/com.android.art/bin:/system_ext/bin:/system/bin:/system/xbin:/odm/bin:/vendor/bin:/vendor/xbin
  [ANDROID_ROOT]=/system
  [ANDROID_DATA]=/data
  [ANDROID_STORAGE]=/storage
  [ANDROID_ART_ROOT]=/apex/com.android.art
  [ANDROID_I18N_ROOT]=/apex/com.android.i18n
  [ANDROID_TZDATA_ROOT]=/apex/com.android.tzdata
  [ANDROID_RUNTIME_ROOT]=/apex/com.android.runtime
  [BOOTCLASSPATH]=/apex/com.android.art/javalib/core-oj.jar:/apex/com.android.art/javalib/core-libart.jar:/apex/com.android.art/javalib/core-icu4j.jar:/apex/com.android.art/javalib/okhttp.jar:/apex/com.android.art/javalib/bouncycastle.jar:/apex/com.android.art/javalib/apache-xml.jar:/system/framework/framework.jar:/system/framework/ext.jar:/system/framework/telephony-common.jar:/system/framework/voip-common.jar:/system/framework/ims-common.jar:/system/framework/framework-atb-backward-compatibility.jar:/apex/com.android.conscrypt/javalib/conscrypt.jar:/apex/com.android.media/javalib/updatable-media.jar:/apex/com.android.mediaprovider/javalib/framework-mediaprovider.jar:/apex/com.android.os.statsd/javalib/framework-statsd.jar:/apex/com.android.permission/javalib/framework-permission.jar:/apex/com.android.sdkext/javalib/framework-sdkextensions.jar:/apex/com.android.wifi/javalib/framework-wifi.jar:/apex/com.android.tethering/javalib/framework-tethering.jar
)
at='^[0-9]* [0-9]* [0-9]*:[0-9]* [^ ]* '
die() { echo "$me: $*" >&2; exit 1; }
attach() {
  local t=$1 k vars=()
  shift
  for k in "${keys[@]}"; do
    vars+=(--set-var "$k=${env[$k]}")
  done
  out=$(timeout "$t" lxc-attach -P /var/lib/waydroid/lxc -n waydroid --clear-env "${vars[@]}" -- "$@" < /dev/null 2> "$errf" |
    tr -d '\r'; exit "${PIPESTATUS[0]}")
  rc=$?
  err=$(tr -d '\r' < "$errf")
}
guest() {
  attach "$@"
  if ((rc == 124)) && frozen; then
    end=$((end + $1))
    thawed
    attach "$@"
  fi
  return "$rc"
}
said() {
  local s=$out${out:+${err:+ }}$err
  s=${s//$'\n'/ }
  echo "${s:-no output}"
}
ready() {
  guest 10 sh -c "[ -d $pass ] && grep -q \"$at$media \" /proc/self/mountinfo && echo __ready"
  grep -qx __ready <<< "$out"
}
live() {
  grep -qx 'populated 1' "$payload/cgroup.events" 2> /dev/null && return
  echo "$me: Android stopped"
  exit 0
}
frozen() { grep -qx 'frozen 1' "$payload/cgroup.events" 2> /dev/null; }
thawed() {
  live
  ! frozen || echo "$me: Android is frozen, waiting for the thaw"
  while frozen; do
    end=$((end + 1))
    sleep 1
  done
  live
}

if [[ ! -r $payload/cgroup.events ]] || ! grep -qx 'populated 1' "$payload/cgroup.events"; then
  echo "$me: no running Android payload at $payload, nothing to bind"
  exit 0
fi
if [[ ! -s $run/lxc.d/music.conf ]]; then
  echo "$me: no music bind in $run/lxc.d/music.conf, nothing to bind"
  exit 0
fi
errf=$(mktemp) || die "cannot make a temporary file"
trap 'rm -f "$errf"' EXIT

echo "$me: waiting up to $wait s for $pass and the $media bind in the guest"
end=$((SECONDS + wait))
thawed
until ready; do
  thawed
  ((SECONDS < end)) || die "$pass or the $media bind did not appear in the guest within $wait s"
  sleep 1
  thawed
done
echo "$me: the guest has $pass and the $media bind"

thawed
guest 10 sh -c "if grep -q \"$at$pass \" /proc/self/mountinfo; then echo __already; elif mount --bind $media $pass; then echo __bound; fi"
if grep -qx __already <<< "$out"; then
  echo "$me: $media is already bound onto $pass"
elif grep -qx __bound <<< "$out"; then
  echo "$me: bound $media onto $pass"
else
  live
  die "cannot bind $media onto $pass: $(said)"
fi

thawed
if guest 10 /system/bin/cat $classpath; then
  while read -r _ k v; do
    [[ -n $v && $k =~ ^[A-Za-z_][A-Za-z0-9_]*$ && ( $k == *CLASSPATH* || $k == *SYSTEMSERVER* ) ]] || continue
    [[ -v env[$k] ]] || keys+=("$k")
    env[$k]=$v
  done <<< "$out"
else
  echo "$me: cannot read $classpath (exit $rc: $(said)), scanning with the base environment"
fi

thawed
guest 120 content call --uri content://media --method scan_volume --arg external_primary
if ((rc == 124)); then
  echo "$me: scan_volume external_primary did not answer in 120 s, MediaProvider goes on scanning"
elif grep -q '^Result:' <<< "$out"; then
  echo "$me: scanned external_primary"
else
  live
  die "scan_volume external_primary failed (exit $rc): $(said)"
fi
