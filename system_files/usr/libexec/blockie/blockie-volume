#!/bin/sh
set -u
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
sink=@DEFAULT_AUDIO_SINK@
step=${BLOCKIE_VOLUME_STEP:-5%}
settings=${BLOCKIE_VOLUME_SETTINGS:-/run/blockie-set/settings}

usage() {
    echo "usage: blockie-volume up|down|mute [on|off]|set <pct> [muted|unmuted]|get|limit [wait]" >&2
    exit 2
}

limit() {
    [ -r "$settings" ] || return 1
    awk '$1 == "sound.max_volume" && $2 ~ /^[0-9]+$/ { p = $2 } END { printf "%.2f\n", (p == "" ? 100 : p) / 100 }' \
        "$settings"
}

same() {
    awk -v a="$1" -v b="$2" 'BEGIN { exit !(b ~ /^[0-9]+(\.[0-9]+)?$/ && a - b < 0.001 && b - a < 0.001) }'
}

taken() {
    out=$(wpctl settings blockie.volume-limit 2> /dev/null) || return 1
    set -- "$1" $out
    [ "$2" = Value: ] && [ "$4" = "(Saved:" ] && same "$1" "$3" && same "$1" "${5%)}"
}

applied() {
    timeout 1 pw-metadata -n blockie-volume-limit 0 applied 2> /dev/null |
        sed -n "s/.* key:'applied' value:'\([^']*\)'.*/\1/p" | tail -n 1
}

ready() {
    timeout 1 pw-metadata -n blockie-volume-limit 0 ready 2> /dev/null |
        sed -n "s/.* key:'ready' value:'\([^']*\)'.*/\1/p" | tail -n 1
}

push() {
    n=0
    while ! { wpctl settings --save blockie.volume-limit "$1" > /dev/null 2>&1 && taken "$1"; }; do
        n=$((n + 1))
        if [ "$n" -ge 10 ]; then
            echo "blockie-volume: WirePlumber did not take the limit $1" >&2
            return 1
        fi
        sleep 1
    done
    timeout 1 pw-metadata -n blockie-volume-limit 0 push "$(date +%s%N)" > /dev/null 2>&1
    return 0
}

follow() {
    i=0
    end=$(($(date +%s) + 3))
    while ! same "$1" "$(applied)"; do
        if [ "$i" -ge 20 ] || [ "$(date +%s)" -ge "$end" ]; then
            echo "blockie-volume: the limit $1 is not applied after 2 s" >&2
            return 0
        fi
        sleep 0.1
        i=$((i + 1))
    done
}

case "${1:-}" in
up) exec wpctl set-volume -l 1.0 "$sink" "$step+" ;;
down) exec wpctl set-volume "$sink" "$step-" ;;
mute)
    case "${2:-toggle}" in
    on) exec wpctl set-mute "$sink" 1 ;;
    off) exec wpctl set-mute "$sink" 0 ;;
    toggle) exec wpctl set-mute "$sink" toggle ;;
    *) usage ;;
    esac
    ;;
set)
    pct=${2:-}
    case "$pct" in
    "" | *[!0-9]* | ????*) usage ;;
    esac
    [ "$pct" -le 100 ] || usage
    case "${3:-unmuted}" in
    muted) m=1 ;;
    unmuted) m=0 ;;
    *) usage ;;
    esac
    wpctl set-volume "$sink" "$pct%" && exec wpctl set-mute "$sink" "$m"
    ;;
limit)
    case "${2:-}" in
    "")
        v=$(limit) || exit 0
        r=0
        while [ "$r" -lt 10 ] && [ -z "$(ready)" ]; do
            sleep 1
            r=$((r + 1))
        done
        k=1
        while :; do
            push "$v" || exit 1
            follow "$v"
            w=$(limit) || exit 0
            [ "$w" != "$v" ] || exit 0
            if [ "$k" -ge 3 ]; then
                echo "blockie-volume: the map moved to $w during 3 pushes, pushed once more without the wait" >&2
                push "$w"
                exit 1
            fi
            echo "blockie-volume: the map reads $w after the push of $v, once more" >&2
            v=$w
            k=$((k + 1))
        done
        ;;
    wait)
        w=$(limit) || exit 0
        follow "$w"
        ;;
    *) usage ;;
    esac
    ;;
get)
    out=$(wpctl get-volume "$sink") || exit
    printf '%s\n' "$out" | awk '
        $1 == "Volume:" && $2 ~ /^[0-9]+(\.[0-9]+)?$/ {
            printf "%d %s\n", $2 * 100 + 0.5, ($3 == "[MUTED]" ? "muted" : "unmuted")
            ok = 1
            exit
        }
        END { exit !ok }'
    ;;
*) usage ;;
esac
