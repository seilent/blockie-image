#!/usr/bin/env bash
set -euo pipefail

me=blockie-data
die() { echo "$me: $*" >&2; exit 1; }
usage() { echo "usage: $me [internal]" >&2; exit 2; }

sys=${BLOCKIE_SYS:-/sys}
devdir=${BLOCKIE_DEV:-/dev}
host=${BLOCKIE_SD_HOST:-11240000.mmc}

(( $# <= 1 )) || usage
case ${1:-} in
  '')
    target=${BLOCKIE_DATA_DIR:-/var/lib/blockie/data}
    label=BLOCKIE_DATA
    name=BLOCKIE_DATA
    on=$host
    ours() { [[ $1 == */"$host"/* ]]; }
    ;;
  internal)
    target=${BLOCKIE_INTERNAL_DIR:-/var/lib/blockie/internal}
    label=BLOCKIE_INTERNAL
    name=userdata
    run=${BLOCKIE_RUN:-/run/blockie}
    read -r on 2> /dev/null < "$run/emmc" || die "no eMMC disk named in $run/emmc"
    [[ $on =~ ^mmcblk[0-9]+$ ]] || die "$run/emmc names '$on', not an mmcblk disk"
    ours() { [[ $1 == */block/"$on"/* && $1 != */"$host"/* ]]; }
    ;;
  *) usage ;;
esac

if mountpoint -q "$target"; then
  echo "$me: $target is already mounted"
  exit 0
fi

found=()
shopt -s nullglob
for p in "$sys"/class/block/mmcblk*p*; do
  [[ -e $p/partition && -r $p/uevent ]] || continue
  [[ $(sed -n 's/^PARTNAME=//p' "$p/uevent") == "$name" ]] || continue
  ours "$(readlink -f "$p")" || continue
  found+=("${p##*/}")
done
shopt -u nullglob
(( ${#found[@]} == 1 )) || die "expected one $name partition on $on, found ${#found[@]} (${found[*]})"

dev=$devdir/${found[0]}
type=$(blkid -p -o value -s TYPE "$dev") || die "blkid cannot probe $dev"
[[ $type == ext4 ]] || die "$dev is $type, not ext4"
[[ $(blkid -p -o value -s LABEL "$dev") == "$label" ]] || die "$dev is not labelled $label"
rc=0
e2fsck -p "$dev" || rc=$?
(( rc < 4 )) || die "e2fsck -p $dev exited $rc, not mounted"
(( !(rc & 2) )) || echo "$me: e2fsck -p $dev fixed errors and asks for a reboot, mounting anyway"
install -d -m 0755 "$target"
mount -t ext4 -o rw,noatime,nodev,nosuid "$dev" "$target"
echo "$me: $dev mounted at $target"
