#!/usr/bin/python3
import ctypes
import errno
import fcntl
import os
import re
import socket
import struct
import sys

CARD_ID = "mt6768mt6358"
JACK_NAME = "mt6768-mt6358 Headset Jack"
CONTROL = b"Headphone Jack"
CARDS = os.environ.get("BLOCKIE_JACK_CARDS", "/proc/asound/cards")
SYSFS = os.environ.get("BLOCKIE_JACK_SYSFS", "/sys/class/input")
DEV = os.environ.get("BLOCKIE_JACK_DEV", "/dev/input")
EV_SYN = 0
EV_SW = 5
SYN_REPORT = 0
SYN_DROPPED = 3
SW_HEADPHONE_INSERT = 2
SW_LINEOUT_INSERT = 6
SW_BYTES = 3
IFACE_CARD = 0
EVENT = struct.Struct("@llHHi")


def log(msg):
    print(f"blockie-jack: {msg}", file=sys.stderr, flush=True)


def find_card(text):
    for line in text.splitlines():
        m = re.match(r"\s*(\d+) \[(\S+)\s*\]:", line)
        if m and m.group(2) == CARD_ID:
            return int(m.group(1))
    return None


def find_jack(sysfs):
    try:
        entries = sorted(os.listdir(sysfs))
    except OSError:
        return None
    for e in entries:
        if not e.startswith("event"):
            continue
        try:
            with open(os.path.join(sysfs, e, "device", "name")) as f:
                if f.read().strip() == JACK_NAME:
                    return e
        except OSError:
            continue
    return None


def eviocgsw(size):
    return (2 << 30) | (size << 16) | (ord("E") << 8) | 0x1B


def plugged(bits):
    def bit(n):
        return bits[n // 8] >> (n % 8) & 1

    return bool(bit(SW_HEADPHONE_INSERT) or bit(SW_LINEOUT_INSERT))


def decode(buf):
    n = len(buf) // EVENT.size
    return [EVENT.unpack_from(buf, i * EVENT.size)[2:] for i in range(n)]


def read_state(fd):
    buf = bytearray(SW_BYTES)
    fcntl.ioctl(fd, eviocgsw(SW_BYTES), buf)
    return plugged(buf)


def notify(msg):
    addr = os.environ.get("NOTIFY_SOCKET")
    if not addr:
        return
    if addr[0] == "@":
        addr = "\0" + addr[1:]
    with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as s:
        s.connect(addr)
        s.sendall(msg.encode())


class Control:
    def __init__(self, card):
        lib = ctypes.CDLL("libasound.so.2")
        vp = ctypes.c_void_p
        pp = ctypes.POINTER(vp)
        for name, args in (
            ("snd_ctl_open", [pp, ctypes.c_char_p, ctypes.c_int]),
            ("snd_ctl_elem_id_malloc", [pp]),
            ("snd_ctl_elem_id_set_interface", [vp, ctypes.c_int]),
            ("snd_ctl_elem_id_set_name", [vp, ctypes.c_char_p]),
            ("snd_ctl_elem_add_boolean", [vp, vp, ctypes.c_uint]),
            ("snd_ctl_elem_value_malloc", [pp]),
            ("snd_ctl_elem_value_set_id", [vp, vp]),
            ("snd_ctl_elem_value_set_boolean", [vp, ctypes.c_uint, ctypes.c_long]),
            ("snd_ctl_elem_write", [vp, vp]),
            ("snd_strerror", [ctypes.c_int]),
        ):
            getattr(lib, name).argtypes = args
        lib.snd_strerror.restype = ctypes.c_char_p
        self.lib = lib
        self.handle = vp()
        self.check(lib.snd_ctl_open(ctypes.byref(self.handle), f"hw:{card}".encode(), 0), "snd_ctl_open")
        eid = vp()
        self.check(lib.snd_ctl_elem_id_malloc(ctypes.byref(eid)), "snd_ctl_elem_id_malloc")
        lib.snd_ctl_elem_id_set_interface(eid, IFACE_CARD)
        lib.snd_ctl_elem_id_set_name(eid, CONTROL)
        r = lib.snd_ctl_elem_add_boolean(self.handle, eid, 1)
        self.created = r == 0
        if r < 0 and r != -errno.EBUSY:
            self.check(r, "snd_ctl_elem_add_boolean")
        self.value = vp()
        self.check(lib.snd_ctl_elem_value_malloc(ctypes.byref(self.value)), "snd_ctl_elem_value_malloc")
        lib.snd_ctl_elem_value_set_id(self.value, eid)

    def check(self, r, what):
        if r < 0:
            raise OSError(-r, f"{what}: {self.lib.snd_strerror(r).decode()}")

    def set(self, on):
        self.lib.snd_ctl_elem_value_set_boolean(self.value, 0, 1 if on else 0)
        self.check(self.lib.snd_ctl_elem_write(self.handle, self.value), "snd_ctl_elem_write")


def main():
    try:
        with open(CARDS) as f:
            card = find_card(f.read())
    except OSError:
        card = None
    event = find_jack(SYSFS)
    if card is None or event is None:
        log(f"no card {CARD_ID} or no input '{JACK_NAME}', nothing to bridge")
        notify("READY=1")
        return 0
    fd = os.open(os.path.join(DEV, event), os.O_RDONLY)
    ctl = Control(card)
    state = read_state(fd)
    try:
        ctl.set(state)
    except OSError as e:
        if ctl.created or e.errno != errno.EPERM:
            raise
        log(f"card {card} has a read only Headphone Jack control, nothing to bridge")
        notify("READY=1")
        return 0
    log(f"card {card} {event}: Headphone Jack {'on' if state else 'off'} ({'created' if ctl.created else 'reused'})")
    notify("READY=1")
    pending = False
    while True:
        buf = os.read(fd, EVENT.size * 64)
        if not buf:
            log(f"{event} closed")
            return 1
        for kind, code, _ in decode(buf):
            if kind == EV_SW and code in (SW_HEADPHONE_INSERT, SW_LINEOUT_INSERT):
                pending = True
            elif kind == EV_SYN and code == SYN_DROPPED:
                pending = True
            elif kind == EV_SYN and code == SYN_REPORT and pending:
                pending = False
                now = read_state(fd)
                if now != state:
                    ctl.set(now)
                    state = now
                    log(f"Headphone Jack {'on' if state else 'off'}")


if __name__ == "__main__":
    sys.exit(main())
