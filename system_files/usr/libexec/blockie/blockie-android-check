#!/usr/bin/env bash
set -u

data=${BLOCKIE_DATA_DIR:-/var/lib/blockie/data}
internal=${BLOCKIE_INTERNAL_DIR:-/var/lib/blockie/internal}
run=${BLOCKIE_ANDROID_RUN:-/run/blockie-android}

state=
[[ ! -r $run/state ]] || read -r state < "$run/state"
kind=${state%% *}
why=${state#"$kind"}
why=${why# }
for m in "$data" "$internal"; do
  if ! mountpoint -q "$m"; then
    if [[ $kind == failed ]]; then
      echo "$why"
      exit 2
    fi
    echo "${why:-$m is not mounted}"
    exit 1
  fi
done
for f in system.img vendor.img; do
  [[ -f $internal/android/images/$f ]] || { echo "no android/images/$f"; exit 1; }
done
case $kind in
  ok) exit 0 ;;
  missing) echo "$why"; exit 1 ;;
  failed) echo "$why"; exit 2 ;;
  '') echo "prep not run"; exit 2 ;;
  *) echo "unknown state: $state"; exit 2 ;;
esac
