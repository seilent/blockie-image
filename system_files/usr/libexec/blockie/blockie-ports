class Fail(Exception):
    def __init__(self, why):
        super().__init__(why)
        self.why = why


class Proto:
    def __init__(self, fd):
        self.fd = fd

    def line(self, *fields):
        try:
            os.write(self.fd, ("\t".join(fields) + "\n").encode())
        except OSError:
            pass

    def progress(self, what, done, total):
        self.line("progress", what, str(done), "-" if total is None else str(total))

    def done(self, name):
        self.line("done", name)

    def fail(self, name, why):
        self.line("fail", name, why)


