def rt_remote(hm, rt):
    remote = hm.runtimes_info.get(rt, {}).get("remote", {}).get(hm.device.get("primary_arch", "aarch64"))
    if isinstance(remote, dict) and isinstance(remote.get("md5"), str) and isinstance(remote.get("url"), str):
        return remote
    return None


def fetch_runtime(hm, ctx, rt):
    hmod, feed = ctx.load()
    remote = rt_remote(hm, rt)
    if remote is None:
        raise Fail("unknown-runtime")
    md5 = remote["md5"]
    final = os.path.join(LIBS, rt)
    if current(final, md5):
        unpack_tree(final, md5, ctx.proto)
        return
    if hm.config["offline"]:
        raise Fail("network")
    size = remote.get("size") if isinstance(remote.get("size"), int) else 0
    need(size * (1 + SQUASH_RATIO))
    os.makedirs(PART, 0o755, exist_ok=True)
    os.makedirs(UNPACKED, 0o755, exist_ok=True)
    part = os.path.join(PART, f"{rt}.{os.getpid()}")
    tmp = os.path.join(UNPACKED, f"{md5}.tmp-{os.getpid()}")
    journal(rt, {"op": "runtime", "name": rt, "new": [part, tmp]})
    try:
        res = [None]
        feed.what = "runtime"
        with feed.enable_cancellable(True):
            try:
                got = hmod.download(Path(part), remote["url"], md5_result=res, callback=feed, no_check=True)
            except hmod.CancelEvent:
                raise Fail("cancel")
        if CANCEL[0]:
            raise Fail("cancel")
        if got is None:
            raise Fail("network")
        if res[0] != md5:
            raise Fail("md5")
        fsync_file(part)
        os.replace(part, final)
        fsync_dir(LIBS)
        unpack_tree(final, md5, ctx.proto)
    except BaseException:
        remove(part)
        remove(tmp)
        drop_journal(rt)
        raise
    drop_journal(rt)


def gc(hm):
    rows = read_unindex()
    named = set()
    for info in list(hm.installed_ports.values()) + list(hm.broken_ports.values()):
        for rt in runtimes_of(info, port_scripts(info)):
            row = lookup(rows, os.path.join(LIBS, rt))
            if row is not None:
                named.add(row[4])
    now = time.time()
    try:
        entries = os.listdir(UNPACKED)
    except FileNotFoundError:
        entries = []
    for e in entries:
        p = os.path.join(UNPACKED, e)
        if ".tmp-" in e:
            remove(p)
            continue
        if not MD5.fullmatch(e) or e in named:
            continue
        try:
            used = os.stat(p + ".used").st_mtime
        except FileNotFoundError:
            used = os.lstat(p).st_mtime
        if now - used > GC_S:
            log(f"removed the unused runtime tree {e}")
            remove(p)
            remove(p + ".used")
    try:
        for e in os.listdir(PART):
            remove(os.path.join(PART, e))
    except FileNotFoundError:
        pass
    if entries:
        write_unindex([r for r in rows if os.path.isdir(os.path.join(UNPACKED, r[4]))])


def why_of(err):
    if isinstance(err, Fail):
        return err.why
    if isinstance(err, OSError) and err.errno == errno.ENOSPC:
        return "space"
    log(traceback.format_exc())
    return "other"


def find_port(hm, name):
    if name == "portmaster.zip" or any(name in s.utils for s in hm.sources.values()):
        raise Fail("other")
    for src in hm.sources.values():
        if name in src.ports:
            return src
    raise Fail("other")


def zip_parts(path):
    with zipfile.ZipFile(path) as zf:
        infos = zf.infolist()
    total = sum(i.file_size for i in infos)
    tops = set()
    for i in infos:
        n = i.filename.replace("\\", "/")
        first = n.split("/", 1)[0]
        if first in ("", ".", ".."):
            continue
        if "/" in n:
            tops.add(first)
        elif n.lower().endswith(".sh"):
            tops.add(n)
    return total, sorted(tops)


def do_install(name, ctx, update):
    if not PORT.fullmatch(name):
        raise Fail("other")
    if scope_active():
        raise Fail("busy")
    hmod, feed = ctx.load()
    hm = ctx.open(check=False)
    try:
        with game_lock():
            replay()
        src = find_port(hm, name)
        fresh = not installed(hm, name)
        if update and fresh:
            raise Fail("other")
        if hm.config["offline"]:
            raise Fail("network")
        info = src.port_info(name)
        source = info.get("source") if isinstance(info.get("source"), dict) else {}
        size = source.get("size") if isinstance(source.get("size"), int) else 0
        wanted = runtimes_of(info, port_scripts(installed_info(hm, name)))
        rt_bytes = 0
        for rt in wanted:
            remote = None if rt in BUILTIN else rt_remote(hm, rt)
            if remote is not None and not current(os.path.join(LIBS, rt), remote["md5"]):
                rt_bytes += (remote.get("size") if isinstance(remote.get("size"), int) else 0) * (1 + SQUASH_RATIO)
        need(2 * size + rt_bytes)
        data = {"op": "install" if fresh else "update", "name": name, "new": []}
        zip_path = os.path.join(PORTS, name)
        if size > hmod.config.HM_MAX_TEMP_SIZE and not os.path.lexists(zip_path):
            data["new"].append(zip_path)
        journal(name, data)
        extracted = False
        unknown = False
        try:
            feed.what = "download"
            with feed.enable_cancellable(True):
                try:
                    dl = src.download(name)
                except hmod.CancelEvent:
                    raise Fail("cancel")
            if dl is not None and CANCEL[0]:
                remove(str(dl["zip_file"]))
            if CANCEL[0]:
                raise Fail("cancel")
            if dl is None:
                raise Fail("network")
            try:
                total, tops = zip_parts(dl["zip_file"])
            except zipfile.BadZipFile:
                remove(str(dl["zip_file"]))
                raise Fail("other")
            try:
                need(total + rt_bytes)
            except Fail:
                remove(str(dl["zip_file"]))
                raise
            for t in tops:
                p = os.path.join(PORTS, t)
                if not os.path.lexists(p):
                    data["new"].append(p)
                elif os.path.isdir(p) and not os.path.lexists(os.path.join(p, "port.json")):
                    data["new"].append(os.path.join(p, "port.json"))
            journal(name, data)
            with game_lock():
                try:
                    feed.what = "install"
                    with feed.enable_cancellable(False):
                        rc = hm._install_port(dl, do_delete=True)
                    if rc != 0:
                        raise Fail("other")
                    hm.load_ports()
                    extracted = True
                    data["extracted"] = True
                    journal(name, data)
                    if CANCEL[0]:
                        raise Fail("cancel")
                    now = installed_info(hm, name) or info
                    for rt in runtimes_of(now, port_scripts(now)):
                        if rt in BUILTIN:
                            continue
                        if rt_remote(hm, rt) is None:
                            log(f"{name}: unknown runtime {rt}")
                            unknown = True
                            continue
                        try:
                            fetch_runtime(hm, ctx, rt)
                        except Fail as err:
                            raise Fail(err.why if err.why in ("cancel", "space") else "runtime")
                except BaseException:
                    settle(hm, name, data, fresh, extracted)
                    extracted = None
                    raise
                extracted = None
                drop_journal(name)
                clear_update(name)
                try:
                    gc(hm)
                except Exception as err:
                    log(f"gc: {err}")
        except BaseException as err:
            if extracted is not None:
                settle(hm, name, data, fresh, False)
            if isinstance(err, Exception):
                raise Fail(why_of(err))
            raise
        if unknown:
            raise Fail("unknown-runtime")
    finally:
        write_index()
        write_catalog(hm)


def settle(hm, name, data, fresh, extracted):
    if fresh or not extracted:
        rollback(data)
    if not fresh:
        mark_update(name)
    drop_journal(name)
    hm.load_ports()


def cmd_install(name, ctx):
    do_install(name, ctx, False)


def cmd_update(name, ctx):
    do_install(name, ctx, True)


def cmd_uninstall(name, ctx):
    if not PORT.fullmatch(name):
        raise Fail("other")
    if scope_active():
        raise Fail("busy")
    hm = ctx.open(check=False)
    try:
        with game_lock():
            replay()
            if not installed(hm, name):
                raise Fail("other")
            rc = hm.uninstall_port(name)
            clear_update(name)
            hm.load_ports()
            gc(hm)
        if rc != 0:
            raise Fail("other")
    finally:
        write_index()
        write_catalog(hm)


def cmd_refresh(name, ctx):
    need(IMAGES)
    hmod, feed = ctx.load()
    feed.what = "refresh"
    with feed.enable_cancellable(True):
        try:
            hm = ctx.open(check=True)
        except hmod.CancelEvent:
            raise Fail("cancel")
    if CANCEL[0]:
        raise Fail("cancel")
    write_catalog(hm)


def cmd_index(name, ctx):
    write_index()


def cmd_runtime(name, ctx):
    rt = norm(name)
    if not RUNTIME.fullmatch(rt):
        raise Fail("other")
    if rt in BUILTIN:
        return
    fetch_runtime(ctx.open(check=False), ctx, rt)


def catalogue_md5(rt):
    try:
        with open(RUNTIMES) as f:
            md5 = json.load(f)[rt]["remote"][os.uname().machine]["md5"]
    except (OSError, ValueError, KeyError, TypeError):
        return None
    return md5 if isinstance(md5, str) and MD5.fullmatch(md5) else None


def cmd_unpack(path, ctx):
    rt = os.path.basename(path)
    if (not rt.endswith(".squashfs") or not RUNTIME.fullmatch(rt)
            or os.path.realpath(os.path.dirname(os.path.abspath(path))) != os.path.realpath(LIBS)):
        raise Fail("other")
    final = os.path.join(LIBS, rt)
    try:
        if not stat.S_ISREG(os.lstat(final).st_mode):
            raise Fail("other")
    except FileNotFoundError:
        raise Fail("other")
    md5 = catalogue_md5(rt)
    if md5 is None:
        raise Fail("unknown-runtime")
    if not current(final, md5):
        raise Fail("md5")
    os.makedirs(UNPACKED, 0o755, exist_ok=True)
    unpack_tree(final, md5, ctx.proto)


def read_bytes(path):
    try:
        with open(path, "rb") as f:
            return f.read()
    except FileNotFoundError:
        return b""


def seed(dst, src):
    if not os.path.isdir(src) or os.path.islink(src):
        return
    for e in sorted(os.listdir(src)):
        s = os.path.join(src, e)
        d = os.path.join(dst, e)
        if stat.S_ISREG(os.lstat(s).st_mode) and not os.path.lexists(d):
            shutil.copyfile(s, d)
            os.chmod(d, 0o644)


def cmd_sync(name, ctx):
    try:
        tree = sorted(os.listdir(TREE))
    except FileNotFoundError:
        log(f"no {TREE}")
        raise Fail("other")
    os.makedirs(FARM, 0o755, exist_ok=True)
    wanted = {e: os.path.join(TREE, e) for e in tree if e not in REAL_DIRS and not REAL_FILES.fullmatch(e)}
    wanted.update({e: os.path.join(USR, e) for e in OWN})
    stale = None
    for e in sorted(os.listdir(FARM)):
        p = os.path.join(FARM, e)
        st = os.lstat(p)
        if stat.S_ISLNK(st.st_mode):
            real = e in REAL_DIRS or REAL_FILES.fullmatch(e)
            if real or (e in wanted and os.readlink(p) != wanted[e]) or (e not in wanted and not os.path.exists(p)):
                os.unlink(p)
            continue
        if (e in REAL_DIRS and stat.S_ISDIR(st.st_mode)) or (REAL_FILES.fullmatch(e) and stat.S_ISREG(st.st_mode)):
            continue
        if stale is None:
            stale = os.path.join(STALE, str(time.time_ns()))
            os.makedirs(stale, 0o755)
        log(f"moved {p} to {stale}")
        os.rename(p, os.path.join(stale, e))
    for e, target in sorted(wanted.items()):
        p = os.path.join(FARM, e)
        if not os.path.lexists(p):
            tmp = f"{p}.tmp-{os.getpid()}"
            remove(tmp)
            os.symlink(target, tmp)
            os.replace(tmp, p)
    for d in REAL_DIRS:
        p = os.path.join(FARM, d)
        os.makedirs(p, 0o755, exist_ok=True)
        seed(p, os.path.join(TREE, d))
    if stale is not None:
        for d in sorted(os.listdir(STALE))[:-KEEP_STALE]:
            remove(os.path.join(STALE, d))
    fsync_dir(FARM)
    stamp = read_bytes(os.path.join(USR, "tree.sha256"))
    if read_bytes(STAMP) != stamp or not os.path.isfile(STAMP):
        for e in os.listdir(FARM):
            if e.startswith("device_info_") and e.endswith(".env"):
                os.unlink(os.path.join(FARM, e))
        hmod, _ = ctx.load()
        for fn, src in sorted(hmod.config.HM_SOURCE_DEFAULTS.items()):
            write_atomic(os.path.join(FARM, "config", fn), src.encode())
        write_atomic(STAMP, stamp)
        log(f"synced {FARM} to {TREE}")
    write_index()


COMMANDS = {"sync": (0, cmd_sync), "refresh": (0, cmd_refresh), "index": (0, cmd_index),
            "install": (1, cmd_install), "update": (1, cmd_update), "uninstall": (1, cmd_uninstall),
            "runtime": (1, cmd_runtime), "unpack": (1, cmd_unpack)}
WAITING = ("runtime", "unpack")


def run(argv, proto):
    if len(argv) < 2 or argv[1] not in COMMANDS or len(argv) != 2 + COMMANDS[argv[1]][0] or any(
            CTRL.search(a) for a in argv[2:]):
        log(f"usage: {ME} sync|refresh|index|install <name>|update <name>|uninstall <name>|runtime <name>|"
            f"unpack <file>")
        return 64
    cmd = argv[1]
    arg = argv[2] if len(argv) > 2 else cmd
    name = os.path.basename(arg) if cmd == "unpack" else arg
    CANCEL[0] = False
    signal.signal(signal.SIGTERM, on_term)
    os.umask(0o022)
    os.environ.update(HM_TOOLS_DIR=PORTS, HM_PORTS_DIR=PORTS, HM_SCRIPTS_DIR=PORTS, REQUESTS_CA_BUNDLE=CA,
                      TMPDIR=TMP, controlfolder=FARM)
    lock = None
    try:
        if not os.path.ismount(MOUNT):
            raise Fail("nodata")
        os.makedirs(STATE, 0o755, exist_ok=True)
        os.chdir(PORTS)
        lock = helper_lock(proto, cmd in WAITING)
        empty_tmp()
        COMMANDS[cmd][1](arg, Ctx(proto))
    except Exception as err:
        proto.fail(name, why_of(err))
        return 1
    finally:
        if lock is not None:
            os.close(lock)
    proto.done(name)
    return 0


def main(argv):
    proto = os.dup(1)
    os.dup2(2, 1)
    sys.stdout = sys.stderr
    return run(argv, Proto(proto))


if __name__ == "__main__":
    sys.exit(main(sys.argv))
