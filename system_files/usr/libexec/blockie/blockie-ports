def md5_file(path):
    h = hashlib.md5()
    with open(path, "rb") as f:
        for data in iter(lambda: f.read(1 << 20), b""):
            h.update(data)
    return h.hexdigest()


def read_unindex():
    rows = []
    try:
        with open(UNINDEX) as f:
            lines = f.read().splitlines()
    except FileNotFoundError:
        return rows
    for line in lines:
        r = line.split("\t")
        if len(r) == 5 and all(x.isdigit() for x in r[1:4]) and MD5.fullmatch(r[4]):
            rows.append((r[0], int(r[1]), int(r[2]), int(r[3]), r[4]))
    return rows


def write_unindex(rows):
    write_atomic(UNINDEX, "".join("\t".join(map(str, r)) + "\n" for r in rows).encode())


def lookup(rows, path):
    try:
        st = os.stat(path)
    except FileNotFoundError:
        return None
    name = os.path.basename(path)
    for r in rows:
        if r[:4] == (name, st.st_size, st.st_mtime_ns, st.st_ino):
            return r
    return None


def current(path, md5):
    try:
        st = os.stat(path)
    except FileNotFoundError:
        return False
    if not stat.S_ISREG(st.st_mode):
        return False
    row = lookup(read_unindex(), path)
    if row is not None:
        return row[4] == md5
    return md5_file(path) == md5


def record(path, md5):
    st = os.stat(path)
    name = os.path.basename(path)
    rows = [r for r in read_unindex() if r[0] != name]
    rows.append((name, st.st_size, st.st_mtime_ns, st.st_ino, md5))
    write_unindex(rows)


def seal(top):
    for root, dirs, files in os.walk(top, topdown=False):
        for f in files:
            p = os.path.join(root, f)
            st = os.lstat(p)
            if stat.S_ISREG(st.st_mode):
                os.chmod(p, 0o555 if st.st_mode & 0o111 else 0o444)
        for d in dirs:
            p = os.path.join(root, d)
            if stat.S_ISDIR(os.lstat(p).st_mode):
                os.chmod(p, 0o555)


def hide_fresh(tree, md5):
    for rel in HIDE.get(md5, ()):
        p = os.path.join(tree, rel)
        if os.path.lexists(p):
            os.rename(p, p + HIDDEN)


def hide_old():
    for md5, rels in sorted(HIDE.items()):
        tree = os.path.join(UNPACKED, md5)
        if os.path.islink(tree) or not os.path.isdir(tree):
            continue
        for rel in rels:
            p = os.path.join(tree, rel)
            d = os.path.dirname(p)
            if os.path.islink(d):
                continue
            try:
                shown, hidden = os.path.lexists(p), os.path.lexists(p + HIDDEN)
                if shown and not hidden:
                    os.chmod(d, 0o755)
                    os.rename(p, p + HIDDEN)
                    fsync_dir(d)
                    os.chmod(d, 0o555)
                    log(f"hid {rel} in the runtime tree {md5}")
                elif hidden and not shown:
                    if stat.S_IMODE(os.lstat(d).st_mode) != 0o555:
                        os.chmod(d, 0o555)
                else:
                    log(f"left {rel} in the runtime tree {md5}: {'both names' if shown else 'neither name'} present")
            except OSError as err:
                log(f"cannot hide {rel} in the runtime tree {md5}: {err}")


def unpack_tree(path, md5, proto):
    tree = os.path.join(UNPACKED, md5)
    os.makedirs(UNPACKED, 0o755, exist_ok=True)
    if not os.path.isdir(tree):
        size = os.stat(path).st_size
        need(size * SQUASH_RATIO)
        tmp = f"{tree}.tmp-{os.getpid()}"
        remove(tmp)
        proto.progress("unpack", 0, size)
        with subprocess.Popen([UNSQUASHFS, "-percentage", "-no-xattrs", "-d", tmp, path], stdin=subprocess.DEVNULL,
                              stdout=subprocess.PIPE, text=True, errors="replace") as p:
            for line in p.stdout:
                line = line.strip()
                if line.isdigit() and int(line) <= 100:
                    proto.progress("unpack", size * int(line) // 100, size)
                elif line:
                    log(f"unsquashfs: {line}")
        if p.returncode != 0:
            remove(tmp)
            raise Fail("runtime")
        hide_fresh(tmp, md5)
        seal(tmp)
        os.rename(tmp, tree)
        os.chmod(tree, 0o555)
        fsync_dir(UNPACKED)
    record(path, md5)


