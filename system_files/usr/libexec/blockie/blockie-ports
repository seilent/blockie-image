def md5_file(path):
    h = hashlib.md5()
    with open(path, "rb") as f:
        for data in iter(lambda: f.read(1 << 20), b""):
            h.update(data)
    return h.hexdigest()


def read_unindex():
    rows = []
    try:
        with open(UNINDEX) as f:
            lines = f.read().splitlines()
    except FileNotFoundError:
        return rows
    for line in lines:
        r = line.split("\t")
        if len(r) == 5 and all(x.isdigit() for x in r[1:4]) and MD5.fullmatch(r[4]):
            rows.append((r[0], int(r[1]), int(r[2]), int(r[3]), r[4]))
    return rows


def write_unindex(rows):
    write_atomic(UNINDEX, "".join("\t".join(map(str, r)) + "\n" for r in rows).encode())


def lookup(rows, path):
    try:
        st = os.stat(path)
    except FileNotFoundError:
        return None
    name = os.path.basename(path)
    for r in rows:
        if r[:4] == (name, st.st_size, st.st_mtime_ns, st.st_ino):
            return r
    return None


def current(path, md5):
    try:
        st = os.stat(path)
    except FileNotFoundError:
        return False
    if not stat.S_ISREG(st.st_mode):
        return False
    row = lookup(read_unindex(), path)
    if row is not None:
        return row[4] == md5
    return md5_file(path) == md5


def record(path, md5):
    st = os.stat(path)
    name = os.path.basename(path)
    rows = [r for r in read_unindex() if r[0] != name]
    rows.append((name, st.st_size, st.st_mtime_ns, st.st_ino, md5))
    write_unindex(rows)


def seal(top):
    for root, dirs, files in os.walk(top, topdown=False):
        for f in files:
            p = os.path.join(root, f)
            st = os.lstat(p)
            if stat.S_ISREG(st.st_mode):
                os.chmod(p, 0o555 if st.st_mode & 0o111 else 0o444)
        for d in dirs:
            p = os.path.join(root, d)
            if stat.S_ISDIR(os.lstat(p).st_mode):
                os.chmod(p, 0o555)


def unpack_tree(path, md5, proto):
    tree = os.path.join(UNPACKED, md5)
    os.makedirs(UNPACKED, 0o755, exist_ok=True)
    if not os.path.isdir(tree):
        size = os.stat(path).st_size
        need(size * SQUASH_RATIO)
        tmp = f"{tree}.tmp-{os.getpid()}"
        remove(tmp)
        proto.progress("unpack", 0, size)
        with subprocess.Popen([UNSQUASHFS, "-percentage", "-no-xattrs", "-d", tmp, path], stdin=subprocess.DEVNULL,
                              stdout=subprocess.PIPE, text=True, errors="replace") as p:
            for line in p.stdout:
                line = line.strip()
                if line.isdigit() and int(line) <= 100:
                    proto.progress("unpack", size * int(line) // 100, size)
                elif line:
                    log(f"unsquashfs: {line}")
        if p.returncode != 0:
            remove(tmp)
            raise Fail("runtime")
        seal(tmp)
        os.rename(tmp, tree)
        os.chmod(tree, 0o555)
        fsync_dir(UNPACKED)
    record(path, md5)


def journal(name, data):
    os.makedirs(TXN, 0o755, exist_ok=True)
    write_atomic(os.path.join(TXN, name), json.dumps(data).encode())


def drop_journal(name):
    remove(os.path.join(TXN, name))


def mark_update(name):
    os.makedirs(UPDATES, 0o755, exist_ok=True)
    os.close(os.open(os.path.join(UPDATES, name), os.O_WRONLY | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW, 0o644))


def clear_update(name):
    remove(os.path.join(UPDATES, name))


def rollback(data):
    for p in reversed(data.get("new", [])):
        if inside(p):
            remove(p)


def replay():
    try:
        names = sorted(os.listdir(TXN))
    except FileNotFoundError:
        return
    for n in names:
        p = os.path.join(TXN, n)
        if ".tmp-" not in n:
            try:
                with open(p) as f:
                    data = json.load(f)
                update = data.get("op") == "update"
                if not (update and data.get("extracted")):
                    rollback(data)
                if update and PORT.fullmatch(str(data.get("name"))):
                    mark_update(data["name"])
                log(f"replayed the journal of {n}")
            except (OSError, ValueError, AttributeError, TypeError) as err:
                log(f"dropped the unreadable journal {n}: {err}")
        remove(p)
    fsync_dir(TXN)


def whole(v):
    return v.encode("utf-8", "replace").decode() if isinstance(v, str) else v


def text(v):
    return CTRL.sub(" ", whole(v)).strip() if isinstance(v, str) else ""


def body(v):
    return BODY.sub(" ", whole(v)).strip() if isinstance(v, str) else ""


def join_list(v):
    if isinstance(v, str):
        v = [v]
    return "\t".join(t for t in (text(x) for x in v or []) if t) if isinstance(v, list) else ""


def norm(name):
    return name if name.endswith(".squashfs") else name + ".squashfs"


def port_scripts(info):
    out = []
    for key in ("items", "items_opt"):
        items = info.get(key)
        for i in items if isinstance(items, list) else []:
            if isinstance(i, str) and "/" not in i and i.lower().endswith(".sh"):
                out.append(os.path.join(PORTS, i))
    return out


def runtimes_of(info, scripts):
    names = []

    def add(n):
        n = norm(n)
        if RUNTIME.fullmatch(n) and n not in names:
            names.append(n)

    attr = info.get("attr") if isinstance(info.get("attr"), dict) else {}
    rts = attr.get("runtime") or []
    for r in [rts] if isinstance(rts, str) else rts:
        if isinstance(r, str):
            add(r)
    for s in scripts:
        try:
            with open(s, encoding="utf-8", errors="replace") as f:
                src = f.read()
        except OSError:
            continue
        for rx in SCAN:
            for m in rx.finditer(src):
                add(m.group(1))
    return names


def cover_of(port_dir, attr):
    image = attr.get("image") if isinstance(attr.get("image"), dict) else {}
    covers = image.get("covers") if isinstance(image.get("covers"), list) else []
    for c in covers + [image.get("screenshot")] + list(COVERS):
        if not isinstance(c, str) or "/" in c or c in ("", ".", "..") or CTRL.search(c):
            continue
        if not c.lower().endswith((".png", ".jpg", ".jpeg")):
            continue
        p = os.path.join(port_dir, c)
        try:
            if stat.S_ISREG(os.lstat(p).st_mode):
                return p
        except FileNotFoundError:
            pass
    return None


def utf8(name):
    try:
        name.encode()
    except UnicodeEncodeError:
        return False
    return True


def write_index():
    owners = {}
    names = sorted(n for n in os.listdir(PORTS) if utf8(n))
    for d in names:
        port_dir = os.path.join(PORTS, d)
        if d in KEEP or CTRL.search(port_dir) or not stat.S_ISDIR(os.lstat(port_dir).st_mode):
            continue
        try:
            with open(os.path.join(port_dir, "port.json"), encoding="utf-8") as f:
                info = json.load(f)
        except (OSError, ValueError):
            continue
        if not isinstance(info, dict):
            continue
        scripts = [os.path.basename(s) for s in port_scripts({"items": info.get("items")})]
        attr = info.get("attr") if isinstance(info.get("attr"), dict) else {}
        title = text(attr.get("title")) if len(scripts) == 1 else ""
        cover = cover_of(port_dir, attr)
        if cover is not None and not utf8(cover):
            cover = None
        for s in scripts:
            owners.setdefault(s.casefold(), (title, port_dir, cover))
    lines = []
    for f in names:
        p = os.path.join(PORTS, f)
        if not f.endswith(".sh") or f.startswith(".") or CTRL.search(f) or not stat.S_ISREG(os.lstat(p).st_mode):
            continue
        stem = f[:-3]
        title, port_dir, cover = owners.get(f.casefold(), ("", None, None))
        lines.append("\t".join((stem, title or stem, port_dir or "-", cover or "-")) + "\n")
    write_atomic(INDEX, "".join(lines).encode())


def image(p):
    if p is None:
        return None
    p = str(p)
    if SAFE_IMAGE.fullmatch(os.path.basename(p)) and not CTRL.search(p) and os.path.isfile(p):
        return p
    return None


def write_catalog(hm):
    rows = []
    seen = set()
    hidden = {"reqs": 0, "exp": 0}
    try:
        marks = set(os.listdir(UPDATES))
    except FileNotFoundError:
        marks = set()
    for src in hm.sources.values():
        for name in src.ports:
            if name in seen:
                continue
            seen.add(name)
            info = hm.port_info(name)
            if not info:
                continue
            if not hm.match_requirements(info):
                hidden["reqs"] += 1
                continue
            attrs = hm.port_info_attrs(info)
            if "exp" in attrs and not hm.cfg_data.get("show_experimental", False):
                hidden["exp"] += 1
                continue
            attr = info.get("attr") if isinstance(info.get("attr"), dict) else {}
            source = info.get("source") if isinstance(info.get("source"), dict) else {}
            size = source.get("size")
            images = hm.port_images(name) or {}
            rows.append((name, text(attr.get("title")) or name, join_list(attr.get("genres")),
                         join_list(attr.get("porter")), body(attr.get("desc")), body(attr.get("inst")),
                         size if isinstance(size, int) and not isinstance(size, bool) else 0,
                         text(attr.get("availability")), join_list(attr.get("runtime")),
                         int("installed" in attrs), int("update available" in attrs or name in marks),
                         image(images.get("screenshot")), image(images.get("cover"))))
    log(f"catalog: {len(rows)} ports, hidden: {hidden['reqs']} by requirements, {hidden['exp']} experimental")
    tmp = f"{CATALOG}.tmp-{os.getpid()}"
    remove(tmp)
    db = sqlite3.connect(tmp)
    try:
        db.execute("CREATE TABLE ports (name TEXT PRIMARY KEY, title TEXT, genres TEXT, porter TEXT, "
                   "description TEXT, inst TEXT, size INTEGER, availability TEXT, runtimes TEXT, "
                   "installed INTEGER, update_available INTEGER, screenshot TEXT, cover TEXT)")
        db.executemany("INSERT INTO ports VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)", rows)
        db.commit()
    finally:
        db.close()
    fsync_file(tmp)
    os.replace(tmp, CATALOG)
    fsync_dir(STATE)


