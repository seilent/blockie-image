def rt_remote(hm, rt):
    remote = hm.runtimes_info.get(rt, {}).get("remote", {}).get(hm.device.get("primary_arch", "aarch64"))
    if isinstance(remote, dict) and isinstance(remote.get("md5"), str) and isinstance(remote.get("url"), str):
        return remote
    return None


def fetch_runtime(hm, ctx, rt):
    hmod, feed = ctx.load()
    remote = rt_remote(hm, rt)
    if remote is None:
        raise Fail("unknown-runtime")
    md5 = remote["md5"]
    final = os.path.join(LIBS, rt)
    if current(final, md5):
        unpack_tree(final, md5, ctx.proto)
        return
    if hm.config["offline"]:
        raise Fail("network")
    size = remote.get("size") if isinstance(remote.get("size"), int) else 0
    need(size * (1 + SQUASH_RATIO))
    os.makedirs(PART, 0o755, exist_ok=True)
    os.makedirs(UNPACKED, 0o755, exist_ok=True)
    part = os.path.join(PART, f"{rt}.{os.getpid()}")
    tmp = os.path.join(UNPACKED, f"{md5}.tmp-{os.getpid()}")
    journal(rt, {"op": "runtime", "name": rt, "new": [part, tmp]})
    try:
        res = [None]
        feed.what = "runtime"
        with feed.enable_cancellable(True):
            try:
                got = hmod.download(Path(part), remote["url"], md5_result=res, callback=feed, no_check=True)
            except hmod.CancelEvent:
                raise Fail("cancel")
        if CANCEL[0]:
            raise Fail("cancel")
        if got is None:
            raise Fail("network")
        if res[0] != md5:
            raise Fail("md5")
        fsync_file(part)
        os.replace(part, final)
        fsync_dir(LIBS)
        unpack_tree(final, md5, ctx.proto)
    except BaseException:
        remove(part)
        remove(tmp)
        drop_journal(rt)
        raise
    drop_journal(rt)


def gc(hm):
    rows = read_unindex()
    named = set()
    for info in list(hm.installed_ports.values()) + list(hm.broken_ports.values()):
        for rt in runtimes_of(info, port_scripts(info)):
            row = lookup(rows, os.path.join(LIBS, rt))
            if row is not None:
                named.add(row[4])
    now = time.time()
    try:
        entries = os.listdir(UNPACKED)
    except FileNotFoundError:
        entries = []
    for e in entries:
        p = os.path.join(UNPACKED, e)
        if ".tmp-" in e:
            remove(p)
            continue
        if not MD5.fullmatch(e) or e in named:
            continue
        try:
            used = os.stat(p + ".used").st_mtime
        except FileNotFoundError:
            used = os.lstat(p).st_mtime
        if now - used > GC_S:
            log(f"removed the unused runtime tree {e}")
            remove(p)
            remove(p + ".used")
    try:
        for e in os.listdir(PART):
            remove(os.path.join(PART, e))
    except FileNotFoundError:
        pass
    if entries:
        write_unindex([r for r in rows if os.path.isdir(os.path.join(UNPACKED, r[4]))])


def why_of(err):
    if isinstance(err, Fail):
        return err.why
    if isinstance(err, OSError) and err.errno == errno.ENOSPC:
        return "space"
    if QUIET[0]:
        own = [f for f in traceback.extract_tb(err.__traceback__) if f.filename == __file__]
        log(f"{type(err).__name__} at line {own[-1].lineno if own else '-'}")
    else:
        log(traceback.format_exc())
    return "other"


def find_port(hm, name):
    if name == "portmaster.zip" or any(name in s.utils for s in hm.sources.values()):
        raise Fail("other")
    for src in hm.sources.values():
        if name in src.ports:
            return src
    raise Fail("other")


def zip_parts(path):
    with zipfile.ZipFile(path) as zf:
        infos = zf.infolist()
    total = sum(i.file_size for i in infos)
    tops = set()
    for i in infos:
        n = i.filename.replace("\\", "/")
        first = n.split("/", 1)[0]
        if first in ("", ".", ".."):
            continue
        if "/" in n:
            tops.add(first)
        elif n.lower().endswith(".sh"):
            tops.add(n)
    return total, sorted(tops)


def do_install(name, ctx, update):
    if not PORT.fullmatch(name):
        raise Fail("other")
    if scope_active():
        raise Fail("busy")
    hmod, feed = ctx.load()
    hm = ctx.open(check=False)
    try:
        with game_lock():
            replay()
        src = find_port(hm, name)
        fresh = not installed(hm, name)
        if update and fresh:
            raise Fail("other")
        if hm.config["offline"]:
            raise Fail("network")
        info = src.port_info(name)
        source = info.get("source") if isinstance(info.get("source"), dict) else {}
        size = source.get("size") if isinstance(source.get("size"), int) else 0
        wanted = runtimes_of(info, port_scripts(installed_info(hm, name)))
        rt_bytes = 0
        for rt in wanted:
            remote = None if rt in BUILTIN else rt_remote(hm, rt)
            if remote is not None and not current(os.path.join(LIBS, rt), remote["md5"]):
                rt_bytes += (remote.get("size") if isinstance(remote.get("size"), int) else 0) * (1 + SQUASH_RATIO)
        need(2 * size + rt_bytes)
        data = {"op": "install" if fresh else "update", "name": name, "new": []}
        zip_path = os.path.join(PORTS, name)
        if size > hmod.config.HM_MAX_TEMP_SIZE and not os.path.lexists(zip_path):
            data["new"].append(zip_path)
        journal(name, data)
        extracted = False
        unknown = False
        try:
            feed.what = "download"
            with feed.enable_cancellable(True):
                try:
                    dl = src.download(name)
                except hmod.CancelEvent:
                    raise Fail("cancel")
            if dl is not None and CANCEL[0]:
                remove(str(dl["zip_file"]))
            if CANCEL[0]:
                raise Fail("cancel")
            if dl is None:
                raise Fail("network")
            try:
                total, tops = zip_parts(dl["zip_file"])
            except zipfile.BadZipFile:
                remove(str(dl["zip_file"]))
                raise Fail("other")
            try:
                need(total + rt_bytes)
            except Fail:
                remove(str(dl["zip_file"]))
                raise
            for t in tops:
                p = os.path.join(PORTS, t)
                if not os.path.lexists(p):
                    data["new"].append(p)
                elif os.path.isdir(p) and not os.path.lexists(os.path.join(p, "port.json")):
                    data["new"].append(os.path.join(p, "port.json"))
            journal(name, data)
            with game_lock():
                try:
                    feed.what = "install"
                    with feed.enable_cancellable(False):
                        rc = hm._install_port(dl, do_delete=True)
                    if rc != 0:
                        raise Fail("other")
                    hm.load_ports()
                    extracted = True
                    data["extracted"] = True
                    journal(name, data)
                    if CANCEL[0]:
                        raise Fail("cancel")
                    now = installed_info(hm, name) or info
                    for rt in runtimes_of(now, port_scripts(now)):
                        if rt in BUILTIN:
                            continue
                        if rt_remote(hm, rt) is None:
                            log(f"{name}: unknown runtime {rt}")
                            unknown = True
                            continue
                        try:
                            fetch_runtime(hm, ctx, rt)
                        except Fail as err:
                            raise Fail(err.why if err.why in ("cancel", "space") else "runtime")
                except BaseException:
                    settle(hm, name, data, fresh, extracted)
                    extracted = None
                    raise
                extracted = None
                drop_journal(name)
                clear_update(name)
                try:
                    gc(hm)
                except Exception as err:
                    log(f"gc: {err}")
        except BaseException as err:
            if extracted is not None:
                settle(hm, name, data, fresh, False)
            if isinstance(err, Exception):
                raise Fail(why_of(err))
            raise
        if unknown:
            raise Fail("unknown-runtime")
    finally:
        write_index()
        write_catalog(hm)


def settle(hm, name, data, fresh, extracted):
    if fresh or not extracted:
        rollback(data)
    if not fresh:
        mark_update(name)
    drop_journal(name)
    hm.load_ports()


