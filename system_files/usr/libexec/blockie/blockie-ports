def fsync_dir(path):
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def fsync_file(path):
    fd = os.open(path, os.O_RDONLY | os.O_CLOEXEC)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def write_atomic(path, data, mode=0o644):
    tmp = f"{path}.tmp-{os.getpid()}"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_CLOEXEC | os.O_NOFOLLOW, mode)
    try:
        try:
            os.fchmod(fd, mode)
            view = memoryview(data)
            while view:
                view = view[os.write(fd, view):]
            os.fsync(fd)
        finally:
            os.close(fd)
        os.replace(tmp, path)
    except BaseException:
        remove(tmp)
        raise
    fsync_dir(os.path.dirname(path))


def unit_root(path):
    real = os.path.realpath(path)
    return any(real == r or real.startswith(r + "/") for r in (os.path.realpath(STEAM_DIR), os.path.realpath(STEAM_DL)))


def remove(path):
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        return
    if not stat.S_ISDIR(st.st_mode):
        os.unlink(path)
        return
    if unit_root(path):
        raise OSError(errno.EPERM, "a Steam unit root is removed only by the unit")
    uid = os.getuid()
    for root, dirs, files in os.walk(path):
        st = os.lstat(root)
        if st.st_uid == uid:
            os.chmod(root, stat.S_IMODE(st.st_mode) | 0o700)
    shutil.rmtree(path)


def inside(path):
    if not isinstance(path, str) or not os.path.isabs(path):
        return False
    path = os.path.normpath(path)
    base = os.path.basename(path)
    parent = os.path.realpath(os.path.dirname(path))
    ports = os.path.realpath(PORTS)
    if base in ("", ".", "..") or (parent == ports and base in KEEP):
        return False
    return (parent + "/").startswith(ports + "/")


