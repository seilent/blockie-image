def open_lock(path):
    return os.open(path, os.O_RDWR | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW, 0o644)


def helper_lock(proto, wait):
    fd = open_lock(os.path.join(STATE, "lock"))
    end = time.monotonic() + WAIT_S
    shown = None
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return fd
        except BlockingIOError:
            pass
        now = time.monotonic()
        if not wait or now >= end or CANCEL[0]:
            os.close(fd)
            raise Fail("cancel" if CANCEL[0] else "busy")
        waited = int(WAIT_S - (end - now))
        if waited != shown:
            proto.progress("wait", waited, int(WAIT_S))
            shown = waited
        time.sleep(0.2)


@contextlib.contextmanager
def game_lock():
    run = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    fd = open_lock(os.path.join(run, "blockie-game.lock"))
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise Fail("busy")
        yield
    finally:
        os.close(fd)


