def seed(dst, src):
    if not os.path.isdir(src) or os.path.islink(src):
        return
    for e in sorted(os.listdir(src)):
        s = os.path.join(src, e)
        d = os.path.join(dst, e)
        if stat.S_ISREG(os.lstat(s).st_mode) and not os.path.lexists(d):
            shutil.copyfile(s, d)
            os.chmod(d, 0o644)


def cmd_sync(name, ctx):
    try:
        tree = sorted(os.listdir(TREE))
    except FileNotFoundError:
        log(f"no {TREE}")
        raise Fail("other")
    os.makedirs(FARM, 0o755, exist_ok=True)
    wanted = {e: os.path.join(TREE, e) for e in tree if e not in REAL_DIRS and not REAL_FILES.fullmatch(e)}
    wanted.update({e: os.path.join(USR, e) for e in OWN})
    stale = None
    for e in sorted(os.listdir(FARM)):
        p = os.path.join(FARM, e)
        st = os.lstat(p)
        if stat.S_ISLNK(st.st_mode):
            real = e in REAL_DIRS or REAL_FILES.fullmatch(e)
            if real or (e in wanted and os.readlink(p) != wanted[e]) or (e not in wanted and not os.path.exists(p)):
                os.unlink(p)
            continue
        if (e in REAL_DIRS and stat.S_ISDIR(st.st_mode)) or (REAL_FILES.fullmatch(e) and stat.S_ISREG(st.st_mode)):
            continue
        if stale is None:
            stale = os.path.join(STALE, str(time.time_ns()))
            os.makedirs(stale, 0o755)
        log(f"moved {p} to {stale}")
        os.rename(p, os.path.join(stale, e))
    for e, target in sorted(wanted.items()):
        p = os.path.join(FARM, e)
        if not os.path.lexists(p):
            tmp = f"{p}.tmp-{os.getpid()}"
            remove(tmp)
            os.symlink(target, tmp)
            os.replace(tmp, p)
    for d in REAL_DIRS:
        p = os.path.join(FARM, d)
        os.makedirs(p, 0o755, exist_ok=True)
        seed(p, os.path.join(TREE, d))
    if stale is not None:
        for d in sorted(os.listdir(STALE))[:-KEEP_STALE]:
            remove(os.path.join(STALE, d))
    fsync_dir(FARM)
    stamp = read_bytes(os.path.join(USR, "tree.sha256"))
    if read_bytes(STAMP) != stamp or not os.path.isfile(STAMP):
        for e in os.listdir(FARM):
            if e.startswith("device_info_") and e.endswith(".env"):
                os.unlink(os.path.join(FARM, e))
        hmod, _ = ctx.load()
        for fn, src in sorted(hmod.config.HM_SOURCE_DEFAULTS.items()):
            write_atomic(os.path.join(FARM, "config", fn), src.encode())
        write_atomic(STAMP, stamp)
        log(f"synced {FARM} to {TREE}")
    hide_old()
    write_index()


def uid_of(user):
    try:
        return pwd.getpwnam(user).pw_uid
    except KeyError:
        return None


def rel_ok(p):
    return (isinstance(p, str) and p != "" and not p.startswith("/") and not CTRL.search(p)
            and all(x not in ("", ".", "..") for x in p.split("/")))


def read_lines(path, limit=16 << 20):
    try:
        with open(path, "rb") as f:
            raw = f.read(limit + 1)
    except OSError:
        return None
    if len(raw) > limit:
        return None
    try:
        return raw.decode("utf-8").splitlines()
    except UnicodeDecodeError:
        return None


def map_list(name, kind):
    lines = read_lines(os.path.join(STEAM_LISTS, name))
    if lines is None:
        return None
    out = []
    for e in (x for x in lines if x):
        if kind == "files" and e.startswith("regex:"):
            try:
                re.compile(e[6:])
            except re.error:
                return None
        elif not rel_ok(e):
            return None
        out.append(e)
    return out


def map_row(r):
    if len(r) != 12:
        return None
    port, md5, app, os_name, depots, manifests, branch, into, files, move, keep, check = r
    if not (PORT.fullmatch(port) and (md5 == "-" or MD5.fullmatch(md5)) and DIGITS.fullmatch(app) and os_name in OSES):
        return None
    deps = depots.split(",")
    if not all(DIGITS.fullmatch(d) for d in deps):
        return None
    mans = [] if manifests == "-" else manifests.split(",")
    if mans and (len(mans) != len(deps) or not all(DIGITS.fullmatch(x) for x in mans)):
        return None
    if (branch != "-" and not BRANCH.fullmatch(branch)) or not rel_ok(into) or (check != "-" and not rel_ok(check)):
        return None
    lists = {}
    for kind, v in (("files", files), ("move", move), ("keep", keep)):
        if v == "-":
            continue
        entries = map_list(v, kind) if LIST_NAME.fullmatch(v) else None
        if entries is None:
            return None
        lists[kind] = entries
    if "move" in lists:
        return None
    h = hashlib.sha256("\t".join((app, os_name, depots, manifests, branch, into, files, move)).encode())
    for kind in ("files", "move"):
        h.update(("\n" + "\n".join(lists.get(kind, []))).encode())
    return {"port": port, "md5": None if md5 == "-" else md5, "app": app, "os": os_name, "depots": deps,
            "manifests": mans, "branch": None if branch == "-" else branch, "into": into,
            "files": None if files == "-" else files, "keep": set(lists.get("keep", [])),
            "check": None if check == "-" else check, "digest": h.hexdigest()}


def load_map():
    rows = {}
    lines = read_lines(STEAM_MAP)
    for n, line in enumerate(lines or [], 1):
        if not line or line.startswith("#"):
            continue
        row = map_row(line.split("\t"))
        if row is None or row["port"] in rows:
            log(f"steam map: line {n} dropped")
            continue
        rows[row["port"]] = row
    return rows


def steam_app(attr):
    stores = attr.get("store") if isinstance(attr.get("store"), list) else []
    for st in stores:
        for k in ("gameurl", "url"):
            v = st.get(k) if isinstance(st, dict) else None
            m = APP_URL.search(v) if isinstance(v, str) else None
            if m:
                return m.group(1)
    inst = attr.get("inst") if isinstance(attr.get("inst"), str) else ""
    m = APP_URL.search(inst) or APP_DEPOT.search(inst)
    return next((g for g in m.groups() if g), None) if m else None


def read_apps():
    apps = {}
    for line in read_lines(APPS) or []:
        r = line.split("\t")
        if len(r) == 3 and PORT.fullmatch(r[0]):
            apps[r[0]] = (r[1] if DIGITS.fullmatch(r[1]) else None, r[2] if MD5.fullmatch(r[2]) else None)
    return apps


def installed_dirs():
    out = {}
    try:
        names = sorted(n for n in os.listdir(PORTS) if utf8(n))
    except FileNotFoundError:
        return out
    for d in names:
        if d in KEEP or CTRL.search(d):
            continue
        try:
            if not stat.S_ISDIR(os.lstat(os.path.join(PORTS, d)).st_mode):
                continue
            with open(os.path.join(PORTS, d, "port.json"), encoding="utf-8") as f:
                info = json.load(f)
        except (OSError, ValueError):
            continue
        name = info.get("name") if isinstance(info, dict) else None
        if isinstance(name, str) and PORT.fullmatch(name):
            out.setdefault(name, set()).add(d)
    return out


def updates_offered():
    try:
        names = set(os.listdir(UPDATES))
    except FileNotFoundError:
        names = set()
    if os.path.isfile(CATALOG):
        try:
            db = sqlite3.connect(f"file:{CATALOG}?mode=ro", uri=True)
            try:
                names |= {r[0] for r in db.execute("SELECT name FROM ports WHERE update_available = 1")}
            finally:
                db.close()
        except sqlite3.Error:
            pass
    return names


def read_signed():
    try:
        with open(os.path.join(STEAM_DL, "signed")) as f:
            return f.read(64).strip() == "signed 1"
    except OSError:
        return False


def mark(name, kind):
    return os.path.join(STEAM_STATE, f"{name}.{kind}")


def read_json(path):
    try:
        with open(path) as f:
            data = json.load(f)
    except (OSError, ValueError):
        return None
    return data if isinstance(data, dict) else None


def row_offered(name, row, apps, dirs, updates):
    if row is None or name not in dirs or name in updates or os.path.lexists(mark(name, "owned")):
        return False
    if row["into"].split("/", 1)[0] not in dirs[name]:
        return False
    app, md5 = apps.get(name, (None, None))
    if app is not None and app != row["app"]:
        return False
    return row["md5"] is None or row["md5"] == md5


def row_got(name, row):
    got = read_json(mark(name, "got"))
    if got is None or got.get("digest") != row["digest"] or not isinstance(got.get("placed"), list):
        return False
    if row["check"] is not None:
        return os.path.lexists(os.path.join(PORTS, row["check"]))
    return any(rel_ok(p) and os.path.lexists(os.path.join(PORTS, p)) for p in got["placed"])


def write_steam_tsv():
    rows = load_map()
    apps = read_apps()
    dirs = installed_dirs()
    updates = updates_offered()
    lines = [f"signed\t{int(read_signed())}\n"]
    for name in sorted(dirs):
        if row_offered(name, rows.get(name), apps, dirs, updates):
            lines.append(f"port\t{name}\t{'got' if row_got(name, rows[name]) else 'get'}\n")
    write_atomic(STEAM_TSV, "".join(lines).encode())


def clear_owned():
    try:
        names = os.listdir(STEAM_STATE)
    except FileNotFoundError:
        return
    for n in names:
        if n.endswith(".owned"):
            remove(os.path.join(STEAM_STATE, n))


def systemctl(*args, timeout=60, out=False):
    try:
        r = subprocess.run([SYSTEMCTL, *args], stdin=subprocess.DEVNULL, capture_output=True, text=True,
                           timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as err:
        log(f"systemctl {args[0]}: {type(err).__name__}")
        return None
    return r.stdout.strip() if out else r.returncode


def unit_active(inst):
    return systemctl("is-active", "--quiet", UNIT.format(inst), timeout=10) == 0


def stop_units():
    systemctl("stop", UNIT.format("*"), timeout=30)


def request(inst, data):
    path = os.path.join(STEAM_REQ, inst)
    write_atomic(path, json.dumps(data).encode(), 0o640)
    return path


def steam_op(inst, op, **extra):
    req = request(inst, dict(op=op, port=None if inst == ACCOUNT else inst, **extra))
    try:
        if systemctl("start", "--wait", UNIT.format(inst), timeout=600) != 0:
            raise Fail("other")
    finally:
        remove(req)


def idle_hold():
    try:
        with open(INHIBIT_PID) as f:
            pid = int(f.read(32))
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            argv = f.read().split(b"\0")
        if os.path.realpath(f"/proc/{pid}/exe") == os.path.realpath(INHIBIT) and b"--who=blockie-ports" in argv:
            os.kill(pid, signal.SIGKILL)
    except (OSError, ValueError):
        pass
    remove(INHIBIT_PID)
    r, w = os.pipe()
    try:
        p = subprocess.Popen([SETPRIV, "--pdeathsig", "KILL", "--", INHIBIT, "--what=idle", "--mode=block",
                              "--who=blockie-ports", "--why=get files", "cat"], stdin=r, stdout=subprocess.DEVNULL,
                             stderr=sys.stderr, close_fds=True)
    except OSError as err:
        log(f"idle hold: {type(err).__name__}, the get goes on without it")
        os.close(w)
        return None
    finally:
        os.close(r)
    write_atomic(INHIBIT_PID, f"{p.pid}\n".encode(), 0o600)
    return p, w


def idle_release(hold):
    if hold is None:
        return
    p, w = hold
    os.close(w)
    try:
        rc = p.wait(timeout=5)
    except subprocess.TimeoutExpired:
        p.kill()
        rc = p.wait()
    if rc != 0:
        log(f"idle hold ended with {rc}, the get went on without it")
    remove(INHIBIT_PID)


def owned_depot(f):
    return len(f) == 4 and f[1:3] == ["owned", "depot"] and bool(DIGITS.fullmatch(f[3]))


class Run:
    def __init__(self):
        self.end = False
        self.total = None
        self.fail = None
        self.rc = None
        self.stopped = None
        self.got = False
        self.signed_in = False
        self.seen = False


def open_fifo(inst):
    path = os.path.join(STEAM_RUN, f"{inst}.fifo")
    uid = uid_of(STEAM_USER)
    end = time.monotonic() + 10
    while time.monotonic() < end and not CANCEL[0]:
        try:
            fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)
        except FileNotFoundError:
            if not unit_active(inst):
                return None
            time.sleep(0.1)
            continue
        st = os.fstat(fd)
        if not stat.S_ISFIFO(st.st_mode) or uid is None or st.st_uid != uid:
            os.close(fd)
            log(f"{inst}: the channel is not a FIFO of {STEAM_USER}")
            raise Fail("other")
        return fd
    return None


def steam_dd(proto, op, name, login, paths=None, total=None, extra=None, on_line=None):
    inst = name
    run = Run()
    req = request(inst, {"op": op, "port": name, "login": login, "paths": paths, **(extra or {})})
    qr_run = op == "pass" and login == "qr"
    stall = max(STALL_S, (SCAN_S if op == "scan" else LIBRARY_RUN_S) + 30) if op in LIB_OPS else STALL_S
    if op in ("pass", "get"):
        proto.progress("login" if qr_run else "check" if op == "pass" else "download", 0, total)
    t0 = time.monotonic()
    first = None
    if systemctl("start", UNIT.format(inst), timeout=60) != 0:
        remove(req)
        raise Fail("other")
    try:
        fd = open_fifo(inst)
    except Fail:
        stop_units()
        remove(req)
        raise
    if fd is None:
        stop_units()
        remove(req)
        run.stopped = "cancel" if CANCEL[0] else None
        return run
    buf = b""
    qr_at = last_qr = None
    signing = qr_run
    changed = time.monotonic()
    tick = 0
    checked = 0.0
    alive = time.monotonic()
    fifo = os.path.join(STEAM_RUN, f"{inst}.fifo")
    poller = select.poll()
    poller.register(fd, select.POLLIN)
    try:
        while True:
            events = poller.poll(250)
            eof = False
            while events:
                data = os.read(fd, LINE_MAX)
                if not data:
                    eof = True
                    break
                buf += data
                if len(buf) > LINE_MAX and b"\n" not in buf:
                    break
                *lines, buf = buf.split(b"\n")
                for raw in lines:
                    run.seen = True
                    if first is None:
                        first = time.monotonic() - t0
                    changed = time.monotonic()
                    f = raw.decode("utf-8", "replace").split("\t")
                    kind = f[0]
                    if kind == "qr" and signing:
                        if len(f) == 2 and QR_URL.fullmatch(f[1]) and len(f[1]) <= 512:
                            now = time.monotonic()
                            if qr_at is None:
                                qr_at = now
                                host = f[1][8:].split("/", 1)[0]
                                log(f"qr host {host if re.fullmatch(r'[A-Za-z0-9.-]{1,64}', host) else '-'} len {len(f[1])}")
                                proto.progress("login", 0, int(LOGIN_S))
                            else:
                                log(f"qr gap {now - last_qr:.1f} s len {len(f[1])}")
                            last_qr = now
                            proto.line("qr", f[1])
                        else:
                            log(f"qr refused {len(raw) - 3}")
                    elif kind == "exp" and len(f) == 2 and signing:
                        signing = False
                        run.signed_in = True
                        log(f"exp {f[1] if DIGITS.fullmatch(f[1]) else '-'}")
                        proto.progress("check", 0, None)
                    elif kind == "total" and len(f) == 2 and DIGITS.fullmatch(f[1]):
                        run.total = int(f[1])
                    elif kind == "got" and len(f) == 2 and DIGITS.fullmatch(f[1]):
                        run.got = True
                        proto.progress("download", min(int(f[1]), total or 0), total)
                    elif kind == "end" and len(f) == 1:
                        run.end = True
                    elif kind == "fail" and (len(f) in (2, 3) or owned_depot(f)):
                        run.fail = run.fail or " ".join(f[1:])
                    elif kind in ("scan", "scanned", "scanfail") and on_line is not None:
                        on_line(f)
                    elif kind == "rc" and len(f) == 2 and re.fullmatch(r"-?[0-9]+", f[1]):
                        run.rc = int(f[1])
                        peak = systemctl("show", "-p", "MemoryPeak", "--value", UNIT.format(inst), timeout=10, out=True)
                        log(f"{inst} {op}: rc {run.rc}, MemoryPeak {peak or '-'}, first line after "
                            f"{'-' if first is None else f'{first:.1f} s'}")
                events = poller.poll(0)
            if eof:
                break
            if len(buf) > LINE_MAX and b"\n" not in buf:
                log(f"{inst}: a channel line over {LINE_MAX} bytes")
                run.stopped = "other"
                systemctl("stop", UNIT.format(inst), timeout=30)
                break
            now = time.monotonic()
            if first is None and now - alive >= 2:
                alive = now
                if not unit_active(inst):
                    break
                try:
                    moved = os.stat(fifo).st_ino != os.fstat(fd).st_ino
                except FileNotFoundError:
                    moved = False
                if moved:
                    poller.unregister(fd)
                    os.close(fd)
                    fd = -1
                    fd = open_fifo(inst) or -1
                    if fd < 0:
                        break
                    poller.register(fd, select.POLLIN)
            if CANCEL[0]:
                run.stopped = "cancel"
            elif signing and qr_at is not None and now - qr_at >= LOGIN_S:
                run.stopped = "expired"
            elif not (signing and qr_at is not None) and now - changed >= stall:
                run.stopped = "network"
            elif op == "get" and now - checked >= 2:
                checked = now
                if free_bytes() <= FLOOR:
                    run.stopped = "space"
            if run.stopped:
                systemctl("stop", UNIT.format(inst), timeout=30)
                break
            if signing and qr_at is not None and int(now - qr_at) > tick:
                tick = int(now - qr_at)
                proto.progress("login", tick, int(LOGIN_S))
    finally:
        if fd >= 0:
            os.close(fd)
        remove(req)
    return run


def outcome(run, name, op):
    if run.stopped:
        return run.stopped
    if run.fail:
        if run.fail == "owned":
            write_atomic(mark(name, "owned"), b"", 0o600)
            return "owned"
        if run.fail == "owned depot" or owned_depot(["fail", *run.fail.split(" ")]):
            return "owned"
        if run.fail == "rate":
            return "network"
        if run.fail in ("depot", "branch"):
            log(f"{name}: fail {run.fail}, the map row does not match Steam")
            return "other"
        return run.fail if run.fail in ("login", "expired", "network", "space") else "other"
    if run.rc == 0 and run.end and (op != "pass" or run.total is not None):
        return None
    if run.rc == 0 or not run.seen:
        return "other"
    if (op == "pass" or not run.got) and not os.path.lexists(mark(name, "dropped")):
        try:
            steam_op(name, "reset", dir="check" if op == "pass" else "part")
            write_atomic(mark(name, "dropped"), b"", 0o600)
        except Fail:
            log(f"{name}: the reset of its .DepotDownloader failed")
    return "space" if free_bytes() <= FLOOR else "other"


def read_list(name):
    out = {"manifests": [], "files": [], "total": None}
    for line in read_lines(os.path.join(STEAM_DL, f"{name}.list"), 256 << 20) or []:
        f = line.split("\t")
        if f[0] == "manifest" and len(f) == 3 and DIGITS.fullmatch(f[1]) and DIGITS.fullmatch(f[2]):
            out["manifests"].append((f[1], f[2]))
        elif f[0] == "file" and len(f) == 4 and SHA1.fullmatch(f[1]) and DIGITS.fullmatch(f[2]) and rel_ok(f[3]):
            out["files"].append((f[3], int(f[2]), f[1]))
        elif f[0] == "total" and len(f) == 2 and DIGITS.fullmatch(f[1]):
            out["total"] = int(f[1])
        else:
            return None
    if out["total"] is None or out["total"] != sum(x[1] for x in out["files"]):
        return None
    return out


def sha1_file(path):
    h = hashlib.sha1()
    with open(path, "rb") as f:
        for data in iter(lambda: f.read(1 << 20), b""):
            h.update(data)
    return h.hexdigest()


def inside_port(row, dst):
    base = os.path.realpath(os.path.join(PORTS, row["into"].split("/", 1)[0]))
    parent = os.path.realpath(os.path.dirname(os.path.join(PORTS, dst)))
    return parent == base or parent.startswith(base + "/")


def merge(name, row, lst):
    got = read_json(mark(name, "got")) or {}
    ours = {p for p in got.get("placed", []) if isinstance(p, str)}
    plan = {"fetch": [], "replace": [], "placed": [], "skip": 0}
    for path, size, sha1 in lst["files"]:
        dst = f"{row['into']}/{path}"
        full = os.path.join(PORTS, dst)
        if not inside_port(row, dst):
            raise Fail("other")
        parent = os.path.dirname(full)
        while parent != PORTS and not os.path.lexists(parent):
            parent = os.path.dirname(parent)
        if parent != PORTS and not stat.S_ISDIR(os.lstat(parent).st_mode):
            raise Fail("exists")
        try:
            st = os.lstat(full)
        except FileNotFoundError:
            plan["fetch"].append((path, dst, size, sha1))
            plan["placed"].append((dst, size, sha1))
            continue
        if path in row["keep"]:
            plan["skip"] += 1
            continue
        if stat.S_ISREG(st.st_mode) and st.st_size == size and sha1_file(full) == sha1:
            plan["placed"].append((dst, size, sha1))
            plan["skip"] += 1
            continue
        if stat.S_ISREG(st.st_mode) and dst in ours:
            plan["fetch"].append((path, dst, size, sha1))
            plan["replace"].append(dst)
            plan["placed"].append((dst, size, sha1))
            continue
        raise Fail("exists")
    return plan


def floor_check(name, plan):
    need_b = sum(x[2] for x in plan["fetch"])
    part = os.path.join(STEAM_DL, f"{name}.part")
    have = 0
    for x in plan["fetch"]:
        try:
            st = os.lstat(os.path.join(part, x[0]))
        except OSError:
            continue
        if stat.S_ISREG(st.st_mode):
            have += min(st.st_blocks * 512, x[2])
    peak = BATCH + max((x[2] for x in plan["fetch"]), default=0)
    if free_bytes() <= max(0, need_b - have) + FLOOR + peak:
        raise Fail("space")


def aside(name, dst):
    return os.path.join(STEAM_STATE, f"{name}.replaced", dst)


def place(name, path, dst, n):
    full = os.path.join(PORTS, dst)
    src = os.open(os.path.join(STEAM_DL, f"{name}.part", path), os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        st = os.fstat(src)
        if not stat.S_ISREG(st.st_mode):
            raise Fail("other")
        try:
            os.makedirs(os.path.dirname(full), 0o755, exist_ok=True)
        except (FileExistsError, NotADirectoryError):
            raise Fail("exists")
        mode = 0o755 if st.st_mode & 0o111 else 0o644
        tmp = os.path.join(os.path.dirname(full), f".blockie-tmp-{os.getpid()}-{n}")
        out = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, mode)
        try:
            try:
                os.fchmod(out, mode)
                while os.sendfile(out, src, None, 1 << 24):
                    pass
            finally:
                os.close(out)
            os.link(tmp, full)
        except FileExistsError:
            raise Fail("exists")
        finally:
            remove(tmp)
    finally:
        os.close(src)


def copy_all(proto, name, entries, replaced):
    done = 0
    batch = []
    size = 0
    for n, (path, dst, sz, sha1) in enumerate(entries):
        if CANCEL[0]:
            raise Fail("cancel")
        if not inside_port_dst(dst):
            raise Fail("other")
        full = os.path.join(PORTS, dst)
        if dst in replaced and os.path.lexists(full) and not os.path.lexists(aside(name, dst)):
            os.makedirs(os.path.dirname(aside(name, dst)), 0o755, exist_ok=True)
            os.rename(full, aside(name, dst))
        place(name, path, dst, n)
        batch.append(path)
        size += sz
        if size >= BATCH or n == len(entries) - 1:
            os.sync()
            steam_op(name, "drop", paths=batch)
            done += len(batch)
            batch = []
            size = 0
            if proto is not None:
                proto.progress("copy", done, len(entries))


def inside_port_dst(dst):
    if not rel_ok(dst):
        return False
    base = os.path.realpath(os.path.join(PORTS, dst.split("/", 1)[0]))
    parent = os.path.realpath(os.path.dirname(os.path.join(PORTS, dst)))
    return dst.split("/", 1)[0] not in KEEP and (parent == base or parent.startswith(base + "/"))


def finish(name, data):
    write_atomic(mark(name, "got"), json.dumps({"digest": data["digest"],
                                                "placed": [x[0] for x in data["placed"]]}).encode(), 0o600)
    remove(os.path.join(STEAM_STATE, f"{name}.replaced"))
    remove(mark(name, "dropped"))
    steam_op(name, "clean")


def steam_replay(data):
    name = data.get("name")
    if not isinstance(name, str) or not PORT.fullmatch(name) or not isinstance(data.get("digest"), str):
        raise ValueError("a steam journal without a port or digest")
    copies = [tuple(c) for c in data["copies"]]
    replaced = set(data["replaced"])
    if not all(len(c) == 4 and rel_ok(c[0]) and inside_port_dst(c[1]) for c in copies):
        raise ValueError("a steam journal entry outside the port")
    if not all(os.path.isdir(os.path.join(PORTS, c[1].split("/", 1)[0])) for c in copies):
        raise ValueError("a steam journal for a port dir that is gone")
    for d in sorted({os.path.dirname(os.path.join(PORTS, c[1])) for c in copies}):
        os.makedirs(d, 0o755, exist_ok=True)
        for e in os.listdir(d):
            m = re.fullmatch(r"\.blockie-tmp-([0-9]+)-[0-9]+", e)
            if m and (int(m.group(1)) == os.getpid() or not os.path.exists(f"/proc/{m.group(1)}")):
                remove(os.path.join(d, e))
    todo = []
    drops = []
    for path, dst, size, sha1 in copies:
        full = os.path.join(PORTS, dst)
        if not os.path.lexists(os.path.join(STEAM_DL, f"{name}.part", path)):
            continue
        try:
            st = os.lstat(full)
        except FileNotFoundError:
            todo.append((path, dst, size, sha1))
            continue
        if stat.S_ISREG(st.st_mode) and st.st_size == size and sha1_file(full) == sha1:
            drops.append(path)
            continue
        if dst in replaced and not os.path.lexists(aside(name, dst)):
            os.makedirs(os.path.dirname(aside(name, dst)), 0o755, exist_ok=True)
            os.rename(full, aside(name, dst))
        else:
            os.unlink(full)
        todo.append((path, dst, size, sha1))
    if drops:
        os.sync()
        steam_op(name, "drop", paths=drops)
    if todo:
        copy_all(None, name, todo, set())
    finish(name, data)


def steam_get(proto, name):
    row = load_map().get(name)
    if not row_offered(name, row, read_apps(), installed_dirs(), updates_offered()):
        raise Fail("other")
    login = "token" if read_signed() else "qr"
    qr_used = login == "qr"
    while True:
        run = steam_dd(proto, "pass", name, login)
        why = outcome(run, name, "pass")
        if why == "login" and not qr_used:
            login, qr_used = "qr", True
            continue
        if why:
            return why
        if run.signed_in:
            clear_owned()
        lst = read_list(name)
        if lst is None:
            return "other"
        plan = merge(name, row, lst)
        if not plan["fetch"]:
            break
        floor_check(name, plan)
        paths = None if len(plan["fetch"]) == len(lst["files"]) else [x[0] for x in plan["fetch"]]
        run = steam_dd(proto, "get", name, "token", paths, sum(x[2] for x in plan["fetch"]))
        why = outcome(run, name, "get")
        if why == "login" and not qr_used:
            login, qr_used = "qr", True
            continue
        if why:
            return why
        break
    entries = plan["fetch"]
    proto.progress("copy", 0, len(entries))
    os.sync()
    data = {"op": "steam", "name": name, "digest": row["digest"], "placed": plan["placed"],
            "replaced": plan["replace"], "copies": entries}
    with game_lock():
        journal(f"steam-{name}", data)
        if entries:
            copy_all(proto, name, entries, set(plan["replace"]))
        finish(name, data)
        drop_journal(f"steam-{name}")
    return None


def cmd_steam_get(name, ctx):
    if not PORT.fullmatch(name):
        raise Fail("other")
    if scope_active():
        raise Fail("busy")
    if offline():
        raise Fail("network")
    os.makedirs(STEAM_STATE, 0o755, exist_ok=True)
    stop_units()
    steam_op(ACCOUNT, "clean")
    with game_lock():
        replay()
    hold = idle_hold()
    try:
        why = steam_get(ctx.proto, name)
    finally:
        idle_release(hold)
    if why == "cancel":
        try:
            steam_op(name, "clean")
        except Fail:
            log(f"{name}: clean after the stop failed, the next get resumes in the part dir")
    if why:
        raise Fail(why)


def cmd_steam_logout(name, ctx):
    os.makedirs(STEAM_STATE, 0o755, exist_ok=True)
    stop_units()
    steam_op(ACCOUNT, "logout")
    clear_owned()


def steam_forget(name):
    try:
        for kind in ("got", "owned", "dropped"):
            remove(mark(name, kind))
        remove(os.path.join(STEAM_STATE, f"{name}.replaced"))
        steam_op(name, "clean")
    except (Fail, OSError) as err:
        log(f"{name}: the unit's clean failed, {type(err).__name__}")


@functools.lru_cache(maxsize=1024)
def glob_re(comp):
    return re.compile("".join("[^/]*" if ch == "*" else "([^/]+)" if ch == "%" else re.escape(ch) for ch in comp))


def engine_row(r):
    if len(r) != 6:
        return None
    cls, os_name, match, root, deny, status = r
    if not (CLASS.fullmatch(cls) and os_name in LIB_OSES and root in ("0", "1", "2")
            and status in ("-", "firm", "provisional") and (status == "-") == (deny == "-")):
        return None
    items = [x.split("|") for x in match.split(",")]
    if not all(PATTERN.fullmatch(a) and rel_ok(a.rstrip("/")) for item in items for a in item):
        return None
    if "%" in match and not all("%" in a for a in items[0]):
        return None
    names = [] if deny == "-" else deny.split(",")
    if not all(PATTERN.fullmatch(n) and "/" not in n and "%" not in n and rel_ok(n) for n in names):
        return None
    return {"class": cls, "os": os_name, "items": items, "root": int(root),
            "deny": [glob_re(n.lower()) for n in names], "status": status}


def load_engines():
    rows = []
    for n, line in enumerate(read_lines(ENGINES) or [], 1):
        r = line.split("\t")
        if (n == 1 and r == ENGINE_HEAD) or not line:
            continue
        row = engine_row(r)
        if row is None:
            log(f"engines: line {n} dropped")
            continue
        rows.append(row)
    return rows


def load_corrections():
    rows = []
    for n, line in enumerate(read_lines(CORRECTIONS) or [], 1):
        r = line.split("\t")
        if (n == 1 and r == CORRECTION_HEAD) or not line:
            continue
        cls, _, os_name = r[2].partition(":") if len(r) == 3 else ("", "", "")
        if len(r) != 3 or not DIGITS.fullmatch(r[0]) or not (r[1] == "-" or DIGITS.fullmatch(r[1])) or not (
                r[2] == "none" or (CLASS.fullmatch(cls) and os_name in LIB_OSES)):
            log(f"corrections: line {n} dropped")
            continue
        rows.append({"app": r[0], "gid": None if r[1] == "-" else r[1],
                     "class": None if r[2] == "none" else (cls, os_name)})
    return rows


def runner_confs():
    try:
        names = sorted(n for n in os.listdir(RUNNERS) if n.endswith(".conf"))
    except FileNotFoundError:
        return []
    return [os.path.join(RUNNERS, n) for n in names]


def load_offered():
    out = []
    for p in runner_confs():
        for line in read_lines(p) or []:
            key, sep, value = line.partition("=")
            if not sep or key != "CLASSES":
                continue
            for x in value.strip().strip("\"'").split():
                cls, _, os_name = x.partition(":")
                if CLASS.fullmatch(cls) and os_name in LIB_OSES and x not in out:
                    out.append(x)
    return out


def table_hash():
    h = hashlib.sha256()
    for p in (ENGINES, CORRECTIONS, *runner_confs()):
        data = read_bytes(p)
        h.update(f"{os.path.basename(p)}\t{len(data)}\n".encode() + data)
    return h.hexdigest()


def lib_view(paths):
    tree = {"": (set(), set())}
    case = {"": ""}
    names = set()
    for p in paths:
        parts = [x for x in p.replace("\\", "/").split("/") if x]
        if not parts:
            continue
        low = [x.lower() for x in parts]
        names.add(low[-1])
        d = ""
        for i, x in enumerate(low[:-1]):
            sub = f"{d}/{x}" if d else x
            tree[d][1].add(x)
            if sub not in tree:
                tree[sub] = (set(), set())
                case[sub] = "/".join(parts[:i + 1])
            d = sub
        tree[d][0].add(low[-1])
    depth = {0: [""]}
    for k in sorted(tree):
        if k:
            depth.setdefault(k.count("/") + 1, []).append(k)
    return {"tree": tree, "case": case, "names": names, "depth": depth}


def glob_all(view, d, comps, isdir):
    files, subs = view["tree"].get(d, ((), ()))
    last = len(comps) == 1
    pool = files if last and not isdir else subs
    c = comps[0]
    if "*" in c or "%" in c:
        rx = glob_re(c)
        hits = [(n, h.group(1) if rx.groups else None) for n in pool for h in (rx.fullmatch(n),) if h]
    else:
        hits = [(c, None)] if c in pool else []
    for n, stem in hits:
        if last:
            yield stem
        else:
            for s in glob_all(view, f"{d}/{n}" if d else n, comps[1:], isdir):
                yield stem if stem is not None else s


def alt_all(view, root, alt):
    return glob_all(view, root, alt.rstrip("/").lower().split("/"), alt.endswith("/"))


def alt_hit(view, root, alt):
    for _ in alt_all(view, root, alt):
        return True
    return False


def row_at(view, row, root):
    stems = [None]
    if "%" in row["items"][0][0]:
        stems = sorted({s for a in row["items"][0] for s in alt_all(view, root, a)
                        if s and "*" not in s and "%" not in s})
    return any(all(any(alt_hit(view, root, a if s is None else a.replace("%", s)) for a in item)
                   for item in row["items"]) for s in stems)


def row_root(view, row):
    for depth in range(row["root"] + 1):
        for r in view["depth"].get(depth, ()):
            if row_at(view, row, r):
                return view["case"][r]
    return None


def view_class(view, os_name, table):
    for row in table:
        if row["os"] != os_name:
            continue
        root = row_root(view, row)
        if root is None:
            continue
        if any(rx.fullmatch(n) for rx in row["deny"] for n in view["names"]):
            return f"{row['class']}-native", root, row["status"]
        return row["class"], root, row["status"]
    return None


def classify(paths, os_name, table):
    return view_class(lib_view(paths), os_name, table)


def engine_root(view, cls, os_name, table):
    rows = [r for r in table if r["class"] == cls.removesuffix("-native") and r["os"] == os_name]
    for row in rows:
        root = row_root(view, row)
        if root is not None:
            return root, row["status"]
    return "", rows[0]["status"] if rows else "-"


def app_classes(app, views, builds, table, fixes):
    out = {}
    for os_name, view in views.items():
        hit = view_class(view, os_name, table)
        out[os_name] = list(hit) if hit else ["unknown", "", "-"]
    for fx in sorted((x for x in fixes if x["app"] == app), key=lambda x: x["gid"] is not None):
        for os_name in out:
            if fx["gid"] is not None and fx["gid"] not in {g for _, g, _ in builds[os_name]}:
                continue
            if fx["class"] is None:
                out[os_name] = ["none", "", "-"]
            elif fx["class"][1] == os_name:
                out[os_name] = [fx["class"][0], *engine_root(views[os_name], fx["class"][0], os_name, table)]
    return out


def lib_pick(classes, table, offered):
    rank = {}
    for i, row in enumerate(table):
        rank.setdefault(f"{row['class']}:{row['os']}", i)

    def key(os_name):
        return rank.get(f"{classes[os_name][0].removesuffix('-native')}:{os_name}", len(table)), os_name
    order = sorted(classes, key=key)
    for os_name in order:
        if f"{classes[os_name][0]}:{os_name}" in offered:
            return os_name
    return next((o for o in order if classes[o][0] not in ("unknown", "none")), None)


def lib_line(f):
    k, n = f[0], len(f)
    if k == "app":
        return (n == 4 and bool(DIGITS.fullmatch(f[1]) and WORD.fullmatch(f[2])) and f[3] != ""
                and not CTRL.search(f[3]) and len(f[3].encode()) <= 256)
    if k == "owned":
        return n == 2 and bool(DIGITS.fullmatch(f[1]))
    if k == "lang":
        return (n == 3 and bool(DIGITS.fullmatch(f[1]))
                and (f[2] == "-" or all(LANG.fullmatch(x) for x in f[2].split(","))))
    if k == "depot":
        return (n == 11 and all(DIGITS.fullmatch(x) for x in f[1:3]) and (f[3] == "-" or bool(OSLIST.fullmatch(f[3])))
                and (f[4] == "-" or bool(TOKEN.fullmatch(f[4]))) and (f[5] == "-" or bool(LANG.fullmatch(f[5])))
                and f[6] in ("0", "1") and all(x == "-" or DIGITS.fullmatch(x) for x in f[7:10])
                and bool(DIGITS.fullmatch(f[10])))
    if k == "art":
        return (n == 3 and bool(DIGITS.fullmatch(f[1]) and ART_PATH.fullmatch(f[2])) and rel_ok(f[2])
                and len(f[2]) <= 256)
    return False


def parse_library(lines):
    lib = {"apps": {}, "owned": set()}
    for n, line in enumerate(lines, 1):
        f = line.split("\t")
        if not lib_line(f):
            raise ValueError(f"library line {n} out of form")
        if f[0] == "owned":
            lib["owned"].add(f[1])
            continue
        info = lib["apps"].setdefault(f[1], {"type": None, "name": None, "langs": [], "depots": [], "art": None})
        if f[0] == "app":
            info.update(type=f[2].lower(), name=f[3])
        elif f[0] == "lang":
            info["langs"] = [] if f[2] == "-" else f[2].split(",")
        elif f[0] == "art":
            info["art"] = f[2]
        else:
            info["depots"].append({"depot": f[2], "os": [] if f[3] == "-" else f[3].lower().split(","),
                                   "arch": None if f[4] == "-" else f[4], "lang": None if f[5] == "-" else f[5],
                                   "lowviolence": f[6] == "1", "from": None if f[7] == "-" else f[7],
                                   "dlc": None if f[8] == "-" else f[8], "gid": None if f[9] == "-" else f[9],
                                   "size": int(f[10])})
    return lib


def read_library():
    try:
        with open(LIB_TSV, "rb") as f:
            raw = f.read(LIBRARY_MAX + 1)
    except FileNotFoundError:
        return None
    except OSError as err:
        raise ValueError(f"library unreadable, {type(err).__name__}") from err
    if len(raw) > LIBRARY_MAX:
        raise ValueError("library over its size")
    try:
        lines = raw.decode("utf-8").split("\n")
    except UnicodeDecodeError as err:
        raise ValueError("library not UTF-8") from err
    if lines and lines[-1] == "":
        lines.pop()
    return parse_library(lines)


def licence_hash(lib):
    return hashlib.sha256("".join(f"{x}\n" for x in sorted(lib["owned"], key=int)).encode()).hexdigest()


def lib_usable(d):
    return (d["from"] is None and not d["lowviolence"] and d["gid"] is not None and d["arch"] in (None, *ARCHES)
            and (not d["os"] or any(o in OSES for o in d["os"])))


def lib_oses(info):
    base = [d for d in info["depots"] if lib_usable(d) and d["dlc"] is None]
    return [o for o in LIB_OSES if any(o in d["os"] or (o == "windows" and not d["os"]) for d in base)]


def lib_kept(info):
    return info["type"] in LIB_TYPES and bool(lib_oses(info))


def lib_choices(info):
    base = [d for d in info["depots"] if lib_usable(d) and d["dlc"] is None]
    sets = {}
    for lang in sorted(set(info["langs"]) | {d["lang"] for d in base if d["lang"]}):
        sets.setdefault(frozenset(d["depot"] for d in base if d["lang"] == lang), []).append(lang)
    return {"+".join(v): k for k, v in sets.items()} or {"-": frozenset()}


def lib_default(info, choices):
    for cid in sorted(choices):
        if "english" in cid.split("+"):
            return cid
    langs = [d for d in info["depots"] if lib_usable(d) and d["dlc"] is None and d["lang"]]
    if langs:
        low = min(langs, key=lambda d: int(d["depot"]))["depot"]
        for cid in sorted(choices):
            if low in choices[cid]:
                return cid
    return sorted(choices)[0]


def lib_choice(app, info, choices):
    pick = read_lines(os.path.join(GAMES_STATE, f"{app}.lang"), 4096)
    if pick and pick[0] in choices:
        return pick[0]
    return lib_default(info, choices)


def lib_build(info, os_name, langset, langs, owned, drops):
    ds = [d for d in info["depots"] if lib_usable(d) and (not d["os"] or os_name in d["os"])
          and (d["dlc"] is None or (d["dlc"] in owned and d["depot"] not in drops))]
    picked = [d for d in ds if d["dlc"] is None and (not d["lang"] or d["depot"] in langset)]
    arch = next((a for a in ("64", "32") if any(d["arch"] == a for d in picked)), None)
    ds = [d for d in ds if d["arch"] in (None, arch)]
    groups = ([d for d in ds if d["dlc"] is None and not d["lang"] and d["arch"] is None],
              [d for d in ds if d["dlc"] is None and not d["lang"] and d["arch"] is not None],
              [d for d in ds if d["dlc"] is None and d["depot"] in langset],
              [d for d in ds if d["dlc"] is not None and (not d["lang"] or d["lang"] in langs)])
    return [(d["depot"], d["gid"], d["size"]) for g in groups for d in sorted(g, key=lambda d: int(d["depot"]))]


def lib_builds(app, info, lib, drops=frozenset()):
    choices = lib_choices(info)
    choice = lib_choice(app, info, choices)
    langs = set() if choice == "-" else set(choice.split("+"))
    builds = {o: lib_build(info, o, choices[choice], langs, lib["owned"], drops) for o in lib_oses(info)}
    return choice, choices, {o: b for o, b in builds.items() if b}


def paths_file(depot, gid):
    return os.path.join(LIB_SCAN, f"{depot}_{gid}.paths.gz")


def read_paths(depot, gid):
    try:
        with gzip.open(paths_file(depot, gid), "rb") as f:
            raw = f.read(PATHS_MAX + 1)
        if len(raw) > PATHS_MAX:
            return None
        lines = raw.decode("utf-8").split("\n")
    except (OSError, EOFError, zlib.error, UnicodeDecodeError):
        return None
    if lines and lines[-1] == "":
        lines.pop()
    out = []
    for line in lines:
        size, sep, name = line.partition("\t")
        if not (sep and DIGITS.fullmatch(size) and rel_ok(name.replace("\\", "/"))):
            return None
        out.append((name, int(size)))
    return out


def lib_merged(lists):
    view = {}
    for entries in lists:
        for name, size in entries:
            view[name.replace("\\", "/")] = size
    return view


def read_scanfail():
    rows = {}
    for line in read_lines(SCANFAIL) or []:
        f = line.split("\t")
        if (len(f) == 7 and DIGITS.fullmatch(f[0]) and DIGITS.fullmatch(f[1]) and f[2] in SCANFAIL_KINDS
                and DIGITS.fullmatch(f[3]) and DIGITS.fullmatch(f[4]) and SHA256.fullmatch(f[5])
                and f[6] in ("0", "1")):
            rows[(f[0], f[1])] = {"kind": f[2], "at": int(f[3]), "backoff": int(f[4]), "lic": f[5],
                                  "open": f[6] == "1"}
    return rows


def scanfail_skip(rows, depot, gid):
    e = rows.get((depot, gid))
    return e is not None and not e["open"]


def read_dlcdrop():
    rows = []
    for line in read_lines(DLCDROP) or []:
        f = line.split("\t")
        if len(f) == 3 and DIGITS.fullmatch(f[0]) and DIGITS.fullmatch(f[1]) and SHA256.fullmatch(f[2]):
            rows.append(tuple(f))
    return rows


def dlcdrop_active(app, lic):
    return {r[1] for r in read_dlcdrop() if r[0] == app and r[2] == lic}


def dlcdrop_add(app, depot, lic):
    rows = [r for r in read_dlcdrop() if r[2] == lic and r[:2] != (app, depot)] + [(app, depot, lic)]
    os.makedirs(GAMES_STATE, 0o755, exist_ok=True)
    write_atomic(DLCDROP, "".join("\t".join(r) + "\n" for r in rows).encode())


def lib_index():
    try:
        lib = read_library()
    except ValueError as err:
        log(f"steam-lib index: {err}, classes.tsv and library.tsv kept")
        raise Fail("other")
    if lib is None:
        lib = {"apps": {}, "owned": set()}
    os.makedirs(GAMES_STATE, 0o755, exist_ok=True)
    table, fixes, offered = load_engines(), load_corrections(), load_offered()
    lic = licence_hash(lib)
    failed = read_scanfail()
    ports = {}
    for name, row in sorted(load_map().items()):
        ports.setdefault(row["app"], name)
    classes_out, games = [f"hash\t{table_hash()}\n"], []
    done = total = 0
    for app in sorted(lib["apps"], key=int):
        info = lib["apps"][app]
        kept = lib_kept(info)
        if not kept and app not in ports:
            continue
        choice, choices, builds = lib_builds(app, info, lib, dlcdrop_active(app, lic))
        views, pending = {}, False
        for os_name, build in builds.items():
            lists = [read_paths(d, g) for d, g, _ in build]
            if all(x is not None for x in lists):
                views[os_name] = lib_view(lib_merged(lists))
            elif any(x is None and not scanfail_skip(failed, d, g) for x, (d, g, _) in zip(lists, build)):
                pending = True
        if kept:
            total += 1
            done += not pending
        classes = app_classes(app, views, builds, table, fixes)
        for os_name in sorted(classes):
            cls, root, status = classes[os_name]
            pairs = ",".join(f"{d}:{g}" for d, g, _ in builds[os_name])
            classes_out.append(f"{app}\t{os_name}\t{cls}\t{root or '.'}\t{status}\t{pairs}\n")
        pick = lib_pick(classes, table, offered)
        if not ((pick is not None and f"{classes[pick][0]}:{pick}" in offered) or app in ports):
            continue
        size_os = pick or next(iter(builds), None)
        size = sum(s for _, _, s in builds.get(size_os, []))
        games.append("\t".join(("app", app, info["name"] or "-", classes[pick][0] if pick else "unknown", choice,
                                ",".join(sorted(choices)), str(size), "get", ports.get(app, "-"))) + "\n")
    write_atomic(CLASSES_TSV, "".join(classes_out).encode())
    write_atomic(GAMES_TSV, f"signed\t{int(read_signed())}\nscan\t{done}\t{total}\n{''.join(games)}".encode())


def lib_todo(app, info, lib, lic, failed, full=True):
    out = []
    for build in lib_builds(app, info, lib, dlcdrop_active(app, lic))[2].values():
        for d, g, _ in build:
            if (d, g) not in out and not scanfail_skip(failed, d, g) and not (
                    read_paths(d, g) is not None if full else os.path.exists(paths_file(d, g))):
                out.append((d, g))
    return out


def lib_read():
    try:
        return read_library()
    except ValueError as err:
        log(f"steam-lib: {err}")
        raise Fail("other")


def lib_counts():
    lines = read_lines(GAMES_TSV, LIBRARY_MAX) or []
    f = lines[1].split("\t") if len(lines) > 1 else []
    if len(f) == 3 and f[0] == "scan" and all(DIGITS.fullmatch(x) for x in f[1:]):
        return int(f[1]), int(f[2])
    return 0, 0


def lib_outcome(run):
    if run.stopped:
        return run.stopped
    if run.fail:
        return "network" if run.fail == "rate" else run.fail if run.fail in ("login", "bound", "network") else "other"
    return None if run.rc == 0 and run.end else "other"


def lib_scan(proto):
    lib = lib_read()
    if lib is None:
        return None
    lic, failed = licence_hash(lib), read_scanfail()
    ports = {row["app"] for row in load_map().values()}

    def pick(full):
        batch = {}
        for app in sorted(lib["apps"], key=int):
            if len(batch) == SCAN_APPS:
                break
            info = lib["apps"][app]
            if lib_kept(info) or app in ports:
                todo = lib_todo(app, info, lib, lic, failed, full)
                if todo:
                    batch[app] = set(todo)
        return batch
    done, total = lib_counts()
    batch = pick(False) or (pick(True) if done < total else {})
    if not batch:
        return None
    proto.progress("scan", done, total)

    def finished(f):
        nonlocal done
        if f[0] == "scan" or len(f) < 3:
            return
        for todo in batch.values():
            if tuple(f[1:3]) in todo:
                todo.discard(tuple(f[1:3]))
                if not todo:
                    done += 1
                    proto.progress("scan", min(done, total), total)
    return lib_outcome(steam_dd(proto, "scan", LIB_INST, "token", extra={"apps": list(batch)}, on_line=finished))


def lib_art_get(app, path):
    dst = os.path.join(ART, f"{app}.jpg")
    tmp = f"{dst}.tmp-{os.getpid()}"
    ok = False
    try:
        p = subprocess.Popen([CURL, "-fsS", "--proto", "=https", "--max-time", "30", "--max-filesize", str(ART_BYTES),
                              "-o", tmp, ART_URL.format(app, path)], stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        p = None
    if p is not None:
        end = time.monotonic() + 60
        while p.poll() is None and not CANCEL[0] and time.monotonic() < end:
            time.sleep(0.1)
        if p.poll() is None:
            p.kill()
        ok = p.wait() == 0
    if CANCEL[0]:
        remove(tmp)
        raise Fail("cancel")
    try:
        with open(tmp, "rb") as f:
            data = f.read(ART_BYTES + 1)
    except OSError:
        data = b""
    remove(tmp)
    if not ok or len(data) > ART_BYTES or not data.startswith(b"\xff\xd8\xff"):
        return False
    write_atomic(dst, data)
    return True


def lib_art():
    lib = lib_read()
    if lib is None:
        return
    os.makedirs(ART, 0o755, exist_ok=True)
    tried = {}
    for line in read_lines(ART_TSV) or []:
        f = line.split("\t")
        if len(f) == 2 and f[0] in lib["apps"] and SHA256.fullmatch(f[1]):
            tried[f[0]] = f[1]
    listed = [f[1] for f in (x.split("\t") for x in read_lines(GAMES_TSV, LIBRARY_MAX) or []) if f[0] == "app"]
    tries = got = 0
    try:
        for app in listed:
            info = lib["apps"].get(app)
            if info is None or not info["art"] or os.path.exists(os.path.join(ART, f"{app}.jpg")):
                continue
            key = hashlib.sha256(json.dumps(info, sort_keys=True).encode()).hexdigest()
            if tried.get(app) == key:
                continue
            if tries == ART_MAX or CANCEL[0]:
                break
            if scope_active():
                raise Fail("busy")
            tries += 1
            if lib_art_get(app, info["art"]):
                got += 1
                tried.pop(app, None)
            else:
                tried[app] = key
    finally:
        write_atomic(ART_TSV, "".join(f"{a}\t{k}\n" for a, k in sorted(tried.items())).encode())
        log(f"steam-lib art: {got} of {tries} fetched")


def cmd_steam_lib(name, ctx):
    if name == "index":
        lib_index()
        return
    if name not in ("refresh", "scan", "art"):
        raise Fail("other")
    if scope_active():
        raise Fail("busy")
    if offline():
        raise Fail("network")
    os.makedirs(GAMES_STATE, 0o755, exist_ok=True)
    if name == "art":
        lib_art()
        return
    stop_units()
    if name == "refresh":
        why = lib_outcome(steam_dd(ctx.proto, "library", LIB_INST, "token"))
    else:
        why = lib_scan(ctx.proto)
    lib_index()
    if why:
        raise Fail(why)


def unit_me():
    return os.getuid()


def unit_request(inst):
    fd = os.open(os.path.join(STEAM_REQ, inst), os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != uid_of(HELPER_USER) or st.st_size > 64 << 20:
            raise ValueError("the request is not a regular file of the helper")
        with os.fdopen(os.dup(fd), "rb") as f:
            req = json.loads(f.read())
    finally:
        os.close(fd)
    if not isinstance(req, dict) or not isinstance(req.get("op"), str):
        raise ValueError("a request without an operation")
    paths = req.get("paths")
    if paths is not None and not (isinstance(paths, list) and all(rel_ok(p) for p in paths)):
        raise ValueError("a request path is not relative")
    return req


def unit_own(path):
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        return True
    return stat.S_ISDIR(st.st_mode) and st.st_uid == unit_me()


def unit_tokens():
    try:
        with open(STEAM_ACCOUNT, "rb") as f:
            data = zlib.decompress(f.read(1 << 20), -15)
    except (OSError, zlib.error):
        return 0
    n = 0
    i = 0

    def varint():
        nonlocal i
        v = shift = 0
        while True:
            b = data[i]
            i += 1
            v |= (b & 0x7f) << shift
            if not b & 0x80:
                return v
            shift += 7
            if shift > 63:
                raise ValueError("varint")

    try:
        while i < len(data):
            key = varint()
            field, kind = key >> 3, key & 7
            if kind == 0:
                varint()
            elif kind in (1, 5):
                i += 8 if kind == 1 else 4
            elif kind == 2:
                size = varint()
                n += field == 4
                i += size
            else:
                raise ValueError("wire type")
            if i > len(data):
                raise ValueError("truncated")
    except (IndexError, ValueError):
        return 0
    return n


def unit_signed():
    flag = os.path.join(STEAM_DL, "signed")
    tmp = f"{flag}.tmp-{os.getpid()}"
    with open(tmp, "w") as f:
        f.write(f"signed {int(unit_tokens() == 1)}\n")
    os.chmod(tmp, 0o644)
    os.replace(tmp, flag)


def unit_list(port):
    paths = set()
    for line in read_lines(os.path.join(STEAM_DL, f"{port}.list"), 256 << 20) or []:
        f = line.split("\t")
        if f[0] == "file" and len(f) == 4:
            paths.add(f[3])
    return paths


def unit_rmtree(path):
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        return
    if st.st_uid != unit_me():
        raise ValueError(f"{os.path.basename(path)} is not the unit's")
    if stat.S_ISDIR(st.st_mode):
        shutil.rmtree(path)
    else:
        os.unlink(path)


def unit_clean(port):
    names = os.listdir(STEAM_DL)
    if port is not None:
        for kind in ("part", "check"):
            p = os.path.join(STEAM_DL, f"{port}.{kind}")
            if os.path.lexists(p):
                if not unit_own(p):
                    raise ValueError(f"{port}.{kind} is not the unit's")
                os.rename(p, os.path.join(STEAM_DL, f"{port}.del-{time.time_ns()}-{kind}"))
        for n in os.listdir(STEAM_DL):
            if n == f"{port}.list" or n.startswith(f"{port}.list.tmp-"):
                os.unlink(os.path.join(STEAM_DL, n))
        names = os.listdir(STEAM_DL)
    for n in names:
        if ".del-" in n and (port is None or n.startswith(f"{port}.del-")):
            unit_rmtree(os.path.join(STEAM_DL, n))


def unit_drop(port, paths):
    listed = unit_list(port)
    if not all(p in listed for p in paths):
        raise ValueError("a drop path is not in the list")
    top = os.open(os.path.join(STEAM_DL, f"{port}.part"), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        for p in paths:
            *dirs, leaf = p.split("/")
            fd = os.dup(top)
            try:
                for d in dirs:
                    nfd = os.open(d, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=fd)
                    os.close(fd)
                    fd = nfd
                try:
                    os.unlink(leaf, dir_fd=fd)
                except FileNotFoundError:
                    pass
            finally:
                os.close(fd)
    finally:
        os.close(top)


def unit_prune(work, keep):
    for root, dirs, files in os.walk(work):
        rel = os.path.relpath(root, work)
        if rel == ".":
            dirs[:] = [d for d in dirs if d != ".DepotDownloader"]
        for e in files + [d for d in dirs if os.path.islink(os.path.join(root, d))]:
            p = e if rel == "." else f"{rel}/{e}"
            if p not in keep:
                os.unlink(os.path.join(root, e))


def unit_args(req, row, work, port):
    args = ["-app", row["app"], "-os", row["os"], "-depot", *row["depots"]]
    if req["op"] == "pass":
        args += ["-manifest-only"]
        if row["manifests"]:
            args += ["-manifest", *row["manifests"]]
        if row["files"]:
            args += ["-filelist", os.path.join(STEAM_LISTS, row["files"])]
    else:
        mans = {}
        for line in read_lines(os.path.join(STEAM_DL, f"{port}.list"), 256 << 20) or []:
            f = line.split("\t")
            if f[0] == "manifest" and len(f) == 3:
                mans[f[1]] = f[2]
        if any(d not in mans for d in row["depots"]):
            raise ValueError("the list lacks a manifest for a depot")
        args += ["-manifest", *(mans[d] for d in row["depots"])]
        paths = req.get("paths")
        if paths:
            listed = unit_list(port)
            if not all(p in listed and not p.startswith("regex:") for p in paths):
                raise ValueError("a get path is not in the list")
            filelist = os.path.join(os.environ.get("TMPDIR", "/tmp"), f"blockie-filelist-{os.getpid()}")
            with open(filelist, "w") as f:
                f.write("".join(p + "\n" for p in paths))
            args += ["-filelist", filelist]
        elif row["files"]:
            args += ["-filelist", os.path.join(STEAM_LISTS, row["files"])]
    if row["branch"]:
        args += ["-beta", row["branch"]]
    args += ["-dir", work, "-max-downloads", "4", "-remember-password"]
    if req["op"] == "pass" and req.get("login") == "qr":
        args += ["-qr"]
    return args


def unit_fifo(port):
    path = os.path.join(STEAM_RUN, f"{port}.fifo")
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass
    os.mkfifo(path, 0o640)
    end = time.monotonic() + 10
    while True:
        try:
            fd = os.open(path, os.O_WRONLY | os.O_NONBLOCK | os.O_CLOEXEC)
            break
        except OSError as err:
            if err.errno != errno.ENXIO or time.monotonic() >= end:
                raise
            time.sleep(0.1)
    fcntl.fcntl(fd, fcntl.F_SETFL, fcntl.fcntl(fd, fcntl.F_GETFL) & ~os.O_NONBLOCK)
    return fd


def unit_send(fd, line):
    view = memoryview(line.encode() + b"\n")
    while view:
        view = view[os.write(fd, view):]


def unit_dd(req, row, port):
    op = req["op"]
    fifo = unit_fifo(port)
    rc = 1
    try:
        work = os.path.join(STEAM_DL, f"{port}.{'check' if op == 'pass' else 'part'}")
        try:
            if not unit_own(work):
                raise ValueError(f"{os.path.basename(work)} is not a directory of the unit")
            if op == "get":
                keep = unit_list(port)
                if not keep:
                    raise ValueError("no list for the get")
                if os.path.isdir(work):
                    unit_prune(work, keep)
            args = unit_args(req, row, work, port)
        except (OSError, ValueError) as err:
            log(f"{port} {op}: refused, {err}")
            unit_send(fifo, "fail\tother")
            return 1
        r, w = os.pipe()
        try:
            p = subprocess.Popen([STEAM_DD, *args], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL, pass_fds=(w,), cwd=STEAM_HOME,
                                 env=dict(os.environ, BLOCKIE_DD_FD=str(w)))
        finally:
            os.close(w)
        manifests, files, total, end, bad = [], [], None, False, False
        with os.fdopen(r, "rb") as f:
            while True:
                raw = f.readline(LINE_MAX)
                if not raw:
                    break
                line = raw.decode("utf-8", "replace").rstrip("\n")
                fields = line.split("\t")
                kind = fields[0]
                if not raw.endswith(b"\n"):
                    bad = True
                elif kind == "file" and len(fields) == 4 and SHA1.fullmatch(fields[1]) and DIGITS.fullmatch(fields[2]) \
                        and rel_ok(fields[3]):
                    files.append(line)
                    continue
                elif kind == "manifest" and len(fields) == 3 and all(DIGITS.fullmatch(x) for x in fields[1:]):
                    manifests.append(line)
                    continue
                elif kind == "total" and len(fields) == 2 and DIGITS.fullmatch(fields[1]):
                    total = int(fields[1])
                elif kind == "end" and len(fields) == 1:
                    end = True
                elif not (kind == "qr" or (kind in ("got", "exp") and len(fields) == 2) or
                          (kind == "fail" and (len(fields) in (2, 3) or owned_depot(fields)))):
                    bad = True
                if bad:
                    p.kill()
                    unit_send(fifo, "fail\tother")
                    break
                try:
                    unit_send(fifo, line)
                except OSError:
                    p.kill()
                    break
        rc = p.wait()
        if op == "pass" and not bad and rc == 0 and end and total is not None:
            if total != sum(int(x.split("\t")[2]) for x in files):
                unit_send(fifo, "fail\tother")
                rc = 1
            else:
                lst = os.path.join(STEAM_DL, f"{port}.list")
                tmp = f"{lst}.tmp-{os.getpid()}"
                with open(tmp, "w") as f:
                    f.write("".join(x + "\n" for x in manifests + files + [f"total\t{total}"]))
                    f.flush()
                    os.fsync(f.fileno())
                os.chmod(tmp, 0o640)
                os.replace(tmp, lst)
                unit_rmtree(work)
        unit_send(fifo, f"rc\t{rc}")
        return 0 if rc == 0 and not bad else 1
    finally:
        os.close(fifo)


@contextlib.contextmanager
def unit_lib_lock():
    os.makedirs(LIB_DIR, 0o750, exist_ok=True)
    fd = open_lock(os.path.join(LIB_DIR, "lock"), 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        os.close(fd)


def next_backoff(prev_kind, prev_backoff, kind):
    if kind not in ("network", "rate"):
        return 0
    if prev_kind == kind:
        return min(max(prev_backoff, BACKOFF_S) * 2, BACKOFF_MAX_S)
    return BACKOFF_S


def write_scanfail(rows):
    write_atomic(SCANFAIL, "".join(
        f"{d}\t{g}\t{e['kind']}\t{e['at']}\t{e['backoff']}\t{e['lic']}\t{int(e['open'])}\n"
        for (d, g), e in sorted(rows.items())).encode(), 0o640)


def scanfail_due(e, lic, now):
    if e["kind"] in ("owned", "other"):
        return e["lic"] != lic
    return now < e["at"] or now >= e["at"] + e["backoff"]


def unit_write_paths(depot, gid, entries):
    data = gzip.compress("".join(f"{size}\t{name}\n" for name, size in entries).encode(), mtime=0)
    with unit_lib_lock():
        os.makedirs(LIB_SCAN, 0o750, exist_ok=True)
        write_atomic(paths_file(depot, gid), data, 0o640)


def unit_scan_result(depot, gid, kind, lic, now):
    with unit_lib_lock():
        rows = read_scanfail()
        prev = rows.pop((depot, gid), None)
        if kind is not None:
            rows[(depot, gid)] = {"kind": kind, "at": now, "lic": lic, "open": False,
                                  "backoff": next_backoff(prev and prev["kind"], prev and prev["backoff"], kind)}
        write_scanfail(rows)


def unit_library_done(lines, now):
    data = "".join(x + "\n" for x in lines).encode()
    if len(data) > LIBRARY_MAX:
        raise ValueError("the library is over its size")
    lib = parse_library(lines)
    lic = licence_hash(lib)
    named = {(d["depot"], d["gid"]) for info in lib["apps"].values() for d in info["depots"] if d["gid"]}
    with unit_lib_lock():
        write_atomic(LIB_TSV, data, 0o640)
        rows = {}
        for k, e in read_scanfail().items():
            if k in named:
                rows[k] = dict(e, open=True) if not e["open"] and scanfail_due(e, lic, now) else e
        write_scanfail(rows)
        try:
            names = os.listdir(LIB_SCAN)
        except FileNotFoundError:
            names = []
        for n in names:
            d, _, rest = n.partition("_")
            if rest.endswith(".paths.gz") and (d, rest.removesuffix(".paths.gz")) in named:
                continue
            p = os.path.join(LIB_SCAN, n)
            try:
                if ".tmp-" in n and os.lstat(p).st_mtime > now - RUN_BOUND_S:
                    continue
                os.unlink(p)
            except FileNotFoundError:
                pass


def read_logins():
    rows = []
    for line in read_lines(LOGINS) or []:
        f = line.split("\t")
        if (len(f) == 5 and f[0] in LOGIN_OPS and DIGITS.fullmatch(f[1]) and RESULT.fullmatch(f[2])
                and DIGITS.fullmatch(f[3]) and DIGITS.fullmatch(f[4])):
            rows.append({"op": f[0], "start": int(f[1]), "result": f[2], "at": int(f[3]), "backoff": int(f[4])})
    return rows


def write_logins(rows):
    write_atomic(LOGINS, "".join(f"{r['op']}\t{r['start']}\t{r['result']}\t{r['at']}\t{r['backoff']}\n"
                                 for r in rows[-LOGINS_KEEP:]).encode(), 0o640)


def login_bound(rows, op, now):
    for r in rows:
        if r["start"] > now:
            continue
        if op == "library" and r["op"] == "library" and now < r["start"] + LIBRARY_S:
            return True
        if r["at"] > now:
            continue
        if r["result"] == "rate" and now < r["at"] + r["backoff"]:
            return True
        if r["result"] == "network" and op in LIB_OPS and r["op"] in LIB_OPS and now < r["at"] + r["backoff"]:
            return True
    return False


def unit_login(op, now):
    with unit_lib_lock():
        rows = read_logins()
        if login_bound(rows, op, now):
            raise Fail("bound")
        rows.append({"op": op, "start": now, "result": "-", "at": now, "backoff": 0})
        write_logins(rows)
    return now


def unit_login_end(op, start, result, now):
    with unit_lib_lock():
        rows = read_logins()
        i = next((i for i in range(len(rows) - 1, -1, -1)
                  if rows[i]["op"] == op and rows[i]["start"] == start and rows[i]["result"] == "-"), None)
        if i is None:
            return
        prev = next((r for r in reversed(rows[:i]) if r["result"] != "-"), None)
        if prev is not None and now - prev["at"] - prev["backoff"] > BACKOFF_MAX_S:
            prev = None
        rows[i] = dict(rows[i], result=result, at=now,
                       backoff=next_backoff(prev and prev["result"], prev and prev["backoff"], result))
        write_logins(rows)


def unit_lib_pairs(req):
    apps = req.get("apps")
    if not (isinstance(apps, list) and all(isinstance(a, str) and DIGITS.fullmatch(a) for a in apps)):
        raise ValueError("a scan request without app ids")
    lib = read_library()
    if lib is None:
        return [], None
    lic, failed = licence_hash(lib), read_scanfail()
    pairs, seen = [], set()
    for app in apps[:SCAN_APPS]:
        info = lib["apps"].get(app)
        if info is None:
            continue
        for d, g in lib_todo(app, info, lib, lic, failed):
            if (d, g) not in seen:
                seen.add((d, g))
                pairs.append((app, d, g))
    stale = [paths_file(d, g) for _, d, g in pairs if os.path.lexists(paths_file(d, g))]
    if stale:
        with unit_lib_lock():
            for path in stale:
                with contextlib.suppress(FileNotFoundError):
                    os.unlink(path)
    return pairs, lic


def unit_lib_run(fifo, op, pairs, lic):
    args = ["-blockie-library"]
    listfile = None
    if op == "scan":
        listfile = os.path.join(os.environ.get("TMPDIR", "/tmp"), f"blockie-scan-{os.getpid()}")
        with open(listfile, "w") as f:
            f.write("".join(f"{a}\t{d}\t{g}\n" for a, d, g in pairs))
        args = ["-blockie-scan", listfile]
    r, w = os.pipe()
    try:
        p = subprocess.Popen([STEAM_DD, *args, "-remember-password"], stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, pass_fds=(w,), cwd=STEAM_HOME,
                             env=dict(os.environ, BLOCKIE_DD_FD=str(w)))
    finally:
        os.close(w)
    bounded = []

    def at_bound():
        bounded.append(True)
        p.kill()
    timer = threading.Timer(SCAN_S if op == "scan" else LIBRARY_RUN_S, at_bound)
    timer.daemon = True
    timer.start()
    want = {(d, g) for _, d, g in pairs or []}
    kept, cur, end, bad, fail, rate, reported, eof = [], None, False, False, None, False, set(), False
    try:
        with os.fdopen(r, "rb") as f:
            while True:
                raw = f.readline(LINE_MAX)
                if not raw:
                    eof = True
                    break
                line = raw.decode("utf-8", "replace").rstrip("\n")
                fields = line.split("\t")
                kind, n = fields[0], len(fields)
                send = False
                if not raw.endswith(b"\n"):
                    bad = True
                elif op == "library" and kind in LIB_KINDS:
                    bad = not lib_line(fields)
                    kept.append(line)
                elif op == "scan" and kind == "path":
                    if cur is None or n != 3 or not DIGITS.fullmatch(fields[1]):
                        bad = True
                    elif cur[1] is not None and rel_ok(fields[2].replace("\\", "/")):
                        cur[1].append((fields[2], int(fields[1])))
                    else:
                        cur = (cur[0], None)
                elif op == "scan" and kind in ("scan", "scanned", "scanfail"):
                    pair = tuple(fields[1:3])
                    if n != (4 if kind == "scanfail" else 3) or pair not in want:
                        bad = True
                    elif kind == "scan" and cur is None:
                        cur = (pair, [])
                    elif kind == "scanned" and cur is not None and cur[0] == pair:
                        if cur[1] is None:
                            unit_scan_result(*pair, "other", lic, int(time.time()))
                            line = "\t".join(("scanfail", *pair, "other"))
                        else:
                            unit_write_paths(*pair, cur[1])
                            unit_scan_result(*pair, None, lic, int(time.time()))
                        reported.add(pair)
                        cur = None
                    elif kind == "scanfail" and cur is None and fields[3] in SCANFAIL_KINDS:
                        unit_scan_result(*pair, fields[3], lic, int(time.time()))
                        rate = rate or fields[3] == "rate"
                        reported.add(pair)
                    else:
                        bad = True
                    send = not bad
                elif kind == "end" and n == 1:
                    end = True
                    send = op == "scan"
                elif kind == "fail" and n in (2, 3):
                    fail = fail or fields[1]
                    send = True
                else:
                    bad = True
                if bad:
                    p.kill()
                    unit_send(fifo, "fail\tother")
                    break
                if send:
                    unit_send(fifo, line)
    finally:
        if not eof:
            p.kill()
        rc = p.wait()
        timer.cancel()
        if listfile is not None:
            remove(listfile)
    done = end and (rc == 0 or bool(bounded))
    if op == "library" and done and not bad and not fail:
        try:
            unit_library_done(kept, int(time.time()))
        except (OSError, ValueError) as err:
            log(f"lib library: refused, {err}")
            unit_send(fifo, "fail\tother")
            return 1, "other"
        unit_send(fifo, "end")
        return 0, "ok"
    stuck = next(((d, g) for _, d, g in pairs or [] if (d, g) not in reported), None) if not (end or fail) else None
    if stuck is not None:
        unit_scan_result(*stuck, "network", lic, int(time.time()))
        unit_send(fifo, "\t".join(("scanfail", *stuck, "network")))
    if bad:
        return 1, "other"
    if fail:
        return 1, fail if RESULT.fullmatch(fail) else "other"
    if op == "library" and bounded:
        log("lib library: stopped at its bound")
        unit_send(fifo, "fail\tnetwork")
        return 1, "network"
    if op == "scan" and (done or bounded):
        if not end:
            unit_send(fifo, "end")
        return 0, "rate" if rate else "ok" if reported or end else "network"
    return 1, "other"


def unit_lib(req):
    op = req["op"]
    fifo = unit_fifo(LIB_INST)
    try:
        pairs = lic = None
        if op == "scan":
            try:
                pairs, lic = unit_lib_pairs(req)
            except (OSError, ValueError) as err:
                log(f"lib scan: refused, {err}")
                unit_send(fifo, "fail\tother")
                unit_send(fifo, "rc\t1")
                return 1
            if not pairs:
                unit_send(fifo, "end")
                unit_send(fifo, "rc\t0")
                return 0
        try:
            start = unit_login(op, int(time.time()))
        except Fail as err:
            unit_send(fifo, f"fail\t{err.why}")
            unit_send(fifo, "rc\t1")
            return 1
        rc, result = 1, "other"
        try:
            rc, result = unit_lib_run(fifo, op, pairs, lic)
        finally:
            unit_login_end(op, start, result, int(time.time()))
        unit_send(fifo, f"rc\t{rc}")
        return rc
    finally:
        os.close(fifo)


def unit_main(argv):
    if len(argv) != 1 or not (argv[0] in (ACCOUNT, LIB_INST) or PORT.fullmatch(argv[0])):
        log("usage: blockie-ports steam-unit <port>|account|lib")
        return 64
    inst = argv[0]
    os.umask(0o027)
    os.makedirs(STEAM_HOME, 0o700, exist_ok=True)
    try:
        req = unit_request(inst)
        op = req["op"]
        if req.get("port") != (None if inst == ACCOUNT else inst):
            raise ValueError("the request names another port")
        if inst == ACCOUNT:
            if op == "status":
                return 0
            if op == "logout":
                for n in os.listdir(STEAM_DIR):
                    if n == "account.config" or n.startswith("account.config."):
                        os.unlink(os.path.join(STEAM_DIR, n))
                unit_rmtree(STEAM_HOME)
                return 0
            if op == "clean":
                unit_clean(None)
                return 0
            raise ValueError(f"no account operation {op}")
        if inst == LIB_INST:
            if op not in LIB_OPS:
                raise ValueError(f"no library operation {op}")
            return unit_lib(req)
        if op == "clean":
            unit_clean(inst)
            return 0
        if op == "drop":
            unit_drop(inst, req.get("paths") or [])
            return 0
        if op == "reset":
            if req.get("dir") not in ("check", "part"):
                raise ValueError("a reset of an unknown dir")
            work = os.path.join(STEAM_DL, f"{inst}.{req['dir']}")
            if not unit_own(work):
                raise ValueError(f"{inst}.{req['dir']} is not the unit's")
            unit_rmtree(os.path.join(work, ".DepotDownloader"))
            return 0
        if op in ("pass", "get"):
            row = load_map().get(inst)
            app = read_apps().get(inst, (None, None))[0]
            if row is None or (app is not None and app != row["app"]):
                raise ValueError("the port has no Steam row")
            return unit_dd(req, row, inst)
        raise ValueError(f"no port operation {op}")
    except (OSError, ValueError) as err:
        log(f"{inst}: {type(err).__name__} {err}")
        return 1
    finally:
        try:
            unit_signed()
        except OSError as err:
            log(f"signed: {type(err).__name__}")


COMMANDS = {"sync": (0, cmd_sync), "refresh": (0, cmd_refresh), "index": (0, cmd_index),
            "install": (1, cmd_install), "update": (1, cmd_update), "uninstall": (1, cmd_uninstall),
            "runtime": (1, cmd_runtime), "unpack": (1, cmd_unpack), "steam-get": (1, cmd_steam_get),
            "steam-logout": (0, cmd_steam_logout), "steam-lib": (1, cmd_steam_lib)}
WAITING = ("runtime", "unpack")


def run(argv, proto):
    if len(argv) < 2 or argv[1] not in COMMANDS or len(argv) != 2 + COMMANDS[argv[1]][0] or any(
            CTRL.search(a) for a in argv[2:]):
        log(f"usage: {ME} sync|refresh|index|install <name>|update <name>|uninstall <name>|runtime <name>|"
            f"unpack <file>|steam-get <name>|steam-logout|steam-lib index|refresh|scan|art")
        return 64
    cmd = argv[1]
    arg = argv[2] if len(argv) > 2 else cmd
    name = os.path.basename(arg) if cmd == "unpack" else arg
    CANCEL[0] = False
    QUIET[0] = cmd in STEAM_CMDS or cmd == "steam-lib"
    signal.signal(signal.SIGTERM, on_term)
    os.umask(0o022)
    os.environ.update(HM_TOOLS_DIR=PORTS, HM_PORTS_DIR=PORTS, HM_SCRIPTS_DIR=PORTS, REQUESTS_CA_BUNDLE=CA,
                      TMPDIR=TMP, controlfolder=FARM)
    lock = None
    try:
        if not os.path.ismount(MOUNT):
            raise Fail("nodata")
        os.makedirs(STATE, 0o755, exist_ok=True)
        os.chdir(PORTS)
        lock = helper_lock(proto, cmd in WAITING)
        empty_tmp()
        try:
            COMMANDS[cmd][1](arg, Ctx(proto))
        finally:
            if cmd in STEAM_TSV_CMDS:
                try:
                    write_steam_tsv()
                except Exception as err:
                    log(f"steam.tsv: {type(err).__name__}")
    except Exception as err:
        why = why_of(err)
        proto.fail(name, "other" if cmd == "steam-logout" else why)
        return 1
    finally:
        if lock is not None:
            os.close(lock)
    proto.done(name)
    return 0


def main(argv):
    if argv[1:2] == ["steam-unit"]:
        return unit_main(argv[2:])
    proto = os.dup(1)
    os.dup2(2, 1)
    sys.stdout = sys.stderr
    return run(argv, Proto(proto))


if __name__ == "__main__":
    sys.exit(main(sys.argv))
