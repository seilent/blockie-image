def make_feed(hmod, proto):
    class Feed(hmod.Callback):
        def __init__(self):
            super().__init__()
            self.cancellable = False
            self.what = "load"
            self.last = 0.0

        def progress(self, message, amount, total=None, fmt=None):
            if CANCEL[0] and self.cancellable:
                raise hmod.CancelEvent()
            if message is None or amount is None:
                return
            now = time.monotonic()
            if now - self.last >= 0.25 or (total is not None and amount >= total):
                self.last = now
                proto.progress(self.what, amount, total)

        def message_box(self, message, *args, **kwargs):
            log(text(str(message)))

        @contextlib.contextmanager
        def enable_cancellable(self, cancellable=False):
            old = self.cancellable
            self.cancellable = cancellable
            try:
                yield
            finally:
                self.cancellable = old

    return Feed()


class Ctx:
    def __init__(self, proto):
        self.proto = proto
        self.hmod = None
        self.feed = None

    def load(self):
        if self.hmod is None:
            self.hmod = load_hm()
            self.feed = make_feed(self.hmod, self.proto)
        return self.hmod, self.feed

    def open(self, check):
        hmod, feed = self.load()
        off = offline()
        hm = hmod.HarbourMaster({"no-check": off or not check, "offline": off, "quiet": True, "debug": False},
                                temp_dir=Path(TMP), callback=feed)
        hm.check_runtime = skip_runtime
        hm._fix_permissions = fix_permissions
        return hm


def installed(hm, name):
    return name in hm.installed_ports or name in hm.broken_ports


def installed_info(hm, name):
