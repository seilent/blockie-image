#!/usr/bin/env bash
set -u

me=blockie-android-pad
payload=${BLOCKIE_ANDROID_PAYLOAD:-/sys/fs/cgroup/lxc.payload.waydroid}
pad=${BLOCKIE_ANDROID_PAD:-/dev/input/by-blockie/pad}
wait=${BLOCKIE_ANDROID_PAD_WAIT:-30}
listwait=${BLOCKIE_ANDROID_PAD_LIST_WAIT:-10}
path=/product/bin:/apex/com.android.runtime/bin:/apex/com.android.art/bin:/system_ext/bin:/system/bin:/system/xbin:/odm/bin:/vendor/bin:/vendor/xbin
node=/dev/input/event-pad
tmp=/dev/.blockie-pad
die() { echo "$me: $*" >&2; exit 1; }
guest() {
  local t=$1
  shift
  timeout "$t" lxc-attach -P /var/lib/waydroid/lxc -n waydroid --clear-env --set-var "PATH=$path" \
    --set-var ANDROID_ROOT=/system --set-var ANDROID_DATA=/data -- "$@" < /dev/null 2>&1 | tr -d '\r'
  return "${PIPESTATUS[0]}"
}
ready() { guest 10 sh -c '[ -d /dev/input ] && echo __ready' | grep -qx __ready; }
opened() { guest 10 dumpsys input | grep -F "$node" > /dev/null; }
live() {
  grep -qx 'populated 1' "$payload/cgroup.events" 2> /dev/null && return
  echo "$me: Android stopped, nothing to make"
  exit 0
}
frozen() { grep -qx 'frozen 1' "$payload/cgroup.events" 2> /dev/null; }
thawed() {
  live
  ! frozen || echo "$me: Android is frozen, waiting for the thaw"
  while frozen; do
    end=$((end + 1))
    sleep 1
  done
  live
}

if [[ ! -r $payload/cgroup.events ]] || ! grep -qx 'populated 1' "$payload/cgroup.events"; then
  echo "$me: no running Android payload at $payload, nothing to make"
  exit 0
fi
if [[ ! -c $pad ]]; then
  echo "$me: no pad at $pad, Android runs without it"
  exit 0
fi
read -r maj min < <(stat -L -c '%t %T' "$pad")
[[ ${maj:-} =~ ^[0-9a-f]+$ && ${min:-} =~ ^[0-9a-f]+$ ]] || die "cannot read the device number of $pad"
maj=$((16#$maj))
min=$((16#$min))

echo "$me: waiting up to $wait s for /dev/input in the guest"
end=$((SECONDS + wait))
thawed
until ready; do
  live
  ((SECONDS < end)) || die "/dev/input did not appear in the guest within $wait s"
  sleep 1
  thawed
done

thawed
want="$(printf '%x %x' "$maj" "$min") root input 660"
out=$(guest 10 sh -c "if [ -c $node ] && [ \"\$(stat -L -c '%t %T %U %G %a' $node)\" = '$want' ]; then echo __already; elif rm -f $node $tmp && mknod -m 0660 $tmp c $maj $min && chown root:input $tmp && ln $tmp $node && rm $tmp; then echo __made; fi")
if grep -qx __already <<< "$out"; then
  echo "$me: $node is already c $maj:$min root:input 0660 in the guest"
elif grep -qx __made <<< "$out"; then
  echo "$me: made $node as c $maj:$min root:input 0660 in the guest"
else
  live
  die "cannot make $node in the guest: ${out:-no output}"
fi

end=$((SECONDS + listwait))
thawed
until opened; do
  live
  ((SECONDS < end)) || die "the input service did not list $node within $listwait s"
  sleep 1
  thawed
done
echo "$me: the input service has $node"
