#!/usr/bin/env bash
set -uo pipefail

me=blockie-game
data=/var/lib/blockie/data
cores=/usr/lib64/libretro
share=/usr/share/blockie/retroarch
shaders=/usr/share/libretro/shaders
slang=/var/lib/blockie/shaders
gpuenv=/run/blockie-gpu/gpu.env
dl1=/usr/libexec/blockie/dl1
buttons=${BLOCKIE_GAME_BUTTONS:-/run/blockie-set/buttons}
input=${BLOCKIE_GAME_INPUT:-$data/retroarch/input.cfg}
pdir=$data/roms/ports
shims=/usr/libexec/blockie/ports/bin
appre='^[A-Za-z0-9][A-Za-z0-9._-]*$'

usage() { echo "usage: $me <system> <rompath> [--core <id>] [--config <file>] [--theme dark|light]" >&2; exit 64; }
refuse() { echo "$me: $*" >&2; exit 64; }
q() { printf '%q' "$1"; }
die() { echo "$me: $*" >&2; exit 70; }

declare -A default=([gb]=gambatte [gbc]=gambatte [nes]=nestopia [snes]=snes9x [genesis]=genesis_plus_gx [gba]=mgba
  [ps1]=pcsx_rearmed [n64]=mupen64plus_next [psp]=ppsspp [dc]=flycast)
ids=" gambatte nestopia snes9x genesis_plus_gx mgba pcsx_rearmed mupen64plus_next ppsspp flycast "
bools=" video_scale_integer video_shader_enable video_smooth rewind_enable savestate_auto_save savestate_auto_load "
pbinds="b y select start up down left right a x l r l2 r2 l3 r3 l_x_plus l_x_minus l_y_plus l_y_minus r_x_plus r_x_minus
  r_y_plus r_y_minus gun_trigger gun_offscreen_shot gun_aux_a gun_aux_b gun_aux_c gun_start gun_select gun_dpad_up
  gun_dpad_down gun_dpad_left gun_dpad_right turbo"
hbinds="enable_hotkey menu_toggle exit_emulator close_content reset toggle_fast_forward hold_fast_forward
  toggle_slowmotion hold_slowmotion rewind pause_toggle frame_advance audio_mute volume_up volume_down load_state
  save_state state_slot_increase state_slot_decrease play_replay record_replay halt_replay save_replay_checkpoint
  prev_replay_checkpoint next_replay_checkpoint replay_slot_increase replay_slot_decrease disk_eject_toggle disk_next
  disk_prev shader_toggle shader_hold shader_next shader_prev cheat_toggle cheat_index_plus cheat_index_minus screenshot
  recording_toggle streaming_toggle turbo_fire_toggle grab_mouse_toggle game_focus_toggle toggle_fullscreen
  desktop_menu_toggle toggle_vrr_runloop runahead_toggle preempt_toggle fps_toggle toggle_statistics ai_service
  netplay_ping_toggle netplay_host_toggle netplay_game_watch netplay_player_chat netplay_fade_chat_toggle overlay_next
  osk_toggle"
declare -A slot=()
for n in $pbinds; do
  slot[input_player1_$n]=key
  slot[input_player1_${n}_btn]=btn
done
for n in $hbinds; do
  slot[input_$n]=key
  slot[input_${n}_btn]=btn
done
declare -A owner=([f13]=home [f14]=extra2 [f15]=extra3 [10]=extra1)
declare -A free=([home]=no [extra1]=yes [extra2]=yes [extra3]=no)
declare -A stored=() applied=() later=()
bind() { [[ ${slot[$1]:-} == key && $2 =~ ^f1[345]$ ]] || [[ ${slot[$1]:-} == btn && $2 == 10 ]]; }

(( $# >= 2 )) || usage
system=$1
rom=$2
shift 2
core=
config=
theme=dark
have_core=0
have_config=0
have_theme=0
while (( $# )); do
  case $1 in
    --core)
      (( $# >= 2 && ! have_core )) || usage
      core=$2
      have_core=1
      shift 2
      ;;
    --config)
      (( $# >= 2 && ! have_config )) || usage
      config=$2
      have_config=1
      shift 2
      ;;
    --theme)
      (( $# >= 2 && ! have_theme )) || usage
      theme=$2
      have_theme=1
      shift 2
      ;;
    *) usage ;;
  esac
done

if [[ $system == ports ]]; then
  (( ! have_core && ! have_config )) || refuse "ports takes no --core or --config"
else
  [[ $system =~ ^[a-z0-9]+$ && -n ${default[$system]:-} ]] || refuse "unknown system $(q "$system")"
  (( have_core )) || core=${default[$system]}
  [[ $core =~ ^[a-z0-9_]+$ && $ids == *" $core "* ]] || refuse "unknown core $(q "$core")"
fi
[[ $theme == dark || $theme == light ]] || refuse "unknown theme $(q "$theme")"

[[ $rom == /* && $rom != *[[:cntrl:]]* ]] || refuse "rompath $(q "$rom") is not an absolute path"
if [[ $system == ports ]]; then
  [[ $rom == "$pdir"/*.sh && ${rom#"$pdir"/} != */* && -f $rom && ! -L $rom &&
    $(realpath -e -- "$rom" 2> /dev/null) == "$rom" ]] || refuse "rompath $(q "$rom") is not a script in $pdir"
  real=$rom
else
  real=$(realpath -e -- "$rom" 2> /dev/null) || refuse "rompath $(q "$rom") does not exist"
  [[ $real == "$data"/* ]] || refuse "rompath $(q "$rom") is not under $data"
  [[ -f $real ]] || refuse "rompath $(q "$rom") is not a file"
fi

lines=()
shader=
enable=
if (( have_config )); then
  [[ -f $config && -r $config ]] || refuse "config $(q "$config") is not a readable file"
  (( $(stat -c %s -- "$config") <= 65536 )) || refuse "config $(q "$config") is over 64 KiB"
  declare -A seen=()
  while IFS= read -r line || [[ -n $line ]]; do
    [[ $line =~ ^[[:space:]]*$ ]] && continue
    [[ $line =~ ^([a-z_]+)[[:space:]]*=[[:space:]]*\"([^\"]*)\"[[:space:]]*$ ]] ||
      refuse "config line $(q "$line") is not key = \"value\""
    key=${BASH_REMATCH[1]}
    value=${BASH_REMATCH[2]}
    [[ -z ${seen[$key]:-} ]] || refuse "config key $key is set twice"
    seen[$key]=1
    if [[ $bools == *" $key "* ]]; then
      [[ $value == true || $value == false ]] || refuse "config $key = $(q "$value") is not true or false"
      [[ $key != video_shader_enable ]] || enable=$value
    elif [[ $key == aspect_ratio_index ]]; then
      [[ $value =~ ^([0-9]|1[0-9]|2[0-2]|24)$ ]] || refuse "config $key = $(q "$value") is not an index 0 to 22 or 24"
    elif [[ $key == fastforward_ratio ]]; then
      [[ $value =~ ^[0-9]{1,2}(\.[0-9]{1,3})?$ ]] || refuse "config $key = $(q "$value") is not a ratio"
    elif [[ $key == video_shader ]]; then
      shader=$(realpath -e -- "$value" 2> /dev/null) && [[ $shader == "$shaders"/* && -f $shader ]] &&
        [[ $shader == *.glsl || $shader == *.glslp ]] ||
        refuse "config $key = $(q "$value") is not a .glsl or .glslp file under $shaders"
      continue
    else
      refuse "config key $key is not allowed"
    fi
    lines+=("$key = \"$value\"")
  done < "$config"
fi

so=$cores/${core}_libretro.so
if [[ $system != ports && ! -f $so ]]; then
  echo "$me: core $core is not installed ($so)" >&2
  exit 69
fi

run=${XDG_RUNTIME_DIR:-}
[[ $run == /* && $run != *[\|\"[:cntrl:]]* && -d $run ]] || die "XDG_RUNTIME_DIR is not a directory"
exec {lk}> "$run/blockie-game.lock" || die "cannot open $run/blockie-game.lock"
if ! flock -n "$lk"; then
  echo "$me: another game holds $run/blockie-game.lock" >&2
  exit 75
fi
state=$(systemctl --user show -P ActiveState blockie-game.scope 2> /dev/null)
end=$((${EPOCHREALTIME//[!0-9]/} + 500000))
while [[ $state == deactivating ]] && (( ${EPOCHREALTIME//[!0-9]/} < end )); do
  sleep 0.05
  state=$(systemctl --user show -P ActiveState blockie-game.scope 2> /dev/null)
done
case $state in
  '' | inactive) ;;
  failed)
    if ! systemctl --user reset-failed blockie-game.scope; then
      state=$(systemctl --user show -P ActiveState blockie-game.scope 2> /dev/null)
      if [[ -n $state && $state != inactive ]]; then
        echo "$me: cannot reset blockie-game.scope" >&2
        exit 75
      fi
    fi
    ;;
  *)
    echo "$me: blockie-game.scope is $state" >&2
    exit 75
    ;;
esac

if ! systemctl --user is-active --quiet blockie-frontend.service; then
  echo "$me: frontend not active" >&2
  exit 75
fi

if ! "$dl1" check; then
  echo "$me: the DL1 gate failed, the game not started" >&2
  exit 71
fi

gpulib=
if [[ -r $gpuenv ]]; then
  while IFS='=' read -r k v; do
    case $k in
      LD_LIBRARY_PATH | VK_DRIVER_FILES) export "$k=$v" ;;
    esac
    [[ $k != LD_LIBRARY_PATH ]] || gpulib=$v
  done < "$gpuenv"
fi

toplevels() {
  local line
  timeout 2 wlrctl toplevel list 2> /dev/null | while IFS= read -r line; do
    printf '%s\n' "${line%%: *}"
  done
}

stopped() {
  local k v
  while read -r k v; do
    if [[ $k == State: ]]; then
      [[ $v == T* ]]
      return
    fi
  done < "/proc/$1/status"
  return 1
}

appids() {
  local p=$1 out=$run/blockie-game.appids id step=1 t0=$SECONDS last=$SECONDS new
  local -A skip=() got=()
  local list=()
  for id in $2 $(sed -n 's/^[[:space:]]*\(APP_ID\|FOCUS\)[[:space:]]*=//p' /etc/blockie/sessions.d/*.conf \
    /usr/lib/blockie/sessions.d/*.conf 2> /dev/null | tr -d "\"'"); do
    skip[$id]=1
  done
  while kill -0 "$p" 2> /dev/null && (( SECONDS - last < 300 && ${#list[@]} < 4 )); do
    sleep "$step"
    (( SECONDS - t0 < 30 )) || step=5
    ! stopped "$p" || continue
    new=0
    while IFS= read -r id; do
      [[ $id =~ $appre && -z ${skip[$id]:-} && -z ${got[$id]:-} && $id != net.seilent.* && $id != blockie-* ]] ||
        continue
      (( ${#list[@]} < 4 )) || break
      got[$id]=1
      list+=("$id")
      new=1
    done < <(toplevels)
    if (( new )); then
      printf '%s\n' "${list[@]}" > "$out.tmp" && mv -f -- "$out.tmp" "$out"
      last=$SECONDS
    fi
  done
}

ended() {
  [[ -z $poll ]] || kill "$poll" 2> /dev/null
  poll=
  systemctl --user stop blockie-game.scope 2> /dev/null {lk}>&- 3<&-
  rm -f -- "$run/blockie-game.appids" "$run/blockie-game.appids.tmp"
  "$dl1" set > /dev/null {lk}>&- 3<&-
}

pstop() {
  trap '' TERM INT HUP
  [[ -z $pid ]] || kill -TERM "$pid" 2> /dev/null
  ended
  [[ -z $pid ]] || wait "$pid"
  exit "$1"
}

port() {
  local log=$run/blockie-ports/last.log ptmp=$data/cache/ports-tmp/run snap line rc quit=0
  local msg="WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-} XDG_RUNTIME_DIR=$run LD_LIBRARY_PATH=$gpulib BLOCKIE_THEME=$theme" v
  for v in "${WAYLAND_DISPLAY:-}" "$run" "$gpulib" "$theme"; do
    [[ $v =~ ^[A-Za-z0-9_./:@+,=-]*$ ]] || die "$(q "$v") has a space or a glob character, BLOCKIE_PORTMSG_ENV not built"
  done
  pid=
  poll=
  rm -rf -- "${ptmp:?}" && mkdir -p -m 0700 -- "$ptmp" || die "cannot empty $ptmp"
  mkdir -p -- "${log%/*}" || die "cannot make ${log%/*}"
  snap=$(toplevels {lk}>&-)
  cmd=$run/blockie-game.cmd
  trap '[[ -z $poll ]] || kill "$poll" 2> /dev/null; rm -f -- "$cmd" "$run/blockie-game.appids" "$run/blockie-game.appids.tmp"' EXIT
  trap 'pstop 143' TERM
  trap 'pstop 130' INT
  trap 'pstop 129' HUP
  rm -f -- "$cmd" "$run/blockie-game.quit" "$run/blockie-game.appids" "$run/blockie-game.appids.tmp"
  mkfifo -m 600 -- "$cmd" || die "cannot make $cmd"
  exec 3<> "$cmd" || die "cannot open $cmd"
  (
    cd -- "$pdir" || exit
    umask 022
    exec systemd-run --user --scope --quiet --unit=blockie-game --collect --slice=blockie-emulation.slice \
      -p BindsTo=blockie-frontend.service -p After=blockie-frontend.service -p MemoryHigh=80% -p MemoryMax=90% \
      -p TasksMax=512 -p OOMPolicy=kill -p TimeoutStopSec=10s -- env -u XDG_CONFIG_HOME -u XDG_DATA_HOME \
      -u XDG_CACHE_HOME -u SDL_AUDIODRIVER PATH="$shims:$PATH" HOME="$data/ports-home" TMPDIR="$ptmp" PM_CAN_MOUNT=N \
      ALSA_CONFIG_PATH=/usr/share/blockie/ports/alsa.conf BLOCKIE_PORTMSG_ENV="$msg" bash "$real"
  ) < /dev/null > "$log" 2>&1 3<&- {lk}>&- &
  pid=$!
  appids "$pid" "$snap" < /dev/null > /dev/null 2>&1 3<&- {lk}>&- &
  poll=$!
  while kill -0 "$pid" 2> /dev/null; do
    read -r -t 0.5 -u 3 line || continue
    if [[ $line == QUIT ]]; then
      quit=1
      systemctl --user stop --no-block blockie-game.scope 2> /dev/null {lk}>&- 3<&- || kill -TERM "$pid" 2> /dev/null
    fi
  done
  wait "$pid"
  rc=$?
  pid=
  ended
  (( rc != 137 || quit )) || exit 1
  exit 0
}
[[ $system != ports ]] || port

if [[ -z $shader && $enable != false && -f $share/shader-defaults ]]; then
  n=0
  found=0
  while IFS= read -r line || [[ -n $line ]]; do
    n=$((n + 1))
    read -r s p extra <<< "$line"
    [[ -n $s ]] || continue
    if [[ -z $p || -n $extra || ! $s =~ ^[a-z0-9]+$ || -z ${default[$s]:-} || $p != /* ]]; then
      echo "$me: shader-defaults line $n is not <system> <absolute path>, skipped" >&2
      continue
    fi
    [[ $s == "$system" ]] || continue
    if (( found )); then
      echo "$me: shader-defaults line $n sets $system again, skipped" >&2
      continue
    fi
    found=1
    d=$(realpath -e -- "$p" 2> /dev/null)
    if [[ -f $d && ($d == "$shaders"/*.glslp || $d == "$slang"/*.slangp) ]]; then
      shader=$d
    else
      echo "$me: shader-defaults line $n: $(q "$p") is not a .glslp under $shaders or a .slangp under $slang, skipped" >&2
    fi
  done < "$share/shader-defaults"
fi
if [[ -n $shader && $enable != false ]]; then
  [[ $enable == true ]] || lines+=('video_shader_enable = "true"')
  [[ $shader != *.slangp ]] || lines+=('video_driver = "glcore"')
else
  shader=
fi
[[ ! -f $share/rgui/$theme.cfg ]] || lines+=("rgui_menu_theme_preset = \"$share/rgui/$theme.cfg\"")

if [[ ! -e $buttons ]]; then
  echo "$me: no $buttons, the built in button defaults apply" >&2
else
  m=()
  mapfile -t m 2> /dev/null < "$buttons"
  good=0
  declare -A got=()
  if [[ ${#m[@]} == 13 && ${m[0]} == "version 1" ]]; then
    good=1
    i=1
    w='(none|switcher|game-menu|game-quit)'
    for b in home extra1 extra2 extra3; do
      [[ ${m[i]} =~ ^$b\ tap\ $w$ && ${m[i + 1]} =~ ^$b\ hold\ $w$ && ${m[i + 2]} =~ ^$b\ free\ (yes|no)$ ]] ||
        { good=0; break; }
      got[$b]=${BASH_REMATCH[1]}
      i=$((i + 3))
    done
  fi
  if (( good )); then
    for b in "${!got[@]}"; do
      free[$b]=${got[$b]}
    done
  else
    echo "$me: $buttons is not the 13 line button map, the built in button defaults apply" >&2
  fi
fi

keep=1
if [[ -e $input ]]; then
  if [[ ! -f $input || ! -r $input ]] || (( $(stat -c %s -- "$input") > 65536 )); then
    echo "$me: $input is not a readable file of at most 64 KiB, not used and not written" >&2
    keep=0
  else
    n=0
    while IFS= read -r line || [[ -n $line ]]; do
      n=$((n + 1))
      [[ $line =~ ^[[:space:]]*$ ]] && continue
      if [[ $line =~ ^(input_[a-z0-9_]+)\ =\ \"([^\"]*)\"$ ]]; then
        k=${BASH_REMATCH[1]}
        v=${BASH_REMATCH[2]}
        if bind "$k" "$v"; then
          stored[$k]=$v
          continue
        fi
      fi
      echo "$me: $input line $n is not a bind on a Blockie button, skipped" >&2
    done < "$input"
  fi
fi
if [[ -f $share/core/$core.cfg ]]; then
  while IFS= read -r line || [[ -n $line ]]; do
    [[ ! $line =~ ^([a-z0-9_]+)[[:space:]]*= ]] || later[${BASH_REMATCH[1]}]=1
  done < "$share/core/$core.cfg"
fi
masked=()
for k in "${!stored[@]}"; do
  if [[ ${free[${owner[${stored[$k]}]}]} != yes ]]; then
    masked+=("$k")
  else
    applied[$k]=${stored[$k]}
  fi
done
(( ! ${#masked[@]} )) || echo "$me: $input: masked while their button has a Blockie action: ${masked[*]}" >&2

append=()
[[ ! -f $share/core/$core.cfg ]] || append+=("$share/core/$core.cfg")
tmp=
opt=
cmd=
main=
sum=
new=
harvested=0
trap 'for f in "$tmp" "$opt" "$cmd" "$main" "$new"; do [[ -z $f ]] || rm -f -- "$f"; done' EXIT
trap 'exit 143' TERM
trap 'exit 130' INT
trap 'exit 129' HUP
main=$(mktemp "$run/blockie-game.XXXXXX.main.cfg") || die "cannot write the main config in $run"
pat=config_save_on_exit
for k in "${!applied[@]}"; do
  pat+="|$k"
done
(
  grep -vE "^($pat)[[:space:]]*=" "$share/blockie.cfg"
  (( $? < 2 )) || exit 1
  printf '%s\n' 'config_save_on_exit = "true"' "core_options_path = \"$share/retroarch-core-options.cfg\""
  for k in "${!applied[@]}"; do
    printf '%s = "%s"\n' "$k" "${applied[$k]}"
  done | LC_ALL=C sort
) > "$main" || die "cannot write $main"
sum=$(sha256sum < "$main") || die "cannot read $main"
if [[ -f $share/core/$core.opt ]]; then
  opt=$(mktemp "$run/blockie-game.XXXXXX.opt") || die "cannot write the core options in $run"
  cp -- "$share/core/$core.opt" "$opt" || die "cannot write $opt"
  lines+=('global_core_options = "true"' "core_options_path = \"$opt\"")
fi
if (( ${#lines[@]} )); then
  tmp=$(mktemp "$run/blockie-game.XXXXXX.cfg") || die "cannot write the game config in $run"
  printf '%s\n' "${lines[@]}" > "$tmp" || die "cannot write $tmp"
  append+=("$tmp")
fi
cmd=$run/blockie-game.cmd
rm -f -- "$cmd" "$run/blockie-game.quit"
mkfifo -m 600 -- "$cmd" || die "cannot make $cmd"
exec 3<> "$cmd" || die "cannot open $cmd"

argv=(retroarch --config "$main")
if (( ${#append[@]} )); then
  argv+=(--appendconfig "$(IFS='|'; printf '%s' "${append[*]}")")
fi
[[ -z $shader ]] || argv+=(--set-shader "$shader")
argv+=(-L "$so" "$real")

harvest() {
  local now k v d line
  (( ! harvested && keep )) || return 0
  harvested=1
  now=$(sha256sum < "$main") || { echo "$me: cannot read $main, $input left as it was" >&2; return 0; }
  [[ $now != "$sum" ]] || return 0
  local -A out=()
  for k in "${!stored[@]}"; do
    out[$k]=${stored[$k]}
  done
  while IFS= read -r line; do
    [[ $line =~ ^(input_[a-z0-9_]+)\ =\ \"([^\"]*)\"$ ]] || continue
    k=${BASH_REMATCH[1]}
    v=${BASH_REMATCH[2]}
    [[ -n ${slot[$k]:-} ]] || continue
    if bind "$k" "$v"; then
      out[$k]=$v
    elif [[ -n ${out[$k]:-} && $v != "${out[$k]}" && -n ${applied[$k]:-} && -z ${later[$k]:-} ]]; then
      unset "out[$k]"
    fi
  done < "$main"
  [[ -e $input || ${#out[@]} != 0 ]] || return 0
  d=${input%/*}
  if ! mkdir -p -- "$d" || ! new=$(mktemp "$d/.input.cfg.XXXXXX"); then
    echo "$me: cannot write in $d, $input left as it was" >&2
    return 0
  fi
  if ! { for k in "${!out[@]}"; do printf '%s = "%s"\n' "$k" "${out[$k]}"; done | LC_ALL=C sort > "$new"; } ||
    ! chmod 644 -- "$new" || ! sync -- "$new"; then
    rm -f -- "$new"
    new=
    echo "$me: cannot write the new $input, left as it was" >&2
    return 0
  fi
  if cmp -s -- "$new" "$input"; then
    rm -f -- "$new"
  elif mv -f -- "$new" "$input"; then
    echo "$me: $input: ${#out[@]} binds kept" >&2
  else
    rm -f -- "$new"
    echo "$me: cannot replace $input, left as it was" >&2
  fi
  new=
}

stop() {
  trap '' TERM INT HUP
  if [[ -n ${!:-} ]]; then
    kill -TERM "$!" 2> /dev/null
    systemctl --user stop blockie-game.scope 2> /dev/null
    wait "$!"
  fi
  harvest
  exit "$1"
}
trap 'stop 143' TERM
trap 'stop 130' INT
trap 'stop 129' HUP

systemd-run --user --scope --quiet --unit=blockie-game --collect --slice=blockie-emulation.slice \
  -p BindsTo=blockie-frontend.service -p After=blockie-frontend.service -p MemoryHigh=80% -p MemoryMax=90% \
  -p TasksMax=512 -p OOMPolicy=kill -p TimeoutStopSec=5s -- "${argv[@]}" <&3 3<&- &
exec 3<&-
wait "$!"
rc=$?
harvest
case $rc in
  64 | 69 | 71 | 75) exit 70 ;;
  *) exit "$rc" ;;
esac
