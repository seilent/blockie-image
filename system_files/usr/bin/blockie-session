#!/usr/bin/env bash

me=blockie-session
root=${BLOCKIE_ROOT:-}
rundir=${BLOCKIE_RUNDIR:-/run/blockie-session}
statedir=${BLOCKIE_STATEDIR:-/var/lib/blockie/session}
user=${BLOCKIE_SESSION_USER:-blockie}
display=${BLOCKIE_WAYLAND_DISPLAY:-wayland-0}
fallback=${BLOCKIE_SESSION_FALLBACK:-emulation}
step=${BLOCKIE_SESSION_STEP:-0.2}
poll=${BLOCKIE_SESSION_POLL:-0.25}
t_lock=${BLOCKIE_SESSION_LOCK_WAIT:-20}
t_start=${BLOCKIE_SESSION_START_WAIT:-20}
t_stop=${BLOCKIE_SESSION_STOP_WAIT:-20}
t_check=${BLOCKIE_SESSION_CHECK_WAIT:-1}
t_revive=${BLOCKIE_SESSION_REVIVE_WAIT:-5}
revive_max=${BLOCKIE_SESSION_REVIVE_MAX:-3}
revive_window=${BLOCKIE_SESSION_REVIVE_WINDOW:-300}
uptime=${BLOCKIE_UPTIME:-/proc/uptime}
dirs=("$root/etc/blockie/sessions.d" "$root/usr/lib/blockie/sessions.d")
units=("$root/etc/systemd/user" "$root/usr/lib/systemd/user")
namere='^[a-z0-9][a-z0-9-]*$'
appre='^[A-Za-z0-9][A-Za-z0-9._-]*$'
wordre='^[A-Za-z0-9._/:=@+-]+$'
dropre='^[a-z0-9][a-z0-9-]* [a-z0-9][a-z0-9-]*$'
invre='^[0-9a-f]{32}$'
reqfd=""

log() { echo "$me: $*" >&2; }

usage() {
  echo "usage: $me list | current | get-default | set-default <name> | switch <name> [app] | request <name> [reason] | switcher | next | back | boot | menu <from> | install <name> | ended <unit> | revive <name> | ready | mark-ready <invocation>" >&2
  exit 2
}

boottime_us() {
  local up=0
  read -r up _ < "${1:-$uptime}" 2> /dev/null || up=0
  [[ $up =~ ^[0-9]+\.[0-9]{2}$ ]] || up=0.00
  echo $(( 10#${up/./} * 10000 ))
}

trim() {
  local s=$1
  s=${s#"${s%%[![:space:]]*}"}
  printf '%s' "${s%"${s##*[![:space:]]}"}"
}

plain() { [[ $1 == ?*"$2" && $1 != */* && $1 != .* ]]; }

cmdline() {
  local w words=()
  read -ra words <<< "$1"
  (( ${#words[@]} )) && [[ ${words[0]} == /usr/* && ${words[0]} != *..* ]] || return 1
  for w in "${words[@]}"; do
    [[ $w =~ $wordre ]] || return 1
  done
}

conf() {
  local d
  for d in "${dirs[@]}"; do
    [[ -f $d/$1.conf ]] && { echo "$d/$1.conf"; return 0; }
  done
  return 1
}

unit_file() {
  local d
  for d in "${units[@]}"; do
    [[ -f $d/$1 ]] && return 0
    [[ $1 == ?*@?*.service && -f $d/${1%%@*}@.service ]] && return 0
  done
  return 1
}

load() {
  local f line k v
  LABEL="" UNIT="" APP_ID="" FOCUS="" SLICE="" DEFAULT="" BACKGROUND="" CHECK="" INSTALL="" START_WAIT="" PARK_FIRST="" LEAVE="" SWITCHED=""
  [[ $1 =~ $namere ]] && f=$(conf "$1") || return 1
  while IFS= read -r line || [[ -n $line ]]; do
    line=$(trim "$line")
    [[ $line == \#* || $line != ?*=* ]] && continue
    k=$(trim "${line%%=*}")
    v=$(trim "${line#*=}")
    if (( ${#v} >= 2 )) && [[ ${v:0:1} == [\"\'] && ${v: -1} == "${v:0:1}" ]]; then
      v=${v:1:-1}
    fi
    case $k in
      LABEL | UNIT | APP_ID | FOCUS | SLICE | DEFAULT | BACKGROUND | CHECK | INSTALL | START_WAIT | PARK_FIRST | LEAVE | SWITCHED) printf -v "$k" '%s' "$v" ;;
    esac
  done < "$f"
  BACKGROUND=${BACKGROUND:-freeze}
  [[ $UNIT == blockie-?*.service ]] && plain "$UNIT" .service && unit_file "$UNIT" || return 1
  [[ $APP_ID =~ $appre ]] || return 1
  for k in $FOCUS; do
    [[ $k =~ $appre ]] || return 1
  done
  [[ -z $SLICE || $SLICE == blockie-?*.slice ]] && { [[ -z $SLICE ]] || plain "$SLICE" .slice; } || return 1
  [[ $BACKGROUND == freeze || $BACKGROUND == stop || $BACKGROUND == run ]] || return 1
  [[ -z $DEFAULT || $DEFAULT == yes || $DEFAULT == no ]] || return 1
  [[ -z $START_WAIT ]] || { [[ $START_WAIT =~ ^[1-9][0-9]{0,2}$ ]] && (( START_WAIT <= 600 )); } || return 1
  [[ -z $PARK_FIRST || $PARK_FIRST == yes || $PARK_FIRST == no ]] || return 1
  [[ -z $LEAVE ]] || cmdline "$LEAVE" || return 1
  [[ -z $SWITCHED ]] || { cmdline "$SWITCHED" && [[ $BACKGROUND == run ]]; } || return 1
  [[ -z $CHECK || ($CHECK == /usr/* && $CHECK != *..*) ]] && [[ -z $INSTALL || ($INSTALL == /usr/* && $INSTALL != *..*) ]]
}

names() {
  local d f n
  for d in "${dirs[@]}"; do
    for f in "$d"/*.conf; do
      [[ -f $f ]] || continue
      n=${f##*/}
      echo "${n%.conf}"
    done
  done | LC_ALL=C sort -u
}

list() {
  local n
  for n in $(names); do
    load "$n" || continue
    printf '%s\t%s\t%s\n' "$n" "${LABEL:-$n}" "$([[ $DEFAULT == yes ]] && echo yes || echo no)"
  done
}

check_state() {
  local rc=0
  [[ -n $CHECK ]] || { echo available; return; }
  timeout -k 1 "$t_check" "$root$CHECK" < /dev/null > /dev/null 7>&- 8<&- 9<&- || rc=$?
  case $rc in
    0) echo available ;;
    1) echo not-installed ;;
    2) echo refused ;;
    *) log "check of $1 exited $rc, taking it as available"; echo available ;;
  esac
}

menu() {
  local n label
  [[ $1 =~ $namere ]] || usage
  for n in $(names); do
    load "$n" || continue
    label=${LABEL:-$n}
    if [[ $label == *[[:cntrl:]]* ]]; then
      log "label of $n holds a control character, skipped"
      continue
    fi
    printf '%s\t%s\t%s\t%s\t%s\n' "$n" "$label" "$(check_state "$n")" "$([[ -n $INSTALL ]] && echo yes || echo no)" \
      "$([[ $n == "$1" ]] && echo current || echo other)"
  done
}

install_action() {
  load "$1" && [[ -n $INSTALL ]] || exit 2
  exec "$root$INSTALL"
}

get_default() {
  local d
  d=$(timeout 5 blockie-set get session.default 2> /dev/null) || d=""
  if load "$d" && [[ $DEFAULT == yes ]]; then
    echo "$d"
    return 0
  fi
  if load "$fallback"; then
    echo "$fallback"
    return 0
  fi
  for d in $(names); do
    load "$d" && [[ $DEFAULT == yes ]] && { echo "$d"; return 0; }
  done
  return 1
}

read_current() {
  cur_name="" cur_unit="" cur_serial=""
  if [[ -f $rundir/session-current ]]; then
    read -r cur_name cur_unit cur_serial < "$rundir/session-current" || true
  fi
  [[ $cur_serial =~ ^[0-9]+$ ]] || cur_serial=0
}

new_serial() {
  local s c=0
  s=$(boottime_us)
  if [[ -f $rundir/session-current ]]; then
    read -r _ _ c < "$rundir/session-current" || true
  fi
  if [[ $c =~ ^[0-9]+$ ]] && (( s <= c )); then
    s=$(( c + 1 ))
  fi
  echo "$s"
}

put() {
  local f=$1 t
  shift
  t=$(mktemp "${f%/*}/.${f##*/}.XXXXXX") || return 1
  if ! { printf '%s\n' "$@" > "$t" && chmod 0644 "$t" && mv -fT "$t" "$f"; }; then
    rm -f "$t"
    return 1
  fi
}

lockfile() {
  [[ -e $1 || -L $1 ]] || put "$1"
}

ids() {
  uid=$(id -u "$user") && gid=$(id -g "$user") || return 1
  home=$(getent passwd "$user" | cut -d: -f6)
}

as_user() {
  if [[ $(id -u) == "$uid" ]]; then
    env XDG_RUNTIME_DIR="/run/user/$uid" WAYLAND_DISPLAY="$display" "$@" < /dev/null
  else
    setpriv --reuid="$uid" --regid="$gid" --init-groups --no-new-privs env -i PATH="$PATH" HOME="$home" \
      XDG_RUNTIME_DIR="/run/user/$uid" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
      WAYLAND_DISPLAY="$display" "$@" < /dev/null
  fi
}

hookcmd() {
  local argv=()
  read -ra argv <<< "$1"
  shift
  as_user timeout -k 1 2 "$root${argv[0]}" "${argv[@]:1}" "$@" 7>&- 8<&- 9<&-
}

reqlock() {
  if [[ -z $reqfd ]]; then
    install -d -m 0700 "$rundir/lock" || return 1
    exec 7>> "$rundir/lock/request.lock" || return 1
    reqfd=yes
  fi
  flock -w "$1" 7
}

prop() { as_user systemctl --user show -p "$2" --value "$1" 2> /dev/null; }

active() { [[ $(prop "$1" ActiveState) =~ ^(active|reloading)$ ]]; }

inactive() { [[ $(prop "$1" ActiveState) =~ ^(inactive|failed)$ ]]; }

dead() { [[ -z $(prop "$1" Job) ]] && inactive "$1"; }

thawed() { [[ $(prop "$1" FreezerState) == running ]]; }

ends_at() { awk -v n="$(boottime_us /proc/uptime)" -v t="$1" 'BEGIN { printf "%.0f", n + t * 1000000 }'; }

past() { (( $(boottime_us /proc/uptime) >= $1 )); }

within() {
  local end
  end=$(ends_at "$1")
  shift
  until "$@"; do
    [[ -z ${term:-} ]] || return 1
    ! past "$end" || return 1
    sleep "$step"
  done
}

has_window() { as_user timeout 2 wlrctl toplevel find "app_id:$1" > /dev/null 2>&1; }

shows() { active "$1" && has_window "$2"; }

settled() { shows "$1" "$2" || [[ -e $rundir/session-pending ]]; }

focus() {
  local a
  for a in $2; do
    if has_window "$a"; then
      as_user wlrctl toplevel focus "app_id:$a" > /dev/null 2>&1 && return 0
    fi
  done
  as_user wlrctl toplevel focus "app_id:$1" > /dev/null 2>&1 || log "focus of $1 failed"
}

minimize() {
  local a
  for a in $2; do
    as_user wlrctl toplevel minimize "app_id:$a" > /dev/null 2>&1 || true
  done
  as_user wlrctl toplevel minimize "app_id:$1" > /dev/null 2>&1 || log "minimize of $1 failed"
}

wake() {
  if ! thawed "$1"; then
    as_user systemctl --user thaw "$1" || log "thaw of $1 failed"
  fi
}

frozen_unit() {
  if [[ -n $2 ]] && active "$2"; then
    echo "$2"
  else
    echo "$1"
  fi
}

park() {
  local unit=$1 app=$2 bg=$3 extra=$4 slice=$5 f
  case $bg in
    freeze)
      minimize "$app" "$extra"
      f=$(frozen_unit "$unit" "$slice")
      as_user systemctl --user freeze "$f" || log "freeze of $f failed"
      ;;
    stop)
      as_user systemctl --user stop --no-block "$unit" || log "stop of $unit failed"
      within "$t_stop" inactive "$unit" || log "$unit still running after stop"
      ;;
    run) minimize "$app" "$extra" ;;
  esac
}

source_back() {
  [[ -n $s_unit ]] || return 0
  if [[ ${1:-} == yes && $s_bg == stop ]]; then
    rm -f "$rundir/revive-hold"
    put "$rundir/session-current" "$s_name $s_unit $(new_serial)" || log "cannot write session-current"
    as_user systemctl --user start --no-block "$s_unit" || log "start of $s_unit failed"
    within "$s_wait" settled "$s_unit" "$s_app" || log "no window of $s_app after $s_wait s"
  fi
  wake "$(frozen_unit "$s_unit" "$s_slice")"
  if active "$s_unit"; then
    focus "$s_app" "$s_focus"
    log "back on $s_name"
  else
    log "$s_name is not running either"
    systemctl start --no-block "blockie-session-revive@$s_name.service" || log "start of revive@$s_name failed"
  fi
}

undo() {
  [[ -n $live ]] || return 0
  trap 'term=1 t_stop=0 s_wait=0' TERM
  rm -f "$rundir/session-starting"
  if [[ -z $s_unit && ${1:-} != cancel ]] && active "$live"; then
    put "$rundir/session-current" "$t_name $live $(new_serial)" || log "cannot write session-current"
    put "$statedir/last" "$t_name" || log "cannot write $statedir/last"
    log "$t_name kept without a window, no session to go back to"
    kept=yes
  elif [[ -n $started ]]; then
    as_user systemctl --user stop --no-block "$live" || log "stop of $live failed"
    within "$t_stop" inactive "$live" || log "$live still running after stop"
  else
    park "$live" "$t_app" "$t_bg" "$t_focus" "$t_slice"
  fi
  source_back "$parked"
  rm -f "$rundir/revive-hold"
  live="" parked="" started=""
  [[ -z $term ]] || exit 143
  return 0
}

shown() {
  local want=$1 end=$2 w wwhy wrest ws=()
  until shows "$t_unit" "$t_app"; do
    if dead "$t_unit"; then
      log "$t_unit stopped while starting"
      return 1
    fi
    if past "$end"; then
      if active "$t_unit"; then
        log "no window of $t_app after $t_wait s"
      else
        log "$t_unit is not active after $t_wait s"
      fi
      return 1
    fi
    if [[ -e $rundir/session-pending ]] && reqlock 1; then
      if [[ -e $rundir/session-pending ]]; then
        rm -f "${rundir:?}/session-pending"
        w="" wwhy="" wrest=""
        read -r w wwhy wrest < "$rundir/session-wanted" || true
        if [[ $w != "$want" ]]; then
          put "$rundir/session-pending" "$w" || log "cannot write session-pending"
          flock -u 7 || log "cannot release the request lock"
          log "start of $want cancelled, $w wanted"
          return 3
        fi
        if [[ $wwhy == app ]]; then
          read -ra ws <<< "$wrest"
          joined+=("${ws[@]}")
        fi
        log "$want requested again, still starting"
      fi
      flock -u 7 || log "cannot release the request lock"
    fi
    sleep "$poll"
  done
}

switch_once() {
  local want=$1 why=${2:-} t_first state early="" serial end rc=0 lrc=0
  kept=""
  s_name="" s_unit="" s_app="" s_bg="" s_focus="" s_slice="" s_wait="" s_leave=""
  load "$want" || { log "$want is not a listed session"; return 1; }
  t_name=$want t_unit=$UNIT t_app=$APP_ID t_focus=$FOCUS t_slice=$SLICE t_bg=$BACKGROUND t_wait=${START_WAIT:-$t_start}
  t_first=${PARK_FIRST:-no}
  state=$(check_state "$want")
  [[ $state == available ]] || { log "$want is $state"; return 1; }
  read_current
  if [[ -n $cur_name && $cur_name != "$want" ]] && load "$cur_name" && [[ $UNIT == "$cur_unit" ]]; then
    s_name=$cur_name s_unit=$UNIT s_app=$APP_ID s_bg=$BACKGROUND s_focus=$FOCUS s_slice=$SLICE s_wait=${START_WAIT:-$t_start}
    s_leave=$LEAVE
  fi
  if [[ $cur_name == "$want" ]] && active "$t_unit" && thawed "$(frozen_unit "$t_unit" "$t_slice")"; then
    focus "$t_app" "$t_focus"
    log "$want is current"
    return 0
  fi
  if [[ -n $s_name && -n $s_leave && $why != app ]]; then
    hookcmd "$s_leave" "$want" "$why" || lrc=$?
    if (( lrc == 0 )); then
      log "leave taken by $s_name"
      result=none
      return 0
    fi
    log "leave of $s_name exited $lrc, switching"
  fi
  live=$t_unit started=""
  put "$rundir/session-starting" "$want" || log "cannot write session-starting"
  if [[ $t_first == yes && -n $s_unit ]]; then
    early=yes parked=yes
    if [[ $s_bg == stop ]]; then
      put "$rundir/revive-hold" "$s_unit" || log "cannot write revive-hold"
    fi
    park "$s_unit" "$s_app" "$s_bg" "$s_focus" "$s_slice"
  fi
  wake "$(frozen_unit "$t_unit" "$t_slice")"
  if ! active "$t_unit"; then
    started=yes
    as_user systemctl --user start --no-block "$t_unit" || { log "start of $t_unit failed"; undo; return 1; }
  fi
  end=$(ends_at "$t_wait")
  shown "$want" "$end" || rc=$?
  if (( rc == 3 )); then
    result=cancelled
    undo cancel
    return 0
  fi
  if (( rc )); then
    undo
    [[ -z $kept ]] || return 0
    return 1
  fi
  live="" parked="" started=""
  rm -f "$rundir/session-starting" "$rundir/revive-hold"
  focus "$t_app" "$t_focus"
  serial=$(new_serial)
  put "$rundir/session-current" "$want $t_unit $serial" || log "cannot write session-current"
  put "$statedir/last" "$want" || log "cannot write $statedir/last"
  [[ -z $s_unit || -n $early ]] || park "$s_unit" "$s_app" "$s_bg" "$s_focus" "$s_slice"
  log "switched to $want${s_name:+ from $s_name}"
}

request() {
  local want=$1 why=${2:-requested} from="" ow="" owhy="" orest="" f x dup fs=() out=()
  [[ $(id -u) == 0 ]] || { log "request runs as root, start blockie-session-switch@$want.service"; exit 2; }
  [[ $want =~ $namere && $why =~ $namere ]] || usage
  load "$want" || { log "$want is not a listed session"; exit 1; }
  install -d -m 0755 "$rundir"
  reqlock 5 || { log "request lock busy"; exit 75; }
  if [[ $why == app ]]; then
    read_current
    from=$cur_name
  fi
  if [[ -e $rundir/session-pending ]]; then
    read -r ow owhy orest < "$rundir/session-wanted" || true
  fi
  if [[ $owhy == app ]]; then
    read -ra fs <<< "$orest"
  fi
  if [[ -n $ow && $ow != "$want" ]]; then
    for f in "${fs[@]}"; do
      [[ $f =~ $namere ]] || continue
      printf '%s %s\n' "$ow" "$f" >> "$rundir/session-dropped" || log "cannot write session-dropped"
    done
    fs=()
  elif [[ $owhy == app ]]; then
    why=app
  fi
  [[ -z $from ]] || fs+=("$from")
  for f in "${fs[@]}"; do
    [[ $f =~ $namere ]] || continue
    dup=""
    for x in "${out[@]}"; do
      [[ $x != "$f" ]] || dup=yes
    done
    [[ -n $dup ]] || (( ${#out[@]} >= 8 )) || out+=("$f")
  done
  put "$rundir/session-wanted" "$want $why${out[*]:+ ${out[*]}}" || exit 1
  put "$rundir/session-pending" "$want" || exit 1
  flock -u 7 || log "cannot release the request lock"
}

takedrops() {
  local line d x dup got=()
  [[ -f $rundir/session-dropped ]] || return 0
  while IFS= read -r line || [[ -n $line ]]; do
    if [[ $line =~ $dropre ]]; then
      got+=("$line")
    else
      log "session-dropped: a malformed line skipped"
    fi
  done < "$rundir/session-dropped"
  rm -f "${rundir:?}/session-dropped" || log "cannot remove session-dropped"
  for d in "${got[@]}"; do
    dup=""
    for x in "${taken[@]}"; do
      [[ $x != "$d" ]] || dup=yes
    done
    [[ -z $dup ]] || continue
    if (( ${#taken[@]} >= 8 )); then
      log "session-dropped: over 8 drops in this run, the rest not sent"
      break
    fi
    taken+=("$d")
    drops+=("$d")
  done
}

sendto() {
  if ! load "$1" || [[ -z $SWITCHED ]]; then
    log "no switched hook for $1, $2 $3 not sent"
    return 0
  fi
  hookcmd "$SWITCHED" "$2" "$3" || log "switched hook of $1 exited $?"
}

deliver() {
  local d
  while (( ${#drops[@]} )); do
    d=${drops[0]}
    drops=("${drops[@]:1}")
    sendto "${d#* }" "${d%% *}" dropped || true
  done
}

report() {
  local n x dup names=() sent=()
  reported=yes
  [[ $1 != none ]] || return 0
  [[ $why != app ]] || names=("${froms[@]}")
  names+=("${joined[@]}")
  for n in "${names[@]}"; do
    dup=""
    for x in "${sent[@]}"; do
      [[ $x != "$n" ]] || dup=yes
    done
    [[ -z $dup ]] || continue
    sent+=("$n")
    sendto "$n" "$want" "$1" || true
  done
}

finish() {
  trap '' TERM
  [[ -z $reqfd ]] || flock -u 7 || true
  undo || true
  [[ -n $reported ]] || report "${result:-failed}" || true
  deliver || true
}

switcher() {
  local rc=0 pending="" rest=""
  [[ $(id -u) == 0 ]] || { log "switcher runs as root"; exit 2; }
  ids || { log "no user $user"; exit 1; }
  install -d -m 0755 "$rundir" "$statedir"
  install -d -m 0700 "$rundir/lock"
  lockfile "$rundir/lock/session.lock"
  exec 9< "$rundir/lock/session.lock"
  flock -w "$t_lock" 9 || { log "session lock busy"; exit 75; }
  live="" parked="" started="" term="" kept="" s_unit="" reported="" result="" want="" why=""
  froms=() joined=() drops=() taken=()
  trap 'term=1 t_stop=0 s_wait=0; undo; exit 143' TERM
  trap finish EXIT
  rm -f "${rundir:?}/session-starting" "${rundir:?}/revive-hold"
  reqlock 5 || { log "request lock busy"; exit 75; }
  if [[ -e $rundir/session-pending ]]; then
    pending=yes
    rm -f "${rundir:?}/session-pending"
    read -r want why rest < "$rundir/session-wanted" || true
    [[ $why != app ]] || read -ra froms <<< "$rest"
  fi
  takedrops || log "cannot read session-dropped"
  flock -u 7 || log "cannot release the request lock"
  deliver || true
  [[ -n $pending ]] || return 0
  switch_once "$want" "$why" && result=${result:-ok} || { rc=1; result=failed; }
  trap 'term=1 t_stop=0 s_wait=0; undo; exit 143' TERM
  [[ -z $term ]] || exit 143
  report "$result" || true
  if reqlock 5; then
    takedrops || log "cannot read session-dropped"
    flock -u 7 || log "cannot release the request lock"
  else
    log "request lock busy, drops left for the next run"
  fi
  deliver || true
  return "$rc"
}

switch() {
  load "$1" || { log "$1 is not a listed session"; exit 1; }
  if [[ $(id -u) == 0 ]]; then
    request "$1" "${2:-requested}"
  elif [[ ${2:-} == app ]]; then
    exec systemctl start --no-block "blockie-session-appswitch@$1.service"
  else
    exec systemctl start --no-block "blockie-session-switch@$1.service"
  fi
}

next() {
  local n first="" pick="" seen=0 ref=""
  read_current
  if [[ -e $rundir/session-pending ]]; then
    read -r ref _ < "$rundir/session-wanted" || true
  fi
  if [[ -z $ref && -f $rundir/session-starting ]]; then
    read -r ref < "$rundir/session-starting" || true
  fi
  ref=${ref:-$cur_name}
  for n in $(names); do
    load "$n" || continue
    [[ $n == "$ref" || $(check_state "$n") == available ]] || continue
    [[ -n $first ]] || first=$n
    if (( seen )); then
      pick=$n
      break
    fi
    [[ $n != "$ref" ]] || seen=1
  done
  pick=${pick:-$first}
  [[ -n $pick ]] || { log "no listed session"; exit 1; }
  [[ $pick != "$ref" ]] || { log "$pick is the only session"; exit 0; }
  switch "$pick"
}

back() {
  local t s=""
  t=$(get_default) || { log "no default session"; exit 1; }
  read_current
  if [[ -f $rundir/session-starting ]]; then
    read -r s < "$rundir/session-starting" || true
  fi
  if [[ -n $s ]]; then
    [[ $t != "$s" ]] || { log "back: $t is starting"; exit 0; }
  else
    [[ $t != "$cur_name" ]] || { log "back: $t is current"; exit 0; }
  fi
  switch "$t"
}

boot() {
  local t
  t=$(get_default) || { log "no default session"; exit 1; }
  switch "$t"
}

ended() {
  local h=""
  read_current
  [[ -n $cur_name && $cur_unit == "$1" ]] || exit 0
  if [[ -f $rundir/revive-hold ]]; then
    read -r h < "$rundir/revive-hold" || true
  fi
  [[ $h != "$1" ]] || exit 0
  [[ $(systemctl --user is-active graphical-session.target 2> /dev/null) == active ]] || exit 0
  exec systemctl start --no-block "blockie-session-revive@$cur_name.service"
}

revive() {
  local name=$1 serial unit t now s x n=0 keep=()
  [[ $(id -u) == 0 ]] || { log "revive runs as root"; exit 2; }
  ids || { log "no user $user"; exit 1; }
  read_current
  [[ $cur_name == "$name" ]] || { log "revive: $name is not the current session"; exit 0; }
  serial=$cur_serial unit=$cur_unit
  sleep "$t_revive"
  read_current
  [[ $cur_name == "$name" && $cur_serial == "$serial" ]] || exit 0
  if [[ -e $rundir/session-starting ]]; then
    if [[ -f $rundir/lock/session.lock ]] && exec 8< "$rundir/lock/session.lock" && flock -n 8; then
      rm -f "$rundir/session-starting"
      exec 8<&-
    else
      log "revive: a switch is running, $name left to it"
      exit 0
    fi
  fi
  inactive "$unit" || exit 0
  t=$(get_default) || { log "revive: $unit of $name ended, no default session"; exit 1; }
  now=$(( $(boottime_us) / 1000000 ))
  if [[ -f $rundir/revived ]]; then
    while read -r s x; do
      [[ $s =~ ^[0-9]+$ ]] && (( now - s < revive_window )) || continue
      keep+=("$s $x")
      [[ $x != "$t" ]] || n=$(( n + 1 ))
    done < "$rundir/revived"
  fi
  if (( n >= revive_max )); then
    log "revive: $unit of $name ended, $t was brought back $n times in $revive_window s, not again"
    exit 1
  fi
  put "$rundir/revived" "${keep[@]}" "$now $t" || exit 1
  log "revive: $unit of $name ended, back to $t"
  request "$t" revive
}

mark_ready() {
  local want=$1 d inv
  [[ $(id -u) == 0 ]] || { log "mark-ready runs as root, start blockie-session-ready@$want.service"; exit 2; }
  ids || { log "no user $user"; exit 1; }
  d=$(get_default) || { log "ready: no default session"; exit 1; }
  load "$d" || { log "ready: $d is not a listed session"; exit 1; }
  install -d -m 0755 "$rundir"
  if ! within "${START_WAIT:-$t_start}" shows "$UNIT" "$APP_ID"; then
    log "ready: $d shows no window of $APP_ID, not marked"
    exit 1
  fi
  inv=$(prop "$UNIT" InvocationID) || inv=""
  [[ $inv == "$want" ]] || { log "ready: $UNIT runs invocation ${inv:-none}, not the reporting $want, not marked"; exit 1; }
  put "$rundir/ready" "$d $UNIT $inv" || exit 1
  log "ready: $d $inv"
}

ready() {
  local inv=${INVOCATION_ID:-}
  [[ $inv =~ $invre ]] || { log "ready: INVOCATION_ID names no unit invocation, nothing sent"; exit 2; }
  if [[ $(id -u) == 0 ]]; then
    mark_ready "$inv"
  else
    exec systemctl start "blockie-session-ready@$inv.service"
  fi
}

main() {
  case ${1:-} in
    list) (( $# == 1 )) || usage; list ;;
    current)
      (( $# == 1 )) || usage
      read_current
      [[ -n $cur_name ]] || exit 1
      echo "$cur_name"
      ;;
    get-default) (( $# == 1 )) || usage; get_default ;;
    set-default) (( $# == 2 )) && [[ $2 =~ $namere ]] || usage; exec blockie-set set session.default "$2" ;;
    switch) { (( $# == 2 )) || [[ $# == 3 && $3 == app ]]; } && [[ $2 =~ $namere ]] || usage; switch "$2" "${3:-}" ;;
    request) (( $# == 2 || $# == 3 )) || usage; request "$2" "${3:-requested}" ;;
    switcher) (( $# == 1 )) || usage; switcher ;;
    next) (( $# == 1 )) || usage; next ;;
    back) (( $# == 1 )) || usage; back ;;
    boot) (( $# == 1 )) || usage; boot ;;
    menu) (( $# == 2 )) || usage; menu "$2" ;;
    install) (( $# == 2 )) || usage; install_action "$2" ;;
    ended) (( $# == 2 )) || usage; ended "$2" ;;
    revive) (( $# == 2 )) && [[ $2 =~ $namere ]] || usage; revive "$2" ;;
    ready) (( $# == 1 )) || usage; ready ;;
    mark-ready) (( $# == 2 )) && [[ $2 =~ $invre ]] || usage; mark_ready "$2" ;;
    *) usage ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  set -euo pipefail
  main "$@"
fi
