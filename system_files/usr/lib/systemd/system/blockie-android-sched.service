[Unit]
Description=Place Android processes in top, fg and bg and boost the CPU, GPU and DRAM floors
After=waydroid-container.service
PartOf=waydroid-container.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=notify
RuntimeDirectory=blockie-android-sched
RuntimeDirectoryPreserve=yes
ExecStartPre=/usr/libexec/blockie/blockie-android-sched orig
ExecStart=/usr/libexec/blockie/blockie-android-sched
ExecStopPost=/usr/libexec/blockie/blockie-android-sched-restore
WatchdogSec=10
TimeoutStopSec=5s
TimeoutAbortSec=2s
Restart=on-failure
RestartSec=1
Nice=-5
LimitNOFILE=4096

[Install]
WantedBy=waydroid-container.service
