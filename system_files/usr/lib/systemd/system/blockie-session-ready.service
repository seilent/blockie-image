[Unit]
Description=Mark the default session ready
After=blockie-setd.service
CollectMode=inactive-or-failed

[Service]
Type=oneshot
TimeoutStartSec=660
ExecStart=/usr/bin/blockie-session mark-ready
ProtectSystem=strict
ReadWritePaths=/run/blockie-session
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=read-only
RestrictSUIDSGID=yes
CapabilityBoundingSet=CAP_SETUID CAP_SETGID
