[Unit]
Description=Graphical login session of the session user
After=systemd-user-sessions.service systemd-logind.service blockie-dl1.service blockie-data.service
Wants=systemd-logind.service blockie-data.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=blockie
PAMName=login
ExecStartPre=+/usr/libexec/blockie/dl1 check
Environment=XDG_SESSION_TYPE=wayland XDG_SESSION_CLASS=user XDG_SEAT=seat0 XDG_SESSION_DESKTOP=blockie
ExecStart=/usr/bin/systemctl --user start --wait blockie-compositor.service
ExecStopPost=-+/usr/bin/setpriv --reuid=blockie --regid=blockie --init-groups /usr/bin/env XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/systemctl --user stop blockie-compositor.service
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
