[Unit]
Description=Confirm the deployment and re-arm slot a once the default session is ready
After=multi-user.target blockie-boot-ok.service
ConditionKernelCommandLine=ostree
ConditionPathExists=/run/blockie/product
RequiresMountsFor=/var

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=infinity
ExecStart=/usr/libexec/blockie/blockie-boot-ok healthy

[Install]
WantedBy=multi-user.target
