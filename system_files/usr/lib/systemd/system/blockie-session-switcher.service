[Unit]
Description=Switch to the wanted session
After=blockie-setd.service

[Service]
Type=oneshot
TimeoutStartSec=120
ExecStart=/usr/bin/blockie-session switcher
ProtectSystem=strict
ReadWritePaths=/run/blockie/session /var/lib/blockie/session
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=read-only
RestrictSUIDSGID=yes
CapabilityBoundingSet=CAP_SETUID CAP_SETGID
