[Unit]
Description=Check the Android images and prepare Waydroid
Requires=blockie-data.service blockie-internal.service
After=blockie-data.service blockie-internal.service
RequiresMountsFor=/var/lib/blockie/data /var/lib/blockie/internal

[Service]
Type=oneshot
TimeoutStartSec=120
ExecStart=/usr/libexec/blockie/blockie-android-prep

[Install]
WantedBy=multi-user.target
