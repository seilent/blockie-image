[Unit]
Description=Load the Wi-Fi regulatory database and set the country to JP
After=blockie-wifi.service
Before=NetworkManager.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/iw reg reload
ExecStart=/usr/bin/iw reg set JP
ExecStartPost=/bin/sh -c 'iw reg get | awk "/^global/ { g = 1; next } g && /^country / { print; exit }" | grep -q "^country JP:"'

[Install]
WantedBy=multi-user.target
