[Unit]
Description=Mount the BLOCKIE_DATA partition at /var/lib/blockie/data
RequiresMountsFor=/var/lib/blockie
After=var.mount

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/blockie/blockie-data
ExecStartPost=/usr/bin/systemd-tmpfiles --create /usr/lib/blockie/data-tmpfiles.conf

[Install]
WantedBy=multi-user.target
