[Unit]
Description=Mount the BLOCKIE_INTERNAL filesystem on userdata at /var/lib/blockie/internal
RequiresMountsFor=/var/lib/blockie
After=var.mount

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=120
ExecStart=/usr/libexec/blockie/blockie-data internal
ExecStartPost=/usr/bin/systemd-tmpfiles --create /usr/lib/blockie/internal-tmpfiles.conf

[Install]
WantedBy=multi-user.target
