[Unit]
Description=Mount the BLOCKIE_DATA2 partition at /var/lib/blockie/data2
RequiresMountsFor=/var/lib/blockie
After=var.mount

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=120
ExecStart=/usr/libexec/blockie/blockie-data2
ExecStartPost=/usr/bin/systemd-tmpfiles --create /usr/lib/blockie/data2-tmpfiles.conf

[Install]
WantedBy=multi-user.target
