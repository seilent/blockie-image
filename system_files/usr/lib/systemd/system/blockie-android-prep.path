[Unit]
Description=Run the Android prep again when the image stamp changes
DefaultDependencies=no
Requires=blockie-data.service
After=blockie-data.service
Conflicts=shutdown.target
Before=shutdown.target

[Path]
PathChanged=/var/lib/blockie/data/android/images/stamp
Unit=blockie-android-prep.service

[Install]
WantedBy=multi-user.target
