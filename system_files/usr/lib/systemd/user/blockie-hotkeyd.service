[Unit]
Description=Session hotkeys
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/libexec/blockie/blockie-hotkeyd
ExecStopPost=-/usr/libexec/blockie/blockie-hook blank-off
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
