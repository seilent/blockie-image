[Unit]
Description=Android session

[Service]
UnsetEnvironment=LD_PRELOAD LD_LIBRARY_PATH VK_DRIVER_FILES
Environment=XDG_DATA_HOME=/var/lib/blockie/data/android/user
ExecStartPre=/usr/bin/mountpoint -q /var/lib/blockie/data
ExecStartPre=/usr/bin/systemctl start waydroid-container.service
ExecStart=/usr/libexec/blockie/blockie-android-run
ExecStop=-/usr/bin/systemctl start blockie-android-freeze@thaw.service
ExecStop=/usr/bin/systemctl stop waydroid-container.service
ExecStopPost=-/usr/bin/systemctl stop waydroid-container.service
TimeoutStartSec=infinity
TimeoutStopSec=25
