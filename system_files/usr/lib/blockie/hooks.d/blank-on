#!/bin/sh
rc=0
if [ "$(systemctl --user show -P ActiveState blockie-game.scope)" = active ]; then
    systemctl --user kill --signal=SIGSTOP blockie-game.scope || rc=1
fi
timeout 2 wlopm --off '*' || rc=1
/usr/libexec/blockie/blockie-backlight off || rc=1
cur=
current=${BLOCKIE_RUNDIR:-/run/blockie-session}/session-current
[ ! -r "$current" ] || read -r cur _ < "$current"
if [ "$cur" = android ]; then
    timeout 1 systemctl start --no-block blockie-android-freeze@freeze.service || rc=1
fi
exit $rc
