polkit.addRule(function(action, subject) {
  if (action.id != "org.freedesktop.systemd1.manage-units" || subject.user != "blockie") {
    return;
  }
  var unit = action.lookup("unit");
  var verb = action.lookup("verb");
  if (unit == "waydroid-container.service" && (verb == "start" || verb == "stop")) {
    return polkit.Result.YES;
  }
  if (verb == "start" && (unit == "blockie-android-freeze@freeze.service" || unit == "blockie-android-freeze@thaw.service")) {
    return polkit.Result.YES;
  }
  if (verb == "start" && unit == "blockie-android-music.service") {
    return polkit.Result.YES;
  }
});
