polkit.addRule(function(action, subject) {
  if (action.id != "org.freedesktop.systemd1.manage-units" || subject.user != "blockie") {
    return;
  }
  var unit = action.lookup("unit");
  var units = /^blockie-session-(switch|appswitch|revive)@[a-z0-9][a-z0-9-]*\.service$/;
  var ready = /^blockie-session-ready@[0-9a-f]{32}\.service$/;
  if (action.lookup("verb") == "start" && unit && (units.test(unit) || ready.test(unit))) {
    return polkit.Result.YES;
  }
});
