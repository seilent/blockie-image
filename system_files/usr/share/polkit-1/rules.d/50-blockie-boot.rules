polkit.addRule(function(action, subject) {
  if (action.id != "org.freedesktop.systemd1.manage-units" || subject.user != "blockie") {
    return;
  }
  var unit = action.lookup("unit");
  var units = /^blockie-boot@(reboot|android|recovery|fastboot)\.service$/;
  if (action.lookup("verb") == "start" && unit && units.test(unit)) {
    return polkit.Result.YES;
  }
});
