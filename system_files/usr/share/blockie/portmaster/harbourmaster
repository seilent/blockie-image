#!/usr/bin/env bash
set -uo pipefail

quiet=0
nocheck=0
rest=()
for a in "$@"; do
  case $a in
    --quiet) quiet=$((quiet + 1)) ;;
    --no-check) nocheck=$((nocheck + 1)) ;;
    *) rest+=("$a") ;;
  esac
done
if [[ $# != 4 || $quiet != 1 || $nocheck != 1 || ${#rest[@]} != 2 || ${rest[0]} != runtime_check ||
  ! ${rest[1]} =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*\.squashfs$ ]]; then
  echo "harbourmaster: only --quiet --no-check runtime_check <name>.squashfs runs on Blockie" >&2
  exit 1
fi
name=${rest[1]%.squashfs}
exec /usr/libexec/blockie/ports/run-progress "$name" runtime "$name"
